---
// The lockup. Two arrangements of the same parts, because the brand board
// specifies both: `stacked` is the full sign — mark over wordmark, "ROOFING"
// flanked by rules, tagline under — and `inline` is the horizontal cut used
// in chrome, where the tagline is dropped rather than shrunk to unreadable.
// `tagline={false}` suppresses it on the stacked cut too, for the one place
// the same sentence is already carrying the headline.
import { site } from "../data/site";

interface Props {
  tone?: "forest" | "cream";
  layout?: "inline" | "stacked";
  tagline?: boolean;
  class?: string;
}

const {
  tone = "forest",
  layout = "inline",
  tagline = true,
  class: className = "",
} = Astro.props;

const mark = tone === "cream" ? "/icon-light.svg" : "/icon.svg";
// The inline cut uses the wider nav mark (firs + gable, 196.8x90). Its roof
// face is canvas-cream, so on the forest footer it falls back to the light icon.
const inlineMark = tone === "cream" ? "/icon-light.svg" : "/mark.svg";
const ink = tone === "cream" ? "text-on-forest" : "text-forest";
const sub = tone === "cream" ? "text-on-forest-mute" : "text-mute";
---

{
  layout === "stacked" ? (
    <span class={`inline-flex flex-col items-center text-center ${className}`}>
      <img src={mark} alt="" width="120" height="96" class="h-[88px] w-[110px] shrink-0" />
      <span class={`t-wordmark mt-3 text-[40px] ${ink}`}>Acosta</span>
      {/* The rules are part of the wordmark, not decoration — they set
          "ROOFING" at the same optical width as the name above it. */}
      <span class={`ruled-label mt-2 w-full max-w-[280px] ${ink}`}>
        <span class="t-spaced whitespace-nowrap">Roofing</span>
      </span>
      {tagline && <span class={`t-spaced-sm mt-3 ${sub}`}>{site.tagline}</span>}
    </span>
  ) : (
    <span class={`inline-flex items-center gap-3 ${className}`}>
      <img src={inlineMark} alt="" width="197" height="90" class="h-10 w-[88px] shrink-0" />
      <span class="leading-none">
        <span class={`t-wordmark block text-[21px] ${ink}`}>Acosta</span>
        <span class={`t-spaced-sm mt-1.5 block ${sub}`}>Roofing</span>
      </span>
    </span>
  )
}
