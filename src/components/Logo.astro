---
import { asset } from "../lib/url";
// The lockup. Two arrangements of the same parts, because the brand board
// specifies both: `stacked` is the full sign (mark over wordmark, "ROOFING"
// flanked by rules, tagline under), and `inline` is the horizontal cut used
// in chrome, where the tagline is dropped rather than shrunk to unreadable.
// `tagline={false}` suppresses it on the stacked cut too, for the one place
// the same sentence is already carrying the headline.
import Wordmark from "./Wordmark.astro";
import { site } from "../data/site";

interface Props {
  tone?: "forest" | "cream";
  layout?: "inline" | "stacked";
  tagline?: boolean;
  class?: string;
}

const {
  tone = "forest",
  layout = "inline",
  tagline = true,
  class: className = "",
} = Astro.props;

// Both cuts use the real mark (firs + gable, 196.8x90). Its roof face is
// canvas-cream, so on a forest band it swaps to the inverted cream cut.
const mark = asset(tone === "cream" ? "/mark-light.svg" : "/mark.svg");
const ink = tone === "cream" ? "text-on-forest" : "text-forest";
const sub = tone === "cream" ? "text-on-forest-mute" : "text-mute";
---

{
  layout === "stacked" ? (
    <span class={`inline-flex flex-col items-center text-center ${className}`}>
      <img src={mark} alt="" width="197" height="90" class="h-auto w-[210px] shrink-0" />
      {/* The rules under the name are part of the supplied wordmark art, not
          decoration; they set "ROOFING" at the name's optical width. */}
      <Wordmark class={`mt-4 h-auto w-full max-w-[200px] ${ink}`} />
      {tagline && <span class={`t-spaced-sm mt-3 ${sub}`}>{site.tagline}</span>}
    </span>
  ) : (
    <span class={`inline-flex items-center gap-3 ${className}`}>
      <img src={mark} alt="" width="197" height="90" class="h-10 w-auto shrink-0 max-[340px]:h-8" />
      <Wordmark class={`h-9 w-auto max-[340px]:h-7 ${ink}`} />
    </span>
  )
}
