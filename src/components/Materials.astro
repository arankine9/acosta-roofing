---
import Treeline from "./Treeline.astro";
import { asset } from "../lib/url";

// Forest band between Services and the leak call-out: the three roofing systems
// Acosta installs, each with a picture of the material. Headline and lead
// share a row on desktop; the materials run three-up between hairline rules
// from 768px and stack below that.
//
// The pictures are plain files in public/images/materials/. To swap one,
// replace the file under the same name; nothing here needs to change. Any
// square-ish image works (it is fitted inside a 160px box, not cropped),
// ideally a PNG or SVG with a transparent background so it sits on the band.
//
// TODO: the current three are Roofscapes NW's icons, dropped in to judge the
// direction. They are another company's artwork; replace all three before
// this section is committed or deployed.
//
// `life` is the typical service life for each material with proper
// installation and upkeep, as published across manufacturer and industry
// guides: architectural 25-30 years, designer 30 and up, TPO/PVC 20-30. They
// are industry ranges, not a warranty or a promise about any one roof.
//
// No 3-tab: it's rarely installed in Oregon now, and Acosta only puts on
// architectural and designer shingle.
const materials = [
  {
    image: "/images/materials/architectural-shingle.png",
    fit: "Steep slope",
    title: "Architectural shingle",
    life: "25–30",
    body: "Thicker, laminated shingle with a dimensional profile that reads like shake. Heavy and wind-rated, in a wide range of colors. The standard choice on most house re-roofs.",
  },
  {
    image: "/images/materials/asphalt-shingle.png",
    fit: "Steep slope",
    title: "Designer shingle",
    life: "30+",
    body: "Premium, extra-thick shingle cut to look like slate or hand-split shake. Deeper shadow lines and the heaviest weight of any asphalt shingle, for a roof that shows from the street.",
  },
  {
    image: "/images/materials/single-ply-membrane.png",
    fit: "Flat & low slope",
    title: "Single-ply membrane (TPO / PVC)",
    life: "20–30",
    body: "Heat-welded membrane for flat and low-slope roofs, residential or commercial. Seams are fused into one continuous, watertight sheet.",
  },
];

// Manufacturer logos, recoloured to the band's cream, in public/images/brands/.
// Sources: GAF from Wikimedia Commons (File:GAF_logo.svg); CertainTeed,
// Malarkey and Duro-Last from each manufacturer's own website. `height` is
// the rendered height in px; `width` keeps the aspect ratio for layout.
const brands = [
  { name: "GAF", logo: "/images/brands/gaf.svg", height: 56, width: 56 },
  { name: "CertainTeed", logo: "/images/brands/certainteed.svg", height: 36, width: 156 },
  { name: "Malarkey Roofing Products", logo: "/images/brands/malarkey.svg", height: 40, width: 190 },
  { name: "Duro-Last", logo: "/images/brands/duro-last.svg", height: 30, width: 210 },
];
---

<section id="materials" class="on-forest relative bg-forest text-on-forest">
  <Treeline tone="forest" height={64} offset={-470} class="absolute inset-x-0 bottom-full" />

  <div class="container-page pt-24 pb-20 md:pt-28 md:pb-24">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
      <h2 class="t-display-lg max-w-xl">Roofing materials for every roof and budget</h2>
      <p class="t-lead max-w-xl text-on-forest-mute">
        Architectural and designer shingle for steep roofs, membrane for flat ones.
        We'll recommend the one that suits the pitch, the budget and an Oregon
        winter, and tell you why.
      </p>
    </div>

    <ul class="mt-12 grid md:grid-cols-3">
      {
        materials.map((material, index) => (
          <li
            class:list={[
              // Two rules in all, between the three materials and nowhere else:
              // under the first two when stacked, beside them three-up.
              "flex flex-col border-hairline-dark py-10 first:pt-0 last:pb-0 md:py-0",
              index < materials.length - 1 && "border-b md:border-b-0 md:border-r md:pr-8",
              index > 0 && "md:pl-8",
            ]}
          >
            <img
              src={asset(material.image)}
              alt=""
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
              class="size-40 object-contain object-left"
            />
            <p class="t-spaced-sm mt-7 text-on-forest-mute">{material.fit}</p>
            <h3 class="t-heading-md mt-3">{material.title}</h3>
            <p class="t-body-sm mt-3 grow text-on-forest-mute">{material.body}</p>

            {/* Pinned to the foot of the column so the three figures share a line. */}
            <dl class="mt-8 flex flex-col-reverse">
              <dt class="t-spaced-sm mt-3 text-on-forest-mute">Years expected life</dt>
              <dd class="t-display-lg leading-none">{material.life}</dd>
            </dl>
          </li>
        ))
      }
    </ul>

    {/* The manufacturers whose products these three systems come from. One
        ink, like everything else on the band: full-colour marks in four
        brand palettes would read as a sponsor wall. Each file is the
        manufacturer's own logo recoloured cream (GAF's letters are cut
        through its tile), and the heights are set by eye so the four sit at
        the same optical weight. Worded as brands we install, not as
        certifications: the site claims none. */}
    <div class="mt-16 flex flex-col gap-8 border-t border-hairline-dark pt-10 lg:flex-row lg:items-center lg:gap-16">
      <p class="t-spaced-sm shrink-0 text-on-forest-mute lg:max-w-[11rem]">Brands we install</p>
      <ul class="grid grow grid-cols-2 items-center gap-x-8 gap-y-10 lg:flex lg:justify-between lg:gap-10">
        {
          brands.map((brand) => (
            <li class="flex items-center justify-center">
              <img
                src={asset(brand.logo)}
                alt={brand.name}
                width={brand.width}
                height={brand.height}
                loading="lazy"
                decoding="async"
                style={`height:${brand.height}px`}
                class="w-auto max-w-full opacity-90"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
