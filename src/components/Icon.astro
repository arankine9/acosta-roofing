---
// Pictograms on a 24-unit grid, single weight, no fills.
//
// The six service icons come from Phosphor Icons (MIT) via @iconify-json/ph,
// rendered through astro-icon. Phosphor's Light weight sits closest to the
// hairline rules the icons are set between, and it is the only set surveyed
// with an honest pipe glyph; gutters read as drainage rather than weather.
// Phosphor draws filled outlines rather than strokes, so `icon-glyph` in
// global.css fills them instead of stroking.
import { Icon as LibIcon } from "astro-icon/components";

const library: Record<string, string> = {
  "roof-install": "ph:house-line-light",
  "roof-repair": "ph:hammer-light",
  "roof-maintain": "ph:broom-light",
  gutters: "ph:pipe-light",
  commercial: "ph:warehouse-light",
  metal: "ph:angle-light",
};

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className = "" } = Astro.props;

const paths: Record<string, string> = {
  // Remaining inline marks
  waterproof: "M2 9.5 12 2l10 7.5M5 12v9h14v-9M12 12.5c-1.8 2.2-2.8 3.7-2.8 5a2.8 2.8 0 0 0 5.6 0c0-1.3-1-2.8-2.8-5Z",
  solar: "M2 11 12 3.5 22 11M4.5 13.5h15v7h-15ZM4.5 17h15M9.5 13.5v7M14.5 13.5v7",
  // Trust bar + contact
  quality: "M12 2.5 4 5.5v6.2c0 4.6 3.2 8.2 8 9.8 4.8-1.6 8-5.2 8-9.8V5.5ZM8.5 11.8l2.5 2.6 4.5-4.6",
  honest: "M12 1.5 15.5 8h-2.2l3.2 6h-2.6l3.6 7H14v2.5h-4V21H6.5L10.1 14H7.5L10.7 8H8.5Z",
  built: "M2 12 12 3l10 9M5.5 8.9V21h13V8.9M9 21v-6h6v6",
  oregon: "M1.5 19 8 8l4.5 7 2.5-3.5L22.5 19ZM8 8l2.2 3.8M15 11.5 12.8 15",
  phone: "M4.5 3.5h4l1.8 4.4-2.3 1.6a12 12 0 0 0 6.5 6.5l1.6-2.3 4.4 1.8v4c0 .8-.7 1.5-1.5 1.5A17 17 0 0 1 3 5c0-.8.7-1.5 1.5-1.5Z",
  mail: "M2.5 5.5h19v13h-19ZM2.5 6l9.5 7 9.5-7",
  pin: "M12 21.5s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11ZM12 13a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
  clock: "M12 21.5a9.5 9.5 0 1 0 0-19 9.5 9.5 0 0 0 0 19ZM12 6.5V12l3.8 2.5",
  globe: "M12 21.5a9.5 9.5 0 1 0 0-19 9.5 9.5 0 0 0 0 19ZM2.5 12h19M12 2.5c2.4 2.6 3.6 5.7 3.6 9.5S14.4 18.9 12 21.5c-2.4-2.6-3.6-5.7-3.6-9.5S9.6 5.1 12 2.5Z",
  check: "M4 12.5 9.5 18 20 6.5",
  arrow: "M3 12h17M14 6l6 6-6 6",
};

const d = paths[name] ?? paths.check;
const libName = library[name];
---

{
  libName ? (
    <LibIcon
      name={libName}
      width={size}
      height={size}
      class:list={["icon-glyph", className]}
      aria-hidden="true"
    />
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="square"
      stroke-linejoin="miter"
      aria-hidden="true"
      class={className}
    >
      <path d={d} />
    </svg>
  )
}
