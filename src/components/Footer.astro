---
import Logo from "./Logo.astro";
import Treeline from "./Treeline.astro";
import Text from "./Text.astro";
import { site, cityLine } from "../data/site";
import { pages, estimateHref } from "../data/nav";
import { serviceHref, servicesByGroup } from "../data/services";

const year = new Date().getFullYear();

// The footer's words are in src/content/shared.json under `footer`.
const k = "shared:footer";

// Three link columns, not six. A four-person roofing company does not have six
// columns of real pages, and inventing them to satisfy a grid would be worse
// than the grid. The county list lives on the service-area page, not here.
//
// A link with `k` takes its label from content; the residential column lists
// the services by their registry titles.
type FooterLink = { href: string } & ({ k: string } | { label: string });
const columns: { k: string; links: FooterLink[] }[] = [
  {
    k: `${k}.columns.residential`,
    links: servicesByGroup("residential").map((service) => ({
      label: service.title,
      href: serviceHref(service.slug),
    })),
  },
  {
    k: `${k}.columns.commercial`,
    links: [
      { k: `${k}.columns.commercial.links.singlePly`, href: `${serviceHref("commercial")}#single-ply` },
      { k: `${k}.columns.commercial.links.lowSlope`, href: `${serviceHref("commercial")}#low-slope` },
      { k: `${k}.columns.commercial.links.multiUnit`, href: serviceHref("multi-unit") },
      { k: `${k}.columns.commercial.links.materials`, href: pages.materials },
    ],
  },
  {
    k: `${k}.columns.company`,
    links: [
      { k: `${k}.columns.company.links.about`, href: pages.about },
      { k: `${k}.columns.company.links.serviceArea`, href: pages.serviceArea },
      { k: `${k}.columns.company.links.faq`, href: pages.faq },
      { k: `${k}.columns.company.links.contact`, href: pages.contact },
    ],
  },
];
---

<footer class="on-forest relative bg-forest text-on-forest">
  <Treeline tone="forest" height={64} offset={-395} class="absolute inset-x-0 bottom-full" />

  <div class="container-page relative pt-24 pb-14">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,1fr))]">
      <div class="max-w-xs">
        <Logo tone="cream" />
        {/* The tagline is the business's own (site.json), followed by this
            footer's line about it. */}
        <p class="t-body-sm mt-6 text-on-forest-mute">
          <Text k="site:tagline" bare /> <Text k={`${k}.blurb`} bare />
        </p>
        <a href={estimateHref} class="btn btn-cream mt-6"><Text k={`${k}.button`} bare /></a>
      </div>

      {
        columns.map((column) => (
          <div>
            <Text k={`${column.k}.heading`} as="h2" class="t-spaced-sm text-on-forest" />
            <ul class="mt-5 space-y-1 border-t border-hairline-dark pt-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="t-body-sm flex min-h-11 items-center text-on-forest-mute hover:text-on-forest"
                  >
                    {"k" in link ? <Text k={link.k} bare /> : link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 flex flex-col gap-5 border-t border-hairline-dark pt-7 md:flex-row md:items-center md:justify-between"
    >
      <Text k={`${k}.coverage`} class="t-spaced text-on-forest" />
      <address class="t-body-sm not-italic text-on-forest-mute">
        {site.address.street && <>{site.address.street} &middot; </>}{cityLine}
        &middot; <a href={`mailto:${site.email}`} class="hover:text-on-forest">{site.email}</a>
      </address>
      <a href={site.phoneHref} class="t-heading-sm inline-flex min-h-11 items-center text-on-forest">
        {site.phone}
      </a>
    </div>
  </div>

  <!-- Legal fine-print band. DESIGN.md calls for `mute` here, but #6b6a63 on
       #1b3d2e lands at 2.6:1; on-forest-mute keeps the same read and clears AA. -->
  <div class="bg-forest-deep">
    <div
      class="container-page flex flex-col gap-2 py-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="t-spaced-sm text-on-forest-mute">
        &copy; {year} <Text k={`${k}.rights`} bare />
        <a href={pages.privacy} class="ml-3 underline underline-offset-4 hover:text-on-forest"><Text k={`${k}.privacy`} bare /></a>
        <a href={pages.photoCredits} class="ml-3 underline underline-offset-4 hover:text-on-forest"><Text k={`${k}.photoCredits`} bare /></a>
      </p>
      <p class="t-spaced-sm text-on-forest-mute">
        <Text k={`${k}.statement`} bare />{site.ccb && <> &middot; <Text k={`${k}.ccb`} bare /></>}
      </p>
    </div>
  </div>
</footer>
