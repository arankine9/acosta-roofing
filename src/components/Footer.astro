---
import Logo from "./Logo.astro";
import Treeline from "./Treeline.astro";
import { site, cityLine } from "../data/site";

const year = new Date().getFullYear();

// Four link columns, not six. A four-person roofing company does not have six
// columns of real pages, and inventing them to satisfy a grid would be worse
// than the grid.
const columns = [
  {
    heading: "Residential",
    links: [
      { label: "Roof installation", href: "#services" },
      { label: "Roof repairs", href: "#services" },
      { label: "Roof maintenance", href: "#services" },
      { label: "Gutter systems", href: "#services" },
    ],
  },
  {
    heading: "Commercial",
    links: [
      { label: "Flat & single-ply", href: "#services" },
      { label: "Low-slope systems", href: "#services" },
      { label: "Light-industrial roofs", href: "#services" },
      { label: "Maintenance calls", href: "#contact" },
    ],
  },
  {
    heading: "Service area",
    links: [
      { label: "Washington County", href: "#service-area" },
      { label: "Multnomah County", href: "#service-area" },
      { label: "Clackamas County", href: "#service-area" },
      { label: "Marion County", href: "#service-area" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "How we work", href: "#process" },
      { label: "Service area", href: "#service-area" },
      { label: site.email, href: `mailto:${site.email}` },
      { label: site.phone, href: site.phoneHref },
    ],
  },
];
---

<footer class="on-forest relative bg-forest text-on-forest">
  <Treeline tone="forest" height={64} class="absolute inset-x-0 bottom-full" />

  <div class="container-page relative pt-24 pb-14">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[minmax(0,1.3fr)_repeat(4,minmax(0,1fr))]">
      <div class="max-w-xs">
        <Logo tone="cream" />
        <p class="t-body-sm mt-6 text-on-forest-mute">
          {site.tagline} Residential and commercial roofing across
          {" "}{site.serviceArea}, from Beaverton.
        </p>
        <a href="#contact" class="btn btn-cream mt-6">Free Estimate</a>
      </div>

      {
        columns.map((column) => (
          <div>
            <h2 class="t-spaced-sm text-on-forest">{column.heading}</h2>
            <ul class="mt-5 space-y-3 border-t border-hairline-dark pt-4">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    target={link.external ? "_blank" : undefined}
                    class="t-body-sm text-on-forest-mute hover:text-on-forest"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 flex flex-col gap-5 border-t border-hairline-dark pt-7 md:flex-row md:items-center md:justify-between"
    >
      <p class="t-spaced text-on-forest">Licensed &middot; Bonded &middot; Insured</p>
