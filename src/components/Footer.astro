---
import Logo from "./Logo.astro";
import Treeline from "./Treeline.astro";
import { site, counties, cityLine } from "../data/site";

const year = new Date().getFullYear();

// Four link columns, not six. A four-person roofing company does not have six
// columns of real pages, and inventing them to satisfy a grid would be worse
// than the grid.
const columns = [
  {
    heading: "Residential",
    links: [
      { label: "Roof installation", href: "#services" },
      { label: "Roof repairs", href: "#services" },
      { label: "Roof maintenance", href: "#services" },
      { label: "Gutter systems", href: "#services" },
    ],
  },
  {
    heading: "Commercial",
    links: [
      { label: "Flat & single-ply", href: "#services" },
      { label: "Low-slope systems", href: "#services" },
      { label: "Light-industrial roofs", href: "#services" },
      { label: "Maintenance calls", href: "#contact" },
    ],
  },
  {
    heading: "Service area",
    links: counties.map((county) => ({
      label: `${county.name} County`,
      href: "#service-area",
    })),
  },
  {
    heading: "Company",
    links: [
      { label: "Emergency repair", href: "#emergency" },
      { label: "Service area", href: "#service-area" },
      { label: site.email, href: `mailto:${site.email}` },
      { label: site.phone, href: site.phoneHref },
    ],
  },
];
---

<footer class="on-forest relative bg-forest text-on-forest">
  <Treeline tone="forest" height={64} offset={-395} class="absolute inset-x-0 bottom-full" />

  <div class="container-page relative pt-24 pb-14">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[minmax(0,1.3fr)_repeat(4,minmax(0,1fr))]">
      <div class="max-w-xs">
        <Logo tone="cream" />
        <p class="t-body-sm mt-6 text-on-forest-mute">
          {site.tagline} Residential and commercial roofing across
          {" "}{site.serviceArea}, from Beaverton.
        </p>
        <a href="#contact" class="btn btn-cream mt-6">Free Estimate</a>
      </div>

      {
        columns.map((column) => (
          <div>
            <h2 class="t-spaced-sm text-on-forest">{column.heading}</h2>
            <ul class="mt-5 space-y-1 border-t border-hairline-dark pt-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    target={link.external ? "_blank" : undefined}
                    class="t-body-sm flex min-h-11 items-center text-on-forest-mute hover:text-on-forest"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 flex flex-col gap-5 border-t border-hairline-dark pt-7 md:flex-row md:items-center md:justify-between"
    >
      <p class="t-spaced text-on-forest">Licensed &middot; Bonded &middot; Insured</p>
      <address class="t-body-sm not-italic text-on-forest-mute">
        {site.address.street && <>{site.address.street} &middot; </>}{cityLine}
        &middot; {site.email}
      </address>
      <a href={site.phoneHref} class="t-heading-sm inline-flex min-h-11 items-center text-on-forest">
        {site.phone}
      </a>
    </div>
  </div>

  <!-- Legal fine-print band. DESIGN.md calls for `mute` here, but #6b6a63 on
       #14301f lands at 2.6:1; on-forest-mute keeps the same read and clears AA. -->
  <div class="bg-forest-deep">
    <div
      class="container-page flex flex-col gap-2 py-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="t-spaced-sm text-on-forest-mute">
        &copy; {year} {site.legalName} All rights reserved.
      </p>
      <p class="t-spaced-sm text-on-forest-mute">
        Bonded and insured in the State of Oregon.{site.ccb && <> &middot; CCB #{site.ccb}</>}
      </p>
    </div>
  </div>
</footer>
