---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import Text from "./Text.astro";
import Img from "./Img.astro";
import { residentialHref, serviceHref } from "../data/services";
import { pages } from "../data/nav";
import { file } from "../lib/cms";

// Three full-photo service tiles. At rest each shows its photo and title;
// on hover (or keyboard focus) the photo settles under a forest shade, the
// title's plus turns into an arrow, a rule draws in beneath it and the
// description opens up from below. The whole tile is the link. The motion
// lives in global.css under `.service-tile`.
//
// The tiles' words and photos are in src/content/pages/home.json under
// `services.tiles`, in this order; `hrefs` is where each one goes: the
// residential hub, and the commercial and multi-unit pages. Three tiles
// always, so the row is not a list the owner can add to.
//
// multi-unit.jpg is Eric Dahm's "Aerial view of new townhouses with gray
// roofs" from Unsplash (Unsplash License: free for commercial use, no
// attribution required).
const k = "pages/home:services";
const tiles = file("pages/home").services.tiles as unknown[];
const hrefs = [residentialHref, serviceHref("commercial"), serviceHref("multi-unit")];
---

{/* Extra bottom padding: the Materials band's treeline stands 64px into
    this section. */}
<section id="services" class="section bg-canvas pb-28 lg:pb-36">
  <div class="container-page">
    <SectionHeading k={k} align="center" class="mb-12" />
  </div>

  {/* The photos are landscape, so from 1024px the row runs wider than the
      page container (up to 1720px) and the tiles get shorter as the screen
      widens. Below that they stack, held to a comfortable width. */}
  <div class="mx-auto max-w-[1720px] px-6 min-[1440px]:px-12">
    <div class="mx-auto grid max-w-2xl grid-cols-1 gap-2 lg:max-w-none lg:grid-cols-3">
      {
        tiles.map((_, i) => (
          <a href={hrefs[i]} class="service-tile">
            <Img k={`${k}.tiles.${i}.image`} loading="lazy" decoding="async" class="service-tile__photo" />
            <span class="service-tile__scrim" aria-hidden="true" />
            <span class="service-tile__shade" aria-hidden="true" />

            <div class="service-tile__body">
              <h3 class="service-tile__title t-display-lg">
                <Text k={`${k}.tiles.${i}.title`} as="span" />
                <span class="service-tile__icon" aria-hidden="true">
                  <svg class="service-tile__plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
                    <path d="M12 4v16M4 12h16" />
                  </svg>
                  <Icon name="arrow" size={24} class="service-tile__arrow" />
                </span>
              </h3>
              <span class="service-tile__rule" aria-hidden="true" />
              <div class="service-tile__reveal">
                <div class="service-tile__clip">
                  <Text k={`${k}.tiles.${i}.body`} class="service-tile__text t-body-md" />
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={pages.services} class="btn btn-outline"><Text k={`${k}.allServices`} bare /></a>
      <a href="#contact" class="btn btn-primary"><Text k={`${k}.appointment`} bare /></a>
    </div>
  </div>
</section>
