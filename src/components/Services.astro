---
import { asset } from "../lib/url";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

// Three full-photo service tiles. At rest each shows its photo and title;
// on hover (or keyboard focus) the photo settles under a forest shade, the
// title's plus turns into an arrow, a rule draws in beneath it and the
// description opens up from below. The whole tile is the link. The motion
// lives in global.css under `.service-tile`.
//
// `href` is where a tile goes. There are no service pages yet, so all three
// open the estimate form; point them at their pages when those exist.
//
// Photos live in public/images/ under the filenames below; swap a photo by
// replacing the file. multi-unit.jpg is Eric Dahm's "Aerial view of new
// townhouses with gray roofs" from Unsplash (Unsplash License: free for
// commercial use, no attribution required).
const services = [
  {
    title: "Residential",
    body: "Roof replacement, leak repairs and seasonal maintenance for homes across the Portland metro, plus the gutters and custom flashing that keep water moving off the roof and away from the house.",
    image: "/images/roof-maintenance.jpg",
    alt: "Aerial view of a brick house with a new architectural shingle roof",
    href: "#contact",
  },
  {
    title: "Commercial",
    body: "Single-ply and low-slope systems for shops, warehouses and light-industrial buildings, installed to spec and detailed properly at every curb, drain and penetration.",
    image: "/images/commercial-roofing.jpg",
    alt: "Crew rolling out and detailing white membrane on a low-slope commercial roof",
    href: "#contact",
  },
  {
    title: "Multi-unit",
    body: "Apartments, condos and townhome rows: replacement, repair and scheduled maintenance, planned building by building around the people living underneath.",
    image: "/images/multi-unit.jpg",
    alt: "Aerial view of rows of townhomes with gray shingle roofs",
    href: "#contact",
  },
];
---

{/* Extra bottom padding: the Materials band's treeline stands 64px into
    this section. */}
<section id="services" class="section bg-canvas pb-28 lg:pb-36">
  <div class="container-page">
    <SectionHeading title="Our services" align="center" class="mb-12" />
  </div>

  {/* The photos are landscape, so from 1024px the row runs wider than the
      page container (up to 1720px) and the tiles get shorter as the screen
      widens. Below that they stack, held to a comfortable width. */}
  <div class="mx-auto max-w-[1720px] px-6 min-[1440px]:px-12">
    <div class="mx-auto grid max-w-2xl grid-cols-1 gap-2 lg:max-w-none lg:grid-cols-3">
      {
        services.map((service) => (
          <a href={service.href} class="service-tile">
            <img
              src={asset(service.image)}
              alt={service.alt}
              loading="lazy"
              decoding="async"
              class="service-tile__photo"
            />
            <span class="service-tile__scrim" aria-hidden="true" />
            <span class="service-tile__shade" aria-hidden="true" />

            <div class="service-tile__body">
              <h3 class="service-tile__title t-display-lg">
                <span>{service.title}</span>
                <span class="service-tile__icon" aria-hidden="true">
                  <svg class="service-tile__plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
                    <path d="M12 4v16M4 12h16" />
                  </svg>
                  <Icon name="arrow" size={24} class="service-tile__arrow" />
                </span>
              </h3>
              <span class="service-tile__rule" aria-hidden="true" />
              <div class="service-tile__reveal">
                <div class="service-tile__clip">
                  <p class="service-tile__text t-body-md">{service.body}</p>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a href="#contact" class="btn btn-primary">Request an Appointment</a>
    </div>
  </div>
</section>
