---
import SectionHeading from "./SectionHeading.astro";
import { counties } from "../data/site";
import { field, get, text } from "../lib/cms";
import { serviceMap } from "../data/service-map";

/*
  Where we work, as a map rather than a table.

  The service area is a drive time: everywhere in Oregon within
  `drive.minutes` of the Beaverton shop. It is traced through drive times
  sampled off OpenStreetMap roads and cut to the state line, because the
  business is licensed in Oregon only (scripts/sample-drive-times.mjs, then
  scripts/build-service-map.mjs). Everything is baked to SVG paths at
  authoring time -- no tile server, no map library, no API key, and no third
  party watching who reads this page.

  It is drawn as a plat sheet, not as a slippy map, because that is what the
  rest of the system is: three inks, hairline rules, square corners. County
  lines stay on as faint context, a handful of towns inside the area are
  marked so the shape can be read, and the cartographic furniture -- neat
  line, north arrow, scale bar, locator inset, legend -- is the same a
  printed map has.

  The map is still an illustration, not the record. The county list beside
  it is the record, and it stays real text: it is what a screen reader gets,
  what search indexes, and what somebody scanning for their own town reads.

  The words around it are content (`k`, shared.json's `serviceArea` unless a
  page passes its own). The description states the drive time in words;
  if the map is regenerated for a different `drive.minutes`, change it there
  too. The county names, notes and towns are data, from src/data/site.ts.
*/
interface Props {
  k?: string;
}

const { k = "shared:serviceArea" } = Astro.props;
// The labels below are written as their own elements with field() and
// set:html rather than <Text>: this component's scoped <style> gives every
// element it writes a data-astro-cid attribute, which <Text> could only pass
// on as ="true".
const words = (key: string) => text(get(`${k}.${key}`));
const { base, detail, inset, furniture, drive } = serviceMap;
// Where the north arrow, scale bar, locator inset and the town names sit is
// decided by the generator, not here: the names are placed to route around
// the furniture, and that placement needs the real numbers.
const { north, scale, locator } = furniture;

const names = counties.map((county) => county.name);
const spoken = `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
const townNames = detail.towns.map((town) => town.name);
---

<section id="service-area" class="section bg-canvas">
  <div class="container-page">
    <SectionHeading k={k} class="mb-14" />

    {/* Two plates side by side from 1280px, the same height: the map sets it,
        and the county plate stretches to match, sharing any spare height
        evenly between its rows (below). Under 1280px the map column would be
        too narrow to read, so the plates stack instead, map first. */}
    <div class="grid gap-8 xl:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] xl:items-stretch">
      {/* Capped at the map's own 760-unit width when the layout is one
          column, so the drawing never renders above 1:1 and the lettering
          never outgrows its place. */}
      <figure class="panel m-0 mx-auto flex w-full max-w-[820px] flex-col overflow-hidden xl:max-w-none">
        <figcaption class="plate-label flex-wrap justify-between gap-y-1 border-b border-hairline">
          <span class="t-spaced-sm" {...field(`${k}.map.label`)} set:html={words("map.label")} />
          <span class="t-spaced-sm text-on-forest-mute" {...field(`${k}.map.region`)} set:html={words("map.region")} />
        </figcaption>

        <div class="map-frame">
          {/*
            The map's name and description live in hidden prose below rather
            than in SVG <title>/<desc>, because a <title> child of <svg> is
            also what the browser draws as a native hover tooltip -- and this
            one covers the whole sheet, so pointing anywhere on the map popped
            an OS tooltip over it. `aria-labelledby`/`aria-describedby` reach
            the paragraphs by id and give assistive tech the same two strings
            with nothing to hover.
          */}
          <svg
            class="map"
            viewBox={`0 0 ${detail.width} ${detail.height}`}
            role="img"
            aria-labelledby="service-map-title"
            aria-describedby="service-map-desc"
          >
            {/* Ground, in two tones only: water is the mid paper, land is the
                lightest. Washington is filled the same as Oregon on purpose
                -- land is land -- so the Columbia and the coast both read as
                water rather than the state line reading as a shoreline. What
                separates the two states is the boundary drawn over it below,
                and the locator inset saying which one this is. */}
            <rect width={detail.width} height={detail.height} fill="var(--color-cream-deep)"></rect>
            <path d={detail.neighbours} fill="var(--color-board)"></path>
            <path d={detail.state} fill="var(--color-board)"></path>

            {/* Coastline and the far bank of the Columbia. */}
            <path
              d={detail.neighbours}
              fill="none"
              stroke="var(--color-hairline)"
              stroke-width="1"></path>

            {/* The drive-time area: a light forest wash under the county
                lines, so the counties it takes in stay legible through it. */}
            <path d={detail.area} fill="var(--color-forest)" fill-opacity="0.2"></path>

            {/* Counties, as faint context everywhere on the sheet. */}
            <g fill="none" stroke="var(--color-hairline)" stroke-width="0.9" stroke-linejoin="round">
              {detail.counties.map((d) => <path d={d} />)}
            </g>

            {/* Oregon's own edge. */}
            <path
              d={detail.state}
              fill="none"
              stroke="var(--color-forest)"
              stroke-width="1.6"
              stroke-opacity="0.5"></path>

            {/* The drive-time line itself, the strongest line on the sheet. */}
            <path
              d={detail.area}
              fill="none"
              stroke="var(--color-forest)"
              stroke-width="1.8"
              stroke-linejoin="round"></path>

            {/* Reference towns inside the area, each placed clear of the
                others and of the furniture by the generator. */}
            {
              detail.towns.map((town) => (
                <g>
                  <circle cx={town.dot[0]} cy={town.dot[1]} r="3" fill="var(--color-forest)" />
                  <text class="map-town" x={town.label.x} y={town.label.y} text-anchor={town.label.anchor}>
                    {town.name}
                  </text>
                </g>
              ))
            }

            {/* The shop: a surveyor's crosshair, the one point on the sheet. */}
            <g>
              <g stroke="var(--color-forest)" stroke-width="1.6">
                <line x1={base.xy[0] - 14} y1={base.xy[1]} x2={base.xy[0] - 7} y2={base.xy[1]}></line>
                <line x1={base.xy[0] + 7} y1={base.xy[1]} x2={base.xy[0] + 14} y2={base.xy[1]}></line>
                <line x1={base.xy[0]} y1={base.xy[1] - 14} x2={base.xy[0]} y2={base.xy[1] - 7}></line>
                <line x1={base.xy[0]} y1={base.xy[1] + 7} x2={base.xy[0]} y2={base.xy[1] + 14}></line>
              </g>
              <circle cx={base.xy[0]} cy={base.xy[1]} r="4.5" fill="var(--color-forest)"></circle>
              <text
                class="map-base"
                x={base.xy[0]}
                y={base.xy[1] + furniture.baseLabelDy}
                text-anchor="middle"
              >
                {base.name}
              </text>
            </g>

            {/* North arrow. */}
            <g transform={`translate(${north.x} ${north.y})`}>
              <path d="M0 -17L6 6L0 1L-6 6Z" fill="var(--color-forest)"></path>
              <text class="map-furniture" x="0" y="25" text-anchor="middle">N</text>
            </g>

            {/* Scale bar, checkered in 10-mile steps off the projection's own
                measured scale rather than a guess. */}
            <g transform={`translate(${scale.x} ${scale.y})`}>
              <rect
                x="0"
                y="0"
                width={scale.step}
                height="6"
                fill="var(--color-forest)"
                stroke="var(--color-forest)"
                stroke-width="1"></rect>
              <rect
                x={scale.step}
                y="0"
                width={scale.step}
                height="6"
                fill="none"
                stroke="var(--color-forest)"
                stroke-width="1"></rect>
              <text class="map-furniture" x="0" y="-7" text-anchor="middle">0</text>
              <text class="map-furniture" x={scale.step * 2} y="-7" text-anchor="middle">
                {scale.stepMiles * 2} MI
              </text>
            </g>

            {/* Locator inset: which corner of Oregon all of this is. */}
            <g transform={`translate(${locator.x} ${locator.y})`}>
              {/* Same two tones as the map it locates: water behind, land in
                  front. Inverting them here would make the inset read as a
                  different kind of drawing. */}
              <rect
                width={inset.width}
                height={inset.height}
                fill="var(--color-cream-deep)"
                stroke="var(--color-hairline-strong)"
                stroke-width="1"></rect>
              <path
                d={inset.state}
                fill="var(--color-board)"
                stroke="var(--color-forest)"
                stroke-width="1"
                stroke-opacity="0.55"></path>
              <path d={inset.area} fill="var(--color-forest)" fill-opacity="0.9"></path>
              <path d={inset.frame} fill="none" stroke="var(--color-forest)" stroke-width="1.2"
              ></path>
              <text
                class="map-furniture"
                x={inset.width / 2}
                y={inset.height - 7}
                text-anchor="middle">Oregon</text
              >
            </g>

            {/* Neat line: the map's own border, inside the plate's. */}
            <rect
              x="0.75"
              y="0.75"
              width={detail.width - 1.5}
              height={detail.height - 1.5}
              fill="none"
              stroke="var(--color-hairline-strong)"
              stroke-width="1.5"></rect>
          </svg>

          <p id="service-map-title" class="sr-only">
            Map of the area within {drive.minutes} minutes' drive of our {base.name} shop
          </p>
          <p id="service-map-desc" class="sr-only">
            {`A map of northwest Oregon with the area within ${drive.minutes} minutes' drive of the shop in ${base.name} shaded, stopping at the Columbia River and the Washington state line. It reaches parts of ${spoken} counties; ${townNames.join(", ")} are marked inside it. The county list beside the map gives the same information as text.`}
          </p>
        </div>

        <ul class="flex flex-wrap gap-x-8 gap-y-3 border-t border-hairline px-5 py-4">
          <li class="flex items-center gap-2.5">
            <span class="key-swatch key-area" aria-hidden="true"></span>
            <span class="t-caption text-body" {...field(`${k}.map.legendArea`)} set:html={words("map.legendArea")} />
          </li>
          <li class="flex items-center gap-2.5">
            <span class="key-swatch key-base" aria-hidden="true"></span>
            <span class="t-caption text-body" {...field(`${k}.map.legendShop`)} set:html={words("map.legendShop")} />
          </li>
        </ul>
      </figure>

      {/* The record. Same counties, as text, at every screen size, as a
          plate to match the map's. Stacked, the counties run two-up. Side by
          side they run one-up, each row sized to its own text, and whatever
          height the map plate has beyond that is shared evenly between the
          rows, so the two plates always end level. The rows are kept tight
          enough that the list is never the taller of the two. */}
      <div class="panel mx-auto flex w-full max-w-[820px] flex-col overflow-hidden xl:max-w-none">
        <div class="plate-label justify-between border-b border-hairline">
          <span class="t-spaced-sm" {...field(`${k}.countiesLabel`)} set:html={words("countiesLabel")} />
          <span class="t-spaced-sm text-on-forest-mute">{counties.length}</span>
        </div>

        <ul class="county-list grid flex-1 sm:grid-cols-2 xl:flex xl:flex-col">
          {
            counties.map((county) => (
              <li class="flex flex-col justify-center px-5 py-2.5 xl:flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <h3 class="t-heading-sm text-forest">{county.name} County</h3>
                  <span class="badge-tag">{county.note}</span>
                </div>
                <p class="t-caption mt-1 text-body">{county.towns}</p>
              </li>
            ))
          }
        </ul>

      </div>
    </div>
  </div>
</section>

<style>
  /* The map sits on the mid paper tone so the plate has no white gutter
     around a sheet that is already bordered by its own neat line. */
  .map-frame {
    background-color: var(--color-cream-deep);
  }
  .map {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Map lettering is the display cut, same as every other label in the
     system. Sizes are in map units, so they scale with the viewBox rather
     than with the page -- see the breakpoints below. */
  /* No halo: outlined glyphs look like stickers laid on the map rather than
     ink printed into it. Where a name crosses a county line it is forest ink
     crossing a hairline, which is what a printed map looks like anyway. */
  .map-town,
  .map-base,
  .map-furniture {
    font-family: var(--font-display);
    text-transform: uppercase;
    fill: var(--color-forest);
  }
  /*
    These three sizes are not free. scripts/build-service-map.mjs places the
    town names using exactly these numbers -- how wide a name runs decides
    which side of its dot it fits on -- so changing one here without changing
    TYPE there re-introduces the collisions the placement pass exists to
    prevent. Change both, re-run the script. The numbers the
    last run assumed are echoed back in the generated data as
    `serviceMap.furniture.type`, so the two can be compared.
  */
  .map-town {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }
  .map-base {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }
  .map-furniture {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  /*
    The map is a drawing, so it scales as one: the type holds its size in map
    units at every width and shrinks with the sheet. That is the only option
    that keeps the placement above valid -- scaling the names up as the map
    narrows would run them into each other.

    Which leaves the narrow end, where 13 units render at about seven pixels.
    Rather than show a smear, the town names come off and the map falls back
    to what it can still say clearly at that size: the shaded area, the shop,
    and which corner of Oregon this is. The county list is immediately below
    it.
  */
  @media (max-width: 520px) {
    .map-town {
      display: none;
    }
    /* With the town names gone, the boxes reserved to keep them apart are
       not holding anything back, so the type that is left is free to grow
       to a size worth reading. */
    .map-base {
      font-size: 26px;
    }
    .map-furniture {
      font-size: 22px;
    }
  }

  /* Hairlines between counties. One-up: under every row but the last.
     Two-up: under all but the final row, and down the middle. */
  .county-list > li {
    border-bottom: 1px solid var(--color-hairline);
  }
  .county-list > li:last-child {
    border-bottom: 0;
  }
  @media (min-width: 640px) and (max-width: 1279.98px) {
    .county-list > li:nth-child(odd) {
      border-right: 1px solid var(--color-hairline);
    }
    /* The last full row, and a lone item after it, lose their rule. */
    .county-list > li:nth-last-child(-n + 2):nth-child(odd),
    .county-list > li:last-child {
      border-bottom: 0;
    }
    .county-list > li:last-child:nth-child(odd) {
      border-right: 0;
    }
  }

  /* Legend keys, drawn to match the ink they stand for. */
  .key-swatch {
    flex: none;
    width: 22px;
    height: 14px;
  }
  .key-area {
    background-color: color-mix(in srgb, var(--color-forest) 16%, var(--color-board));
    border: 1.5px solid var(--color-forest);
  }
  .key-base {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background-color: var(--color-forest);
    box-shadow:
      0 0 0 3px var(--color-board),
      0 0 0 4.5px var(--color-forest);
  }
</style>
