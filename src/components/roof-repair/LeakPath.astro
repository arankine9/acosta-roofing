---
// Why the stain is rarely under the hole: a section through a roof and
// ceiling with a split pipe boot. Water gets in at the boot (A), runs down
// the underside of the deck and along the rafter (B), and drops where it
// finds a low point, onto the insulation and ceiling (C), some distance
// down-slope of the leak (D). Letters match the legend on the roof-repair
// page. Drawn in the house inks; meant to sit on a board panel so the
// cream-deep deck reads.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  viewBox="30 -40 750 500"
  class={className}
  role="img"
  aria-labelledby="leak-path-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="leak-path-title">
    Section through a roof and ceiling. Rain gets in at a split pipe boot, runs down the underside of the roof deck along a rafter, and drips onto the ceiling several feet down-slope, where the stain appears.
  </title>
  <defs>
  <pattern id="lp-ins" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M0,12 Q3,0 6,6 T12,0" fill="none" stroke="var(--color-charcoal)" stroke-opacity="0.28" stroke-width="1"/></pattern>
  <marker id="lp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" fill="var(--color-forest)"/></marker>
  </defs>
  <polygon points="50,294.6 770,32.5 770,76.5 80,327.6 50,316.6" fill="var(--color-board)" stroke="var(--color-charcoal)" stroke-opacity="0.5" stroke-dasharray="5 4"/>
  <rect x="96" y="302.5" width="22" height="117.5" fill="var(--color-board)" stroke="var(--color-charcoal)" stroke-width="1.2"/>
  <rect x="118" y="318" width="652" height="32" fill="url(#lp-ins)"/>
  <rect x="118" y="350" width="652" height="11" fill="var(--color-cream-deep)" stroke="var(--color-charcoal)" stroke-width="1.2"/>
  <polygon points="50,276.6 770,14.5 770,32.5 50,294.6" fill="var(--color-cream-deep)" stroke="var(--color-charcoal)" stroke-width="1.2"/>
  <polygon points="44,269.7 770,5.5 770,14.5 44,278.7" fill="var(--color-charcoal)"/>
  <rect x="551" y="40" width="18" height="310" fill="var(--color-board)" stroke="var(--color-charcoal)" stroke-width="1.2"/>
  <polygon points="516,97.9 604,65.9 604,60.9 516,92.9" fill="var(--color-forest)"/>
  <polygon points="548,81.3 572,72.6 571,46.9 549,46.9" fill="var(--color-forest)"/>
  <path d="M571,50.9 l7,4 -5,4 7,5" fill="none" stroke="var(--color-cream)" stroke-width="2"/>
  <path d="M620,9.1 L580,59.6" fill="none" stroke="var(--color-forest)" stroke-width="2" marker-end="url(#lp-arrow)"/>
  <path d="M546,122.0 L318,205.0 L318,312" fill="none" stroke="var(--color-forest)" stroke-width="2.4" stroke-dasharray="8 6" marker-end="url(#lp-arrow)"/>
  <path d="M334,230 q-5,8 0,10 q5,-2 0,-10 Z" fill="var(--color-forest)"/>
  <path d="M334,258 q-5,8 0,10 q5,-2 0,-10 Z" fill="var(--color-forest)"/>
  <path d="M334,286 q-5,8 0,10 q5,-2 0,-10 Z" fill="var(--color-forest)"/>
  <ellipse cx="318" cy="366" rx="46" ry="6" fill="var(--color-charcoal)" fill-opacity="0.35"/>
  <ellipse cx="318" cy="366" rx="24" ry="3.5" fill="var(--color-charcoal)" fill-opacity="0.45"/>
  <line x1="560" y1="362" x2="560" y2="392" stroke="var(--color-charcoal)" stroke-opacity="0.5" stroke-dasharray="3 4"/>
  <line x1="318" y1="400" x2="560" y2="400" stroke="var(--color-charcoal)" stroke-width="1"/>
  <line x1="318" y1="392" x2="318" y2="408" stroke="var(--color-charcoal)" stroke-width="1"/>
  <line x1="560" y1="392" x2="560" y2="408" stroke="var(--color-charcoal)" stroke-width="1"/>
  <line x1="549.0" y1="54.9" x2="470.0" y2="2.9" stroke="var(--color-charcoal)" stroke-width="1"/>
  <circle cx="549.0" cy="54.9" r="3" fill="var(--color-charcoal)"/>
  <rect x="455.0" y="-12.1" width="30" height="30" fill="var(--color-forest)"/>
  <text x="470.0" y="9.9" text-anchor="middle" font-family="Oswald, Arial Narrow, sans-serif" font-weight="700" font-size="19" fill="var(--color-cream)">A</text>
  <line x1="440.0" y1="160.6" x2="470.0" y2="238.6" stroke="var(--color-charcoal)" stroke-width="1"/>
  <circle cx="440.0" cy="160.6" r="3" fill="var(--color-charcoal)"/>
  <rect x="455.0" y="223.6" width="30" height="30" fill="var(--color-forest)"/>
  <text x="470.0" y="245.6" text-anchor="middle" font-family="Oswald, Arial Narrow, sans-serif" font-weight="700" font-size="19" fill="var(--color-cream)">B</text>
  <line x1="288.0" y1="368.0" x2="208.0" y2="392.0" stroke="var(--color-charcoal)" stroke-width="1"/>
  <circle cx="288.0" cy="368.0" r="3" fill="var(--color-charcoal)"/>
  <rect x="193.0" y="377.0" width="30" height="30" fill="var(--color-forest)"/>
  <text x="208.0" y="399.0" text-anchor="middle" font-family="Oswald, Arial Narrow, sans-serif" font-weight="700" font-size="19" fill="var(--color-cream)">C</text>
  <line x1="439.0" y1="400.0" x2="439.0" y2="440.0" stroke="var(--color-charcoal)" stroke-width="1"/>
  <circle cx="439.0" cy="400.0" r="3" fill="var(--color-charcoal)"/>
  <rect x="424.0" y="425.0" width="30" height="30" fill="var(--color-forest)"/>
  <text x="439.0" y="447.0" text-anchor="middle" font-family="Oswald, Arial Narrow, sans-serif" font-weight="700" font-size="19" fill="var(--color-cream)">D</text>
</svg>
