---
// The headline that titles a plate, in the condensed display cut, with an
// optional lead paragraph under it. Neither takes a tint; they inherit the
// ink of the surface they sit on.
interface Props {
  title: string;
  description?: string;
  tone?: "forest" | "cream";
  align?: "left" | "center";
  class?: string;
}

const {
  title,
  description,
  tone = "forest",
  align = "left",
  class: className = "",
} = Astro.props;

const titleTone = tone === "cream" ? "text-on-forest" : "text-ink";
const bodyTone = tone === "cream" ? "text-on-forest-mute" : "text-body";
---

<div class={`${align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl"} ${className}`}>
  <h2 class={`t-display-lg ${titleTone}`}>{title}</h2>
  {description && <p class={`t-lead mt-5 ${bodyTone}`}>{description}</p>}
</div>
