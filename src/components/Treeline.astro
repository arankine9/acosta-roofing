---
// Repeating fir silhouette, tiled as a background image so it spans any width
// without stretching the trees. The firs are cut from the logo mark itself
// (see public/treeline.svg), so the seams between chapters are drawn with the
// same stand that sits behind the gable.
//
// It marks the seam between a cream chapter and a forest one and is always
// drawn upright, standing on the forest band: cream firs INSIDE the band's
// bottom edge, forest firs sitting on top of it via `bottom-full`. Never
// mirror it; upside-down conifers read as a mistake.
interface Props {
  tone?: "forest" | "cream";
  height?: number;
  /* Slides the stand sideways. Every seam on the page draws the same tile, so
     without a distinct offset per seam the identical trees get cut at the
     identical places each time and the page reads as one repeated strip. */
  offset?: number;
  class?: string;
}

const {
  tone = "forest",
  height = 56,
  offset = 0,
  class: className = "",
} = Astro.props;

const src = tone === "cream" ? "/treeline-light.svg" : "/treeline.svg";
const ink = tone === "cream" ? "var(--color-cream)" : "var(--color-forest)";

// The tile is 626x72 with its ground band in the bottom 14. Scaled to an
// arbitrary height the tile width goes fractional, so the repeats land on
// sub-pixel boundaries and a hairline of the page shows through the band at
// every seam. Painting the band as a flat layer *behind* the tile closes it:
// the trees are buried deep enough in the band that the underlay never reads
// as a separate edge. Ceil so the underlay is never the thinner of the two.
const band = Math.ceil((height * 14) / 72);
---

<div
  class={`w-full ${className}`}
  style={[
    `height:${height}px`,
    `background-image:url("${src}"),linear-gradient(to top,${ink} ${band}px,transparent ${band}px)`,
    `background-repeat:repeat-x,no-repeat`,
    `background-position:${offset}px bottom,center bottom`,
    `background-size:auto ${height}px,100% ${height}px`,
  ].join(";")}
  aria-hidden="true"
>
</div>
