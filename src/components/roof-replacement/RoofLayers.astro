---
// Cross-section of a shingle roof at the eave, drawn in the house inks:
// hairline charcoal, forest for the metal and membranes, cream-deep for the
// deck. Layer thickness is exaggerated so each one reads; the numbers match
// the legend on the roof-replacement page, which carries the words (so the
// drawing stays legible at phone width, where labels would shrink to
// nothing). Generated from a small script, so the geometry is plain
// coordinates rather than transforms.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
