---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";

// Emergency band. Two services, two panels, side by side on desktop and
// stacked below 1024px. No numbered steps and no response-time claims: both
// entries say the same honest thing in their own terms: stabilize now, price
// the permanent repair after, in writing.
const services = [
  {
    icon: "roof-repair",
    kind: "Residential & commercial",
    title: "Emergency tarping",
    body: "Emergency tarping for steep-slope residential and commercial roofs damaged by active leaks, storm damage, wind damage or fallen trees. Tarping stabilizes the roof immediately to prevent further water intrusion while a permanent repair is planned.",
    note: "A written estimate for permanent repair is provided after emergency tarping is complete.",
  },
  {
    icon: "commercial",
    kind: "Commercial",
    title: "Emergency flat roof repair & sealing",
    body: `Emergency repair and sealing for commercial flat roof systems experiencing active leaks, seam failures, flashing failures or storm damage. ${site.name} seals and stabilizes the affected area immediately to stop water intrusion.`,
    note: "A written estimate for full permanent repair follows emergency stabilization.",
  },
];
---

<section id="emergency" class="section bg-cream-deep">
  <div class="container-page">
    <SectionHeading title="Emergency roof repair" class="mb-14" />

    <div class="grid gap-5 lg:grid-cols-2">
      {
        services.map((service) => (
          <article class="panel panel-keyline flex flex-col p-8">
            <div class="flex items-start justify-between gap-4">
              <Icon name={service.icon} size={38} class="text-forest" />
              <span class="badge-tag mt-1">{service.kind}</span>
            </div>

            <h3 class="t-heading-md mt-6 text-ink">{service.title}</h3>
            <p class="t-body-sm mt-3 grow text-body">{service.body}</p>

            <p class="t-body-sm mt-6 border-t border-hairline pt-4 text-ink">
              {service.note}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-6 border-t border-hairline pt-8">
      <p class="t-body-md max-w-2xl text-body">
        Both services cover active leaks, storm damage, wind damage and fallen
        tree damage for residential and commercial properties.
      </p>

      <a href={site.phoneHref} class="btn btn-primary">
        <Icon name="phone" size={18} />
        Call {site.phone}
      </a>
    </div>
  </div>
</section>
