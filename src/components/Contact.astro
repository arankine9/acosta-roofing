---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import Text from "./Text.astro";
import { site, cityLine } from "../data/site";
import { attrs } from "../lib/cms";

interface Props {
  /* Content key of the heading, form and side-panel words. Every page
     shares the one in shared.json unless it passes its own. */
  k?: string;
}

const { k = "shared:contact" } = Astro.props;
const f = `${k}.form`;
const placeholder = (name: string) => attrs({ placeholder: `${f}.${name}.placeholder` });
---

<section id="contact" class="section bg-cream-deep">
  <div class="container-page">
    <SectionHeading k={k} class="mb-14" />

    <div class="grid gap-5 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)]">
      <!--
        Static form. There is no backend yet: it posts nowhere, and the note
        under the submit button says so rather than silently swallowing an
        enquiry. Wire `action` to a handler before launch.
      -->
      <form class="panel p-7 md:p-9" method="post" action="#contact">
        <div class="plate-label -mx-7 -mt-7 mb-8 md:-mx-9 md:-mt-9">
          <Text k={`${f}.label`} as="span" class="t-spaced" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <Text k={`${f}.name.label`} as="label" for="name" class="label-field" />
            <input id="name" name="name" type="text" required class="text-input" {...placeholder("name")} />
          </div>
          <div>
            <Text k={`${f}.phone.label`} as="label" for="phone" class="label-field" />
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              class="text-input"
              {...placeholder("phone")}
            />
          </div>
          <div class="sm:col-span-2">
            <Text k={`${f}.email.label`} as="label" for="email" class="label-field" />
            <input id="email" name="email" type="email" class="text-input" {...placeholder("email")} />
          </div>
          <div class="sm:col-span-2">
            <Text k={`${f}.address.label`} as="label" for="address" class="label-field" />
            <input id="address" name="address" type="text" class="text-input" {...placeholder("address")} />
          </div>
          <div class="sm:col-span-2">
            <Text k={`${f}.detail.label`} as="label" for="detail" class="label-field" />
            <textarea
              id="detail"
              name="detail"
              rows="4"
              class="text-input"
              {...placeholder("detail")}></textarea>
          </div>
        </div>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
          <button type="submit" class="btn btn-primary"><Text k={`${f}.submit`} bare /></button>
          <a href={site.phoneHref} class="btn btn-outline"><Text k={`${f}.call`} bare /></a>
        </div>

        <Text k={`${f}.note`} class="t-caption mt-5 text-mute" />
      </form>

      <div class="flex flex-col gap-5">
        <!-- Business card, front: the brand board's card, set as a real
             contact block so the details are selectable. -->
        <div class="panel panel-keyline panel-keyline-cream bg-forest p-7 text-on-forest">
          <h3 class="t-heading-sm">{site.legalName}</h3>
          <ul class="mt-5 space-y-4">
            <li class="flex items-center gap-3">
              <Icon name="phone" size={20} class="shrink-0 text-on-forest-mute" />
              <a href={site.phoneHref} class="t-body-strong inline-flex min-h-11 items-center">{site.phone}</a>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="pin" size={20} class="shrink-0 text-on-forest-mute" />
              <address class="t-body-sm not-italic text-on-forest-mute">
                {site.address.street && <>{site.address.street}<br /></>}
                {cityLine}
              </address>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="mail" size={20} class="shrink-0 text-on-forest-mute" />
              <a
                href={`mailto:${site.email}`}
                class="t-body-sm inline-flex min-h-11 items-center text-on-forest-mute hover:text-on-forest"
              >
                {site.email}
              </a>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="globe" size={20} class="shrink-0 text-on-forest-mute" />
              <span class="t-body-sm text-on-forest-mute">{site.domain}</span>
            </li>
          </ul>
          <Text k={`${k}.card.coverage`} class="t-spaced-sm mt-6 border-t border-hairline-dark pt-4 text-on-forest-mute" />
        </div>

        <div class="panel p-7">
          <h3 class="t-heading-sm flex items-center gap-3 text-forest">
            <Icon name="clock" size={20} />
            <Text k={`${k}.hours.title`} bare />
          </h3>
          <dl class="mt-5 border-t border-hairline">
            {
              site.hours.map((entry) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-hairline py-3">
                  <dt class="t-body-strong text-ink">{entry.days}</dt>
                  <dd class="t-body-sm text-body">{entry.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
