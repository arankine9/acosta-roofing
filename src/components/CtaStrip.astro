---
// Forest band bridging two cream chapters, with the treeline running along the
// top edge so the join reads as the brand board's plate seam rather than as a
// flat color change.
import Treeline from "./Treeline.astro";
import Text from "./Text.astro";
import { site } from "../data/site";

// On an inner page the estimate button goes to the contact page; the home
// page passes its own #contact anchor. The section above this band must
// leave 64px of extra bottom padding for the treeline standing into it.
interface Props {
  /* Content key of the title and body; the shared one unless a page passes
     its own. */
  k?: string;
  href?: string;
  offset?: number;
}

const { k = "shared:ctaStrip", href = "#contact", offset = -190 } = Astro.props;
---

<section class="on-forest relative bg-forest text-on-forest">
  <Treeline tone="forest" height={64} offset={offset} class="absolute inset-x-0 bottom-full" />

  <div
    class="container-page relative flex flex-col items-start gap-8 pt-24 pb-16 md:flex-row md:items-center md:justify-between md:pt-28"
  >
    <div>
      <Text k={`${k}.title`} as="h2" class="t-heading-xl" />
      <Text k={`${k}.body`} class="t-body-md mt-3 max-w-xl text-on-forest-mute" />
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a href={site.phoneHref} class="btn btn-cream">Call {site.phone}</a>
      <a href={href} class="btn btn-outline-cream">Request an Estimate</a>
    </div>
  </div>
</section>
