---
// A gable house cut through front to back, drawn to show everything on a
// roof that isn't the shingle: underlayment over the whole deck,
// ice-and-water shield at the eaves, starter course, drip edge, flashing at the chimney and
// the plumbing vent, soffit intake and ridge exhaust with the air path
// between them, and the ridge cap. The numbers match the legend on the
// materials page, which carries the words, so the drawing still reads at
// phone width. House inks only. Generated by a small script; the geometry
// is plain coordinates.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
