---
// 76px cream bar under the utility strip: lockup left, link row center, one
// forest CTA right. Below 1024px the row collapses into a drawer built from
// <details>: no framework, and it still opens with JS off.
import Logo from "./Logo.astro";
import { site } from "../data/site";

const links = [
  { href: "#services", label: "Services" },
  { href: "#emergency", label: "Emergency" },
  { href: "#service-area", label: "Service Area" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas shadow-[0_1px_0_0_rgba(43,43,43,0.18)]">
  <nav class="container-page flex h-[76px] items-center justify-between gap-6 max-[340px]:gap-3" aria-label="Main">
    <a href="/" class="shrink-0">
      <Logo />
      <span class="sr-only">Home</span>
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="t-spaced-sm border-b-2 border-transparent pb-1 text-ink hover:border-forest hover:text-forest"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="hidden items-center gap-6 lg:flex">
      <a href={site.phoneHref} class="t-heading-sm text-forest hover:text-forest-deep">
        {site.phone}
      </a>
      <a href="#contact" class="btn btn-primary">Free Estimate</a>
    </div>

    <details class="group lg:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-end text-forest [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg class="group-open:hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M2 6h20M2 12h20M2 18h20" stroke="currentColor" stroke-width="2"></path>
        </svg>
        <svg class="hidden group-open:block" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </summary>

      <!-- Drawer hangs off the sticky header so it tracks the 76px bar. -->
      <div
        class="absolute inset-x-0 top-[76px] max-h-[calc(100dvh-76px)] overflow-y-auto border-t border-hairline bg-canvas px-6 pb-10 pt-2"
      >
        <ul>
          {
            links.map((link) => (
              <li class="border-b border-hairline">
                <a href={link.href} class="t-heading-md block py-5 text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href={site.phoneHref} class="btn btn-primary mt-8 w-full">Call {site.phone}</a>
        <a href="#contact" class="btn btn-outline mt-3 w-full">Request an Estimate</a>
      </div>
    </details>
  </nav>
</header>
