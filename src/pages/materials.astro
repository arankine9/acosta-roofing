---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Treeline from "../components/Treeline.astro";
import Icon from "../components/Icon.astro";
import Text from "../components/Text.astro";
import Img from "../components/Img.astro";
import RoofSystem from "../components/materials/RoofSystem.astro";
import { pages, estimateHref } from "../data/nav";
import { serviceHref } from "../data/services";
import { site } from "../data/site";
import { file, list, item, credit } from "../lib/cms";

// The materials page: the three systems from the home page's Materials band,
// each at full length (what it is, where it fits, strengths, trade-offs,
// Northwest weather, upkeep), then a side-by-side table, the parts around
// the shingles that decide how long a roof lasts, and how we pick one.
//
// Expected-life figures are the same as the home page band (Materials.astro):
// typical industry ranges for a correctly installed, maintained roof, not a
// warranty. Keep the two in step if either changes.
//
// No manufacturer product lines are named on purpose: the page explains the
// material, not a brand.
//
// Photos (public/images/materials/page/):
//   rain-on-shingles.jpg      Luke Southern, Unsplash (Unsplash License)
//                             https://unsplash.com/photos/ZzZouwiQWV0
//   architectural-shingle.jpg Hal Gatewood, Unsplash (Unsplash License)
//                             https://unsplash.com/photos/9u5r1XbtMJg
//   white-single-ply-over-old-roof.jpg
//                             Daniel X. O'Neil, "Workers adding reflective
//                             roofing material", Flickr, CC BY 2.0
//                             https://www.flickr.com/photos/juggernautco/3016888550
//                             https://creativecommons.org/licenses/by/2.0/
//                             (cropped to 3:2; credited in its caption)
// The roof section is drawn inline: src/components/materials/RoofSystem.astro.
const crumbs = [{ label: "Roofing materials", href: pages.materials }];

// Every word on this page is in src/content/pages/materials.json; `k` is the
// key prefix into it and `c` its parsed content, for the lists.
const k = "pages/materials";
const c = file(k);

// Anchors of the three systems, in the order of the index entries.
const systemIds = ["architectural-shingle", "designer-shingle", "single-ply"];
---

<Page k={k} crumbs={crumbs}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-220} />

  {/* 1. Index of the three systems, then architectural: photo left, ruled spec rows right. */}
  <section class="section bg-canvas">
    <div class="container-page">
      <nav aria-label="The three systems" class="border-y border-hairline">
        <ul class="grid md:grid-cols-3">
          {
            c.index.items.map((_: unknown, index: number) => (
              <li
                class:list={[
                  "border-hairline",
                  index > 0 && "border-t md:border-t-0 md:border-l md:pl-6",
                  index < c.index.items.length - 1 && "md:pr-6",
                ]}
              >
                <a
                  href={`#${systemIds[index]}`}
                  class="group flex h-full items-end justify-between gap-4 py-5"
                >
                  <span>
                    <Text k={`${k}:index.items.${index}.fit`} as="span" class="t-spaced-sm block text-mute" />
                    <Text k={`${k}:index.items.${index}.title`} as="span" class="t-heading-sm mt-2 block text-ink group-hover:text-forest" />
                  </span>
                  <span class="shrink-0 text-right">
                    <Text k={`${k}:index.items.${index}.life`} as="span" class="t-heading-md block text-forest" />
                    <Text k={`${k}:index.unit`} as="span" class="t-caption block text-mute" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <article id="architectural-shingle" class="mt-16 grid gap-10 lg:mt-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div>
          <Text k={`${k}:architectural.eyebrow`} class="t-eyebrow text-forest" />
          <Text k={`${k}:architectural.title`} as="h2" class="t-display-lg mt-4 text-ink" />
          <Text k={`${k}:architectural.lead`} class="t-lead mt-5 text-body" />

          <figure class="photo-plate mt-8">
            <Img k={`${k}:architectural.image`} class="aspect-[4/3]" loading="lazy" decoding="async" />
            <Text k={`${k}:architectural.caption`} as="figcaption" />
          </figure>

          <dl class="mt-8 flex flex-row-reverse items-end justify-end gap-4 border-t border-hairline pt-6">
            <Text k={`${k}:architectural.life.label`} as="dt" class="t-caption max-w-[22ch] text-mute" />
            <Text k={`${k}:architectural.life.value`} as="dd" class="t-display-lg leading-none text-forest" />
          </dl>
        </div>

        {/* The same five aspects every system is described by, so a fixed set
            rather than an editable list. */}
        <dl class="spec-rows">
          {
            c.architectural.specs.map((_: unknown, i: number) => (
              <div>
                <Text k={`${k}:architectural.specs.${i}.term`} as="dt" />
                <Text k={`${k}:architectural.specs.${i}.body`} type="block" as="dd" />
              </div>
            ))
          }
        </dl>
      </article>
    </div>
  </section>

  {/* 2. Designer: long-form prose with a sticky rail (fact plate).
      Extra bottom padding: the next band's treeline stands up into it. */}
  <section
    id="designer-shingle"
    class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28"
  >
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
      <div class="min-w-0">
        <Text k={`${k}:designer.eyebrow`} class="t-eyebrow text-forest" />
        <Text k={`${k}:designer.title`} as="h2" class="t-display-lg mt-4 text-ink" />
        <Text k={`${k}:designer.body`} type="block" as="div" class="prose-page mt-6" />
      </div>

      <aside class="min-w-0">
        <div class="flex flex-col gap-8 lg:sticky lg:top-28">
          <div class="panel panel-keyline overflow-hidden">
            <div class="plate-label">
              <Text k={`${k}:designer.glance.label`} as="span" class="t-spaced-sm" />
            </div>
            <dl class="glance px-6 py-3">
              {
                c.designer.glance.rows.map((_: unknown, i: number) => (
                  <div>
                    <Text k={`${k}:designer.glance.rows.${i}.term`} as="dt" />
                    <Text k={`${k}:designer.glance.rows.${i}.value`} as="dd" />
                  </div>
                ))
              }
            </dl>
          </div>
          <Text k={`${k}:designer.note`} class="t-caption text-mute" />
        </div>
      </aside>
    </div>
  </section>

  {/* 3. Single-ply on a forest band: heading row, wide photo, three columns. */}
  <section id="single-ply" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-310} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
        <div>
          <Text k={`${k}:singlePly.eyebrow`} class="t-eyebrow text-on-forest-mute" />
          <Text k={`${k}:singlePly.title`} type="rich" as="h2" class="t-display-lg mt-4" />
        </div>
        <Text k={`${k}:singlePly.lead`} class="t-lead text-on-forest-mute" />
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <figure class="photo-plate">
          <Img k={`${k}:singlePly.image`} class="aspect-[3/2]" loading="lazy" decoding="async" />
          <figcaption>
            <Text k={`${k}:singlePly.caption`} bare />{" "}<Fragment set:html={credit(`${k}:singlePly.image`)} />
          </figcaption>
        </figure>

        <div class="prose-page">
          <Text k={`${k}:singlePly.what.title`} as="h3" />
          {c.singlePly.what.body.map((_: unknown, i: number) => (
            <Text k={`${k}:singlePly.what.body.${i}`} />
          ))}
          <dl class="mt-8 flex flex-row-reverse items-end justify-end gap-4 border-t border-hairline-dark pt-6">
            <Text k={`${k}:singlePly.life.label`} as="dt" class="t-caption max-w-[22ch] text-on-forest-mute" />
            <Text k={`${k}:singlePly.life.value`} as="dd" class="t-display-lg leading-none text-on-forest" />
          </dl>
        </div>
      </div>

      <div class="mt-14 grid border-t border-hairline-dark md:grid-cols-3">
        <div class="py-8 md:pr-8">
          <Text k={`${k}:singlePly.fits.title`} as="h3" class="t-heading-md" />
          <Text k={`${k}:singlePly.fits.body`} class="t-body-sm mt-3 text-on-forest-mute" />
        </div>
        <div class="border-t border-hairline-dark py-8 md:border-t-0 md:border-l md:px-8">
          <Text k={`${k}:singlePly.strengths.title`} as="h3" class="t-heading-md" />
          <ul class="check-list t-body-sm mt-4 text-on-forest-mute" {...list(`${k}:singlePly.strengths.items`)}>
            {c.singlePly.strengths.items.map((_: unknown, i: number) => (
              <Text k={`${k}:singlePly.strengths.items.${i}`} as="li" {...item(i)} />
            ))}
          </ul>
        </div>
        <div class="border-t border-hairline-dark py-8 md:border-t-0 md:border-l md:pl-8">
          <Text k={`${k}:singlePly.tradeoffs.title`} as="h3" class="t-heading-md" />
          <ul class="check-list dash t-body-sm mt-4 text-on-forest-mute" {...list(`${k}:singlePly.tradeoffs.items`)}>
            {c.singlePly.tradeoffs.items.map((_: unknown, i: number) => (
              <Text k={`${k}:singlePly.tradeoffs.items.${i}`} as="li" {...item(i)} />
            ))}
          </ul>
        </div>
      </div>

      <div class="grid gap-10 border-t border-hairline-dark pt-10 md:grid-cols-2 md:gap-16">
        <div>
          <Text k={`${k}:singlePly.weather.title`} as="h3" class="t-heading-md" />
          <Text k={`${k}:singlePly.weather.body`} class="t-body-md mt-3 text-on-forest-mute" />
        </div>
        <div>
          <Text k={`${k}:singlePly.upkeep.title`} as="h3" class="t-heading-md" />
          <Text k={`${k}:singlePly.upkeep.body`} class="t-body-md mt-3 text-on-forest-mute" />
          <a href={serviceHref("commercial")} class="t-spaced-sm mt-6 inline-flex min-h-12 items-center gap-2 text-on-forest hover:text-on-forest-mute">
            <Text k={`${k}:singlePly.upkeep.link`} bare />
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </div>

    <Treeline tone="cream" height={64} offset={-40} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 4. Side-by-side reference table. Each cell is short on purpose; the
      sections above carry the reasons. Rows and columns are fixed (not an
      editable list): the columns follow the three systems, and the expected
      life row is styled by its position (tr:nth-child(3) below). */}
  <section class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:compare.title`} as="h2" class="t-display-lg text-ink" />
        <Text k={`${k}:compare.lead`} class="t-lead max-w-2xl text-body" />
      </div>

      <Text k={`${k}:compare.swipeHint`} class="t-caption mt-8 text-mute md:hidden" />
      <div class="table-scroll mt-3 md:mt-10">
        <table class="data-table compare-table">
          <caption class="sr-only">Comparison of architectural shingle, designer shingle and single-ply membrane</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Property</span></th>
              {c.compare.columns.map((_: unknown, i: number) => (
                <Text k={`${k}:compare.columns.${i}`} as="th" scope="col" />
              ))}
            </tr>
          </thead>
          <tbody>
            {
              c.compare.rows.map((row: { cells: string[] }, r: number) => (
                <tr>
                  <Text k={`${k}:compare.rows.${r}.label`} as="th" scope="row" />
                  {row.cells.map((_, i) => (
                    <Text k={`${k}:compare.rows.${r}.cells.${i}`} as="td" />
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <Text k={`${k}:compare.note`} class="t-caption mt-4 max-w-3xl text-mute" />
    </div>
  </section>

  {/* 5. The rest of the roof: drawing in a plate, numbered legend beside it. */}
  <section class="section bg-cream-deep">
    <div class="container-page">
      <div class="max-w-3xl">
        <Text k={`${k}:parts.title`} as="h2" class="t-display-lg text-ink" />
        <Text k={`${k}:parts.lead`} class="t-lead mt-5 text-body" />
      </div>

      <div class="mt-12">
        <figure class="panel m-0 overflow-hidden">
          <figcaption class="plate-label flex-wrap justify-between gap-y-1">
            <Text k={`${k}:parts.figureLabel`} as="span" class="t-spaced-sm" />
            <Text k={`${k}:parts.scaleNote`} as="span" class="t-spaced-sm text-on-forest-mute" />
          </figcaption>
          <div class="bg-board px-2 py-6 sm:px-8 lg:px-16 lg:py-10">
            <RoofSystem class="mx-auto block h-auto w-full max-w-[1000px]" />
          </div>
          <div class="flex flex-wrap gap-x-8 gap-y-2 border-t border-hairline px-5 py-4">
            <span class="flex items-center gap-2.5">
              <span class="key-line key-dashed" aria-hidden="true"></span>
              <Text k={`${k}:parts.key.air`} as="span" class="t-caption text-body" />
            </span>
            <span class="flex items-center gap-2.5">
              <span class="key-line key-solid" aria-hidden="true"></span>
              <Text k={`${k}:parts.key.metal`} as="span" class="t-caption text-body" />
            </span>
            <span class="flex items-center gap-2.5">
              <span class="key-line key-thin" aria-hidden="true"></span>
              <Text k={`${k}:parts.key.underlayment`} as="span" class="t-caption text-body" />
            </span>
          </div>
        </figure>

        {/* Legend for the drawing. An entry's position is its number on the
            drawing, so this is not an editable list. */}
        <ol class="parts-list mt-10">
          {
            c.parts.items.map((_: unknown, i: number) => (
              <li>
                <span class="parts-num" aria-hidden="true">{i + 1}</span>
                <div>
                  <Text k={`${k}:parts.items.${i}.title`} as="h3" class="t-heading-sm text-ink" />
                  <Text k={`${k}:parts.items.${i}.body`} class="t-body-sm mt-1.5 text-body" />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* 6. How we help you choose: sticky heading left, ruled factors right. */}
  <section class="section bg-canvas">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
      <div>
        <div class="lg:sticky lg:top-28">
          <Text k={`${k}:choose.title`} as="h2" class="t-display-lg text-ink" />
          <Text k={`${k}:choose.lead`} class="t-lead mt-5 text-body" />
          <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-start">
            <Text k={`${k}:choose.estimateButton`} as="a" href={estimateHref} class="btn btn-primary" />
            <Text k={`${k}:choose.callButton`} as="a" href={site.phoneHref} class="btn btn-outline" />
          </div>
        </div>
      </div>

      <ul class="border-t border-hairline" {...list(`${k}:choose.items`)}>
        {
          c.choose.items.map((_: unknown, i: number) => (
            <li class="grid gap-2 border-b border-hairline py-7 sm:grid-cols-[200px_minmax(0,1fr)] sm:gap-8" {...item(i)}>
              <Text k={`${k}:choose.items.${i}.title`} as="h3" class="t-heading-md text-ink" />
              <Text k={`${k}:choose.items.${i}.body`} class="t-body-md text-body" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingCta k={`${k}:closingCta`} />
</Page>

<style>
  /* Ruled spec rows for the architectural section: term in the display cut on the
     left, the answer on the right; stacked on small screens. */
  .spec-rows {
    border-top: 1px solid var(--color-hairline);
  }
  .spec-rows > div {
    display: grid;
    gap: 8px;
    padding-block: 22px;
    border-bottom: 1px solid var(--color-hairline);
  }
  @media (min-width: 640px) {
    .spec-rows > div {
      grid-template-columns: 170px minmax(0, 1fr);
      gap: 24px;
    }
  }
  .spec-rows dt {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-forest);
  }
  .spec-rows dd {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--color-body);
  }

  /* Trade-offs get a plain rule instead of a check: a check would read as
     a point in the material's favor. The architectural list is markup inside
     a content field, which carries no scope attribute, hence :global. */
  :global(.dash-list > li),
  .check-list.dash > li {
    position: relative;
    padding-left: 32px;
  }
  :global(.dash-list > li + li) {
    margin-top: 12px;
  }
  :global(.dash-list > li::before),
  .check-list.dash > li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.8em;
    width: 14px;
    height: 2px;
    background-color: var(--color-forest);
    mask: none;
  }
  .on-forest .check-list.dash > li::before {
    background-color: var(--color-cream);
  }

  /* Fact plate in the designer rail. */
  .glance > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .glance > div:last-child {
    border-bottom: 0;
  }
  .glance dt {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-mute);
    flex: none;
  }
  .glance dd {
    margin: 0;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
  }

  /* Comparison table: a fixed first column and even data columns; wide
     enough to scroll inside itself on a phone rather than squeeze. */
  .compare-table {
    min-width: 760px;
    table-layout: fixed;
  }
  .compare-table thead th:first-child,
  .compare-table tbody th {
    width: 170px;
  }
  /* On a phone the label column narrows so the next column shows at the
     edge, which is what tells you the table scrolls. */
  @media (max-width: 767.98px) {
    .compare-table {
      min-width: 640px;
    }
    .compare-table thead th:first-child,
    .compare-table tbody th {
      width: 116px;
    }
    .compare-table th,
    .compare-table td {
      padding: 12px 14px;
    }
  }
  .compare-table tbody th {
    font-size: 13.5px;
    letter-spacing: 0.1em;
    color: var(--color-forest);
  }
  .compare-table tbody tr:nth-child(3) td {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-ink);
  }

  /* Legend for the roof section: forest number blocks matching the drawing. */
  .parts-list {
    border-top: 1px solid var(--color-hairline);
  }
  .parts-list > li {
    display: grid;
    align-content: start;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .parts-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background-color: var(--color-forest);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
  }
  @media (min-width: 768px) {
    .parts-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
    }
  }
  @media (min-width: 1280px) {
    .parts-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 32px;
    }
    .parts-list > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding-block: 20px 24px;
    }
  }

  .key-line {
    flex: none;
    width: 28px;
    height: 0;
    border-top: 2px dashed var(--color-forest);
  }
  .key-solid {
    border-top: 4px solid var(--color-forest);
  }
  .key-thin {
    border-top: 2px solid var(--color-forest-mid);
  }
</style>
