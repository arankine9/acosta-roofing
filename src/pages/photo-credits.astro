---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import Text from "../components/Text.astro";
import { asset, page } from "../lib/url";
import { photoCredits as groups, licenseInfo } from "../data/photo-credits";
import { get, text, field, EDIT } from "../lib/cms";

// Photo credits: every sourced photograph still on the site, by page, with
// its photographer, source and licence. The data is src/data/photo-credits.ts,
// which also drops photos the owner has replaced; this page only lays it out.
// Each page is a ruled block, each photo a row with a thumbnail so the credit
// can be matched to the picture.
const crumbs = [{ label: "Photo credits", href: page("/photo-credits/") }];
const total = groups.reduce((sum, group) => sum + group.credits.length, 0);

const k = "pages/photo-credits";

// The lead counts the photos listed, a number that falls as the owner swaps
// in his own, so it carries a {{photoCount}} token of this page's own. It is
// filled in here, as a locked chip in the edit build like any other token,
// and rendered under the hero's title in place of a content `hero.lead`.
const leadKey = `${k}:lead`;
const count = EDIT ? `<span data-cms-token="photoCount" contenteditable="false">${total}</span>` : String(total);
const lead = text(get<string>(leadKey).replace(/\{\{\s*photoCount\s*\}\}/g, "\u0000")).split("\u0000").join(count);
---

<Page k={k} crumbs={crumbs}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} actions={false} treelineOffset={-445}>
    <p class="t-lead mt-6 max-w-2xl text-on-forest-mute" {...field(leadKey)} set:html={lead} />
  </PageHero>

  <section class="section bg-canvas pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <Text k={`${k}:intro`} class="t-body-md max-w-2xl text-body" />

      <div class="mt-14 space-y-14">
        {
          groups.map((group) => (
            <div class="grid gap-6 border-t border-hairline pt-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-12">
              <h2 class="t-heading-md text-ink">
                <a href={group.href} class="hover:text-forest">
                  {group.page}
                </a>
              </h2>
              <ul class="border-t border-hairline lg:border-t-0">
                {group.credits.map((credit) => {
                  const license = licenseInfo(credit.license);
                  return (
                    <li class="grid grid-cols-[96px_minmax(0,1fr)] gap-5 border-b border-hairline py-5 first:pt-0 max-lg:first:pt-5 sm:grid-cols-[128px_minmax(0,1fr)]">
                      <img
                        src={asset(credit.file)}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] w-full border border-hairline bg-cream-deep object-cover"
                      />
                      <div class="min-w-0">
                        <p class="t-body-strong text-ink">{credit.subject}</p>
                        <p class="t-body-sm mt-1 text-body">
                          <Text k={`${k}:photoLabel`} bare /> {credit.author}
                          {credit.source && (
                            <>
                              {" "}&middot;{" "}
                              <a href={credit.source} class="link-inline font-medium" rel="noopener" target="_blank">
                                <Text k={`${k}:sourceLabel`} bare />
                              </a>
                            </>
                          )}
                        </p>
                        <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                          <a href={license.url} class="badge-tag hover:border-forest" rel="noopener license" target="_blank">
                            {license.name}
                          </a>
                          {credit.changes && <span class="t-caption text-mute">{credit.changes}</span>}
                        </p>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Page>
