---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Services from "../components/Services.astro";
import Materials from "../components/Materials.astro";
import LeakCall from "../components/LeakCall.astro";
import CtaStrip from "../components/CtaStrip.astro";
import ServiceArea from "../components/ServiceArea.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <Hero />
  {/* Cream body chapters alternate canvas / cream-deep between forest bands. */}
  <main id="main">
    <TrustStrip />
    <Services />
    <Materials />
    <LeakCall />
    <CtaStrip />
    <ServiceArea />
    <Contact />
  </main>
  <Footer />
</Base>
