---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import Contact from "../components/Contact.astro";
import LeakCall from "../components/LeakCall.astro";
import Icon from "../components/Icon.astro";
import Text from "../components/Text.astro";
import { site } from "../data/site";
import { pages } from "../data/nav";
import { file, list, item } from "../lib/cms";

// Contact. The form, business card and hours are the home page's Contact
// component, reused unchanged (including its note that the form isn't wired
// to a backend yet). Around it: what happens after you get in touch, what's
// worth having ready, where we work, and the leak call-out.
//
// This page ends on LeakCall rather than ClosingCta: a closing "request an
// estimate" plate would link to the page it sits on. The last section keeps
// ClosingCta's extra bottom padding for the footer's treeline.
//
// Photo credit: images/contact/ladder-at-the-ridge.jpg is Martin Martz, "A
// ladder is on the roof of a house", https://unsplash.com/photos/6uNBAv7_7Qc
// (Unsplash License).
const crumbs = [{ label: "Contact", href: pages.contact }];

const k = "pages/contact";
const c = file(k);
---

<Page k={k} crumbs={crumbs}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} actions={false} treelineOffset={-280}>
    <dl class="mt-10 grid max-w-xl border-t border-hairline-dark sm:grid-cols-2">
      <div class="border-b border-hairline-dark py-4 sm:border-r sm:pr-6">
        <Text k={`${k}:hero.callLabel`} as="dt" class="t-spaced-sm text-on-forest-mute" />
        <dd class="mt-1">
          <a href={site.phoneHref} class="t-heading-md inline-flex min-h-11 items-center whitespace-nowrap hover:underline">
            {site.phone}
          </a>
        </dd>
      </div>
      <div class="min-w-0 border-b border-hairline-dark py-4 sm:pl-6">
        <Text k={`${k}:hero.emailLabel`} as="dt" class="t-spaced-sm text-on-forest-mute" />
        <dd class="mt-1">
          <a href={`mailto:${site.email}`} class="t-body-md inline-flex min-h-11 items-center break-all text-on-forest hover:underline">
            {site.email}
          </a>
        </dd>
      </div>
    </dl>
  </PageHero>

  {/* The home page's form, card and hours, set on canvas here because it
      follows the hero's cream treeline. */}
  <div class="contact-on-canvas">
    <Contact />
  </div>

  <section id="next" class="section bg-cream-deep">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
      <div class="min-w-0">
        <Text k={`${k}:next.title`} as="h2" class="t-display-lg text-ink" />
        <ol class="step-list mt-10" {...list(`${k}:next.steps`)}>
          {
            c.next.steps.map((_: unknown, i: number) => (
              <li {...item(i)}>
                <Text k={`${k}:next.steps.${i}.title`} as="h3" class="t-heading-md text-ink" />
                <Text k={`${k}:next.steps.${i}.body`} class="t-body-md text-body" />
              </li>
            ))
          }
        </ol>
        <Text k={`${k}:next.area`} type="rich" class="t-body-md mt-8 max-w-2xl text-body" />
      </div>

      <aside class="min-w-0 lg:sticky lg:top-28 lg:self-start" aria-labelledby="have-ready">
        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <Icon name="check" size={18} />
            <Text k={`${k}:haveReady.label`} as="span" id="have-ready" class="t-spaced" />
          </div>
          <ul class="check-list px-6 pt-7 pb-8 sm:px-8" {...list(`${k}:haveReady.items`)}>
            {
              c.haveReady.items.map((_: unknown, i: number) => (
                <li {...item(i)}>
                  <Text k={`${k}:haveReady.items.${i}.title`} class="t-body-strong text-ink" />
                  <Text k={`${k}:haveReady.items.${i}.body`} class="t-body-sm text-body" />
                </li>
              ))
            }
          </ul>
          <Text k={`${k}:haveReady.note`} class="t-caption border-t border-hairline px-6 py-4 text-mute sm:px-8" />
        </div>
      </aside>
    </div>
  </section>

  <div class="leak-closing">
    <LeakCall />
  </div>
</Page>

<style>
  /* Surface swaps for the two reused home-page sections, so the chapters
     alternate canvas / cream-deep / canvas on this page. */
  .contact-on-canvas :global(#contact) {
    background-color: var(--color-canvas);
  }
  .leak-closing :global(#leak) {
    background-color: var(--color-canvas);
    /* The footer's treeline stands 64px into the last section, as it does
       into ClosingCta. */
    padding-bottom: 152px;
  }
  @media (max-width: 900px) {
    .leak-closing :global(#leak) {
      padding-bottom: 128px;
    }
  }
  @media (max-width: 560px) {
    .leak-closing :global(#leak) {
      padding-bottom: 112px;
    }
  }
</style>
