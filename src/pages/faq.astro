---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import CtaStrip from "../components/CtaStrip.astro";
import Icon from "../components/Icon.astro";
import Text from "../components/Text.astro";
import { pages, estimateHref } from "../data/nav";
import { serviceHref } from "../data/services";
import { file, list, item, plain } from "../lib/cms";

// Questions & answers. One content array (src/content/pages/faq.json) drives
// the topic index, the <details> rows and the FAQPage JSON-LD, so the page
// and the structured data can't drift apart. Answers are block fields (for
// the links); the schema gets the same text with the tags stripped.
//
// House rules for answers: no prices, no warranty lengths, no job counts,
// nothing about the business that isn't in src/data/site.ts. Lifespans are
// the same industry ranges the home page's Materials section uses. Permits
// and insurance are described as "depends", because they do.
const crumbs = [{ label: "Questions & answers", href: pages.faq }];

const k = "pages/faq";
const c = file(k);

interface Topic {
  /* The section's anchor, and the key into `moreHref` below. */
  id: string;
  title: string;
  intro: string;
  /* Label of the link under the intro; where it goes is in `moreHref`. */
  more?: string;
  items: { q: string; a: string }[];
}

const topics: Topic[] = c.topics;

// Where each topic's "more" link goes, by topic id.
const moreHref: Record<string, string> = {
  estimates: estimateHref,
  "repair-or-replace": serviceHref("roof-repair"),
  materials: pages.materials,
  weather: serviceHref("gutters"),
  licensing: serviceHref("commercial"),
};

// The strip sits between the first half of the topics and the second.
const firstHalf = topics.slice(0, 3);
const secondHalf = topics.slice(3);

const stripTags = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/\s+/g, " ")
    .trim();

const schema = {
  "@type": "FAQPage",
  mainEntity: topics.flatMap((topic) =>
    topic.items.map((entry) => ({
      "@type": "Question",
      name: plain(entry.q),
      acceptedAnswer: { "@type": "Answer", text: stripTags(plain(entry.a)) },
    })),
  ),
};

const questionCount = topics.reduce((sum, topic) => sum + topic.items.length, 0);
---

<Page k={k} crumbs={crumbs} schema={schema}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} actions={false} treelineOffset={-95}>
    {/* The lead opens on the live question count, so it's rendered here
        rather than as the hero's own lead. */}
    <p class="t-lead mt-6 max-w-2xl text-on-forest-mute">
      {questionCount} <Text k={`${k}:hero.leadAfterCount`} bare />
    </p>
    <nav aria-label="Topics" class="mt-10 max-w-3xl">
      <Text k={`${k}:topicsNav.label`} class="t-spaced-sm text-on-forest-mute" />
      <ol class="mt-4 grid border-t border-hairline-dark sm:grid-cols-2 sm:gap-x-10">
        {
          topics.map((topic, index) => (
            <li class="border-b border-hairline-dark">
              <a href={`#${topic.id}`} class="group flex min-h-12 items-center gap-4 py-3 hover:text-on-forest">
                <span class="t-heading-sm w-7 shrink-0 text-on-forest-mute">{String(index + 1).padStart(2, "0")}</span>
                <Text k={`${k}:topics.${index}.title`} as="span" class="t-heading-sm flex-1" />
                <span class="t-spaced-sm text-on-forest-mute">{topic.items.length}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHero>

  {
    [firstHalf, secondHalf].map((group, groupIndex) => (
      <>
        {group.map((topic, index) => {
          const number = groupIndex * firstHalf.length + index + 1;
          const t = `${k}:topics.${number - 1}`;
          const beforeStrip = groupIndex === 0 && index === group.length - 1;
          const more = topic.more !== undefined && moreHref[topic.id];
          return (
            <section
              id={topic.id}
              class:list={[
                "section",
                index % 2 === 0 ? "bg-canvas" : "bg-cream-deep",
                beforeStrip && "pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28",
              ]}
            >
              <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
                <div class="min-w-0 lg:sticky lg:top-28 lg:self-start">
                  <p class="t-eyebrow text-forest-mid">
                    <Text k={`${k}:topicEyebrow`} bare /> {String(number).padStart(2, "0")}
                  </p>
                  <Text k={`${t}.title`} as="h2" class="t-heading-xl mt-3 text-ink" />
                  <Text k={`${t}.intro`} class="t-body-md mt-4 max-w-md text-body" />
                  {more && (
                    <a
                      href={more}
                      class="t-spaced-sm mt-6 inline-flex min-h-11 items-center gap-2 text-forest hover:text-forest-deep"
                    >
                      <Text k={`${t}.more`} bare />
                      <Icon name="arrow" size={16} />
                    </a>
                  )}
                </div>
                <div class="qa-list min-w-0" {...list(`${t}.items`)}>
                  {topic.items.map((_, i) => (
                    <details {...item(i)}>
                      <Text k={`${t}.items.${i}.q`} as="summary" />
                      <Text k={`${t}.items.${i}.a`} type="block" as="div" class="qa-answer prose-page max-w-none" />
                    </details>
                  ))}
                </div>
              </div>
            </section>
          );
        })}
        {groupIndex === 0 && (
          <CtaStrip k={`${k}:ctaStrip`} href={estimateHref} offset={-305} />
        )}
      </>
    ))
  }

  <ClosingCta k={`${k}:closingCta`} surface="cream-deep" />
</Page>
