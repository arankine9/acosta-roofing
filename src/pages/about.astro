---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Treeline from "../components/Treeline.astro";
import Icon from "../components/Icon.astro";
import Text from "../components/Text.astro";
import Img from "../components/Img.astro";
import { site } from "../data/site";
import { pages } from "../data/nav";
import { asset } from "../lib/url";
import { file, list, item, credit } from "../lib/cms";

// About. Built around how the company works rather than a history: nothing
// here is a fact about the business that isn't in src/data/site.ts or
// already on the home page (small crew, the estimator is the installer, the
// four TrustStrip claims). No founding year, job counts, names or reviews.
//
// Photo credits:
// - images/about/crew-on-shingle-roof.jpg: Jon Callas, "Starting Roof
//   Install", https://www.flickr.com/photos/joncallas/5303968859
//   (CC BY 2.0, https://creativecommons.org/licenses/by/2.0/). Cropped to
//   4:3 and resized. The photo shows an installer crew (not ours) setting
//   and sealing roof-mount brackets; the caption describes the work, not
//   whose crew it is. Attribution is printed in the caption.
// - images/about/west-union-farmhouse.jpg: M.O. Stevens,
//   "22097 West Union Road - West Union, Oregon",
//   https://commons.wikimedia.org/wiki/File:22097_West_Union_Road_-_West_Union,_Oregon.JPG
//   (CC BY-SA 3.0, https://creativecommons.org/licenses/by-sa/3.0/). Cropped
//   square to the house and the fir behind it; attribution is required and
//   is printed in the caption. The caption leaves out the street address.
const crumbs = [{ label: "About", href: pages.about }];

// Every word on this page is in src/content/pages/about.json; `k` is the key
// prefix into it and `c` its parsed content, for the lists.
const k = "pages/about";
const c = file(k);

const ccbSearch = "https://search.ccb.state.or.us/search/";
---

<Page k={k} crumbs={crumbs}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} imageAspect="landscape" treelineOffset={-340} />

  {/* 1. Who we are, as far as the record goes. */}
  <section id="how-we-work" class="section bg-canvas">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
      <div class="min-w-0">
        <Text k={`${k}:howWeWork.title`} as="h2" class="t-display-lg text-ink" />
        {/*
          TODO(owner): the founder story belongs in this field, after the
          second paragraph. Two or three short paragraphs in your own words:
          who started Acosta Roofing, where you learned the trade, and why you
          run it the way you do. Leave out anything you wouldn't want a
          customer to quote back to you. Until it's written, this page
          deliberately says nothing about the company's history.
        */}
        <Text k={`${k}:howWeWork.body`} type="block" as="div" class="prose-page mt-8" />
      </div>

      <aside class="min-w-0 lg:sticky lg:top-28 lg:self-start" aria-label="Company record">
        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <Text k={`${k}:howWeWork.recordLabel`} as="span" class="t-spaced" />
          </div>
          <dl class="px-6 pt-3 pb-6">
            {
              c.howWeWork.record.map((_: unknown, i: number) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-hairline py-3.5">
                  <Text k={`${k}:howWeWork.record.${i}.label`} as="dt" class="t-spaced-sm text-mute" />
                  <Text k={`${k}:howWeWork.record.${i}.value`} as="dd" class="t-heading-sm text-forest" />
                </div>
              ))
            }
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3.5">
              <Text k={`${k}:howWeWork.serviceAreaLabel`} as="dt" class="t-spaced-sm text-mute" />
              <dd>
                <a href={pages.serviceArea} class="link-inline t-body-sm inline-flex min-h-11 items-center">
                  {site.serviceArea.replace(/^the /, "The ")}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  {/* 2. The process. Extra bottom padding: the forest band's treeline stands in it. */}
  <section id="process" class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-16">
      <div class="min-w-0 lg:sticky lg:top-28 lg:self-start">
        <Text k={`${k}:process.eyebrow`} class="t-eyebrow text-forest-mid" />
        <Text k={`${k}:process.title`} type="rich" as="h2" class="t-display-lg mt-4 text-ink" />
        <Text k={`${k}:process.intro`} class="t-body-md mt-5 max-w-md text-body" />
      </div>
      <ol class="step-list min-w-0" {...list(`${k}:process.steps`)}>
        {
          c.process.steps.map((_: unknown, i: number) => (
            <li {...item(i)}>
              <Text k={`${k}:process.steps.${i}.title`} as="h3" class="t-heading-md text-ink" />
              <Text k={`${k}:process.steps.${i}.body`} class="t-body-md text-body" />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* 3. The estimate, on a forest band. */}
  <section id="estimate" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-230} class="absolute inset-x-0 bottom-full" />
    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
        <Text k={`${k}:estimate.title`} as="h2" class="t-display-lg max-w-xl" />
        <Text k={`${k}:estimate.intro`} class="t-lead max-w-xl text-on-forest-mute" />
      </div>
      <ul
        class="check-list mt-12 grid gap-x-16 border-t border-hairline-dark pt-10 md:grid-cols-2 [&>li+li]:mt-0 [&>li]:pb-6"
        {...list(`${k}:estimate.items`)}
      >
        {
          c.estimate.items.map((_: unknown, i: number) => (
            <li {...item(i)}>
              <Text k={`${k}:estimate.items.${i}.title`} class="t-heading-sm" />
              <Text k={`${k}:estimate.items.${i}.body`} class="t-body-sm mt-1.5 text-on-forest-mute" />
            </li>
          ))
        }
      </ul>
      <Text k={`${k}:estimate.note`} class="t-body-sm mt-4 max-w-3xl text-on-forest-mute" />
    </div>
    <Treeline tone="cream" height={64} offset={-415} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 4. On site. */}
  <section id="property" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:property.title`} as="h2" class="t-display-lg text-ink" />
        <Text k={`${k}:property.intro`} class="t-body-md max-w-xl text-body" />
      </div>
      <dl class="grid md:grid-cols-2 md:gap-x-16" {...list(`${k}:property.items`)}>
        {
          c.property.items.map((_: unknown, i: number) => (
            <div
              class="grid gap-2 border-b border-hairline py-7 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-6 md:grid-cols-1 md:gap-2 xl:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] xl:gap-6"
              {...item(i)}
            >
              <Text k={`${k}:property.items.${i}.title`} as="dt" class="t-heading-sm text-forest" />
              <Text k={`${k}:property.items.${i}.body`} as="dd" class="t-body-sm text-body" />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* 5. Licensed, bonded and insured. */}
  <section id="licensed" class="section bg-cream-deep">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
      <div class="min-w-0">
        <Text k={`${k}:licensed.title`} as="h2" class="t-display-lg text-ink" />
        <Text k={`${k}:licensed.body`} type="block" as="div" class="prose-page mt-8" />
      </div>

      <aside class="min-w-0 lg:sticky lg:top-28 lg:self-start" aria-label="Look up our license">
        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <Text k={`${k}:licensed.card.label`} as="span" class="t-spaced" />
          </div>
          <div class="px-6 pt-8 pb-8 sm:px-8">
            <Text k={`${k}:licensed.card.numberLabel`} class="t-spaced-sm text-mute" />
            <p class="t-display-lg mt-2 leading-none text-forest">{site.ccb}</p>
            <Text k={`${k}:licensed.card.coverage`} class="t-spaced-sm mt-6 border-y border-hairline py-3 text-forest" />
            <Text k={`${k}:licensed.card.body`} class="t-body-sm mt-6 text-body" />
            <a href={ccbSearch} target="_blank" rel="noopener" class="btn btn-primary mt-6 w-full">
              <Text k={`${k}:licensed.card.button`} bare />
              <Icon name="arrow" size={18} />
            </a>
            <Text k={`${k}:licensed.card.note`} class="t-caption mt-3 text-mute" />
          </div>
        </div>
      </aside>
    </div>
  </section>

  {/* 6. Oregon roots: the mark, a Washington County house, and the four words on the sign. */}
  <section id="oregon" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:oregon.title`} as="h2" class="t-display-lg text-ink" />
        <Text k={`${k}:oregon.intro`} class="t-body-md max-w-xl text-body" />
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <figure class="photo-plate min-w-0">
          <Img
            k={`${k}:oregon.image`}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] object-[50%_40%] lg:aspect-square"
          />
          <figcaption>
            <Text k={`${k}:oregon.caption`} bare />
            <Fragment set:html={credit(`${k}:oregon.image`)} />
          </figcaption>
        </figure>

        <div class="min-w-0">
          <div class="panel panel-keyline flex items-center justify-center px-8 py-10">
            <img src={asset("/mark.svg")} alt="The Acosta Roofing mark: firs behind a gable roof" width="197" height="90" class="h-auto w-full max-w-[280px]" />
          </div>
          <ul class="mt-8 border-t border-hairline" {...list(`${k}:oregon.claims`)}>
            {
              c.oregon.claims.map((claim: { icon: string }, i: number) => (
                <li class="grid grid-cols-[28px_minmax(0,1fr)] gap-x-4 border-b border-hairline py-5" {...item(i)}>
                  <Icon name={claim.icon} size={26} class="mt-0.5 text-forest" />
                  <div>
                    <Text k={`${k}:oregon.claims.${i}.label`} as="h3" class="t-heading-sm text-ink" />
                    <Text k={`${k}:oregon.claims.${i}.body`} class="t-body-sm mt-1.5 text-body" />
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ClosingCta k={`${k}:closingCta`} surface="cream-deep" />
</Page>
