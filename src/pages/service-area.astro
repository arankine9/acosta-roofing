---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import ServiceArea from "../components/ServiceArea.astro";
import Treeline from "../components/Treeline.astro";
import { site, counties } from "../data/site";
import { serviceMap } from "../data/service-map";
import { pages, estimateHref } from "../data/nav";

// The service-area page: the home page's drive-time map and county list
// (ServiceArea.astro, rendered as is), then how the line is drawn and why it
// stops at the state line, a county-by-county directory with an A-Z town
// index, what the weather does to roofs across the area, and what to do if
// you're just past the line.
//
// Every fact about the area comes from src/data/site.ts (counties, towns,
// notes, CCB number) and src/data/service-map.ts (drive minutes, shop,
// area). The county descriptions below are general geography only; keep
// them in step if the county list changes.
//
// Photos (public/images/service-area/), all Pexels License:
//   portland-street.jpg        Brett Sayles, "Multi Colored Suburb Family Houses", Portland
//                              https://www.pexels.com/photo/multi-colored-suburb-family-houses-17205886/
//   columbia-gorge.jpg         Michael McGarry, "River in Mountains Landscape" (Columbia River Gorge)
//                              https://www.pexels.com/photo/river-in-mountains-landscape-15283542/
//   molalla-pasture.jpg        Michael McGarry, "Livestock and Trees", Molalla
//                              https://www.pexels.com/photo/livestock-and-trees-15606706/
//   mount-hood-from-sandy.jpg  Soly Moses, "Scenic View of Mount Hood in Autumn Forest", Sandy
//                              https://www.pexels.com/photo/scenic-view-of-mount-hood-in-autumn-forest-29883927/
import { asset } from "../lib/url";

const crumbs = [{ label: "Service area", href: pages.serviceArea }];
const { drive, base } = serviceMap;

const slug = (name: string) => `county-${name.toLowerCase().replace(/[^a-z]+/g, "-")}`;

// One line of plain geography per county, north to south as in site.ts.
const about: Record<string, string> = {
  Columbia:
    "River towns on the Columbia along US-30, from Scappoose and St. Helens down to Rainier, and Vernonia up in the timber of the Nehalem valley.",
  Washington:
    "The shop's county. Beaverton, Hillsboro, Tigard and the Tualatin Valley, out to Forest Grove, Banks and Gaston at the foot of the Coast Range.",
  Multnomah:
    "Portland and the east county: Gresham and Troutdale, and Corbett up on the rim at the west end of the Gorge.",
  "Hood River": "The Oregon side of the Gorge: Cascade Locks, and Hood River at the far end of the drive.",
  Yamhill:
    "Newberg and Dundee on 99W, McMinnville and Carlton in wine country, and Sheridan and Willamina toward the Coast Range.",
  Clackamas:
    "Lake Oswego and West Linn down to Oregon City, Wilsonville, Canby and Molalla, then east through Sandy and Estacada to Welches on the way to the mountain.",
  Polk: "Across the Willamette from Salem: Dallas, Monmouth and Independence.",
  Marion:
    "Salem, Keizer and Woodburn on the I-5 corridor, and Silverton, Mt. Angel, Stayton and Aumsville toward the Cascade foothills.",
  Linn: "The south edge of the line, down I-5: Albany and Jefferson.",
};

const directory = counties.map((county) => ({
  ...county,
  id: slug(county.name),
  townList: county.towns.split(", "),
  about: about[county.name] ?? "",
}));

const towns = directory
  .flatMap((county) => county.townList.map((town) => ({ town, county: county.name, id: county.id })))
  .sort((a, b) => a.town.localeCompare(b.town));

// General weather by terrain, not by town: what each part of the area does
// to a roof, and what that means for the work.
const zones = [
  {
    title: "The valley floor",
    where: "Portland, Beaverton, Hillsboro, Tigard, Newberg, McMinnville, Woodburn, Salem, Albany",
    body: "Long wet seasons rather than big storms: most of the year's rain falls between October and May, in gray weeks that never quite dry out. Roofs under firs and oaks, and north-facing slopes, stay damp all winter, and that's where moss takes hold. Summers are dry and can be hot, which ages shingles from the other side.",
    watch: ["Moss on shaded and north-facing slopes", "Needles and leaves in valleys and gutters", "Sun-baked south slopes aging first"],
  },
  {
    title: "Coast Range foothills",
    where: "Forest Grove, Banks, Gaston, Vernonia, Sheridan, Willamina, Dallas",
    body: "More rain than the valley floor and heavier timber close to the house. Roofs sit in shade longer, collect more needles and stay wet longer after each storm, so moss grows faster. Southwest winter storms reach these towns first.",
    watch: ["Faster moss growth", "Debris loads in valleys", "Wind-driven rain at rakes and edges"],
  },
  {
    title: "The Gorge and the east winds",
    where: "Troutdale, Corbett, Cascade Locks, Hood River",
    body: "Wind is the story. In winter, cold east wind pours out of the Gorge and hits Troutdale and Corbett hardest. When that cold air sits under a Pacific storm, rain freezes as it lands, and ice storms can reach well into Portland. Nailing, sealing and ridge caps matter more here than anywhere else in the area.",
    watch: ["Lifted and torn tabs", "Blown-off ridge caps", "Ice on roofs and gutters"],
  },
  {
    title: "Cascade foothills",
    where: "Sandy, Estacada, Welches, Molalla, Silverton",
    body: "Higher ground, more rain and more snow, especially as you climb toward the mountain. Snow sits on roofs longer, ice dams are possible at the eaves, and dense fir means needles in every valley and gutter. Ice-and-water shield at the eaves earns its keep up here.",
    watch: ["Snow and ice at the eaves", "Heavy needle fall", "Long wet stretches in shade"],
  },
];
---

<Page
  title="Service Area"
  description={`Acosta Roofing works anywhere in Oregon within about ${drive.minutes} minutes' drive of our ${base.name} shop: the Portland metro, the north Willamette Valley, and out toward the Coast Range, the Gorge and the Cascade foothills.`}
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Service area"
    title="Roofing across northwest Oregon"
    lead={`Our line is a drive time, not a radius: anywhere in Oregon about ${drive.minutes} minutes from the ${base.name} shop. That takes in the Portland metro, the north Willamette Valley and the foothills on either side, out to the Gorge.`}
    image="/images/service-area/portland-street.jpg"
    imageAlt="A row of older wood-sided houses with steep, dark shingle roofs on a Portland street"
    imageCaption="Older Portland houses on a winter afternoon: steep gables, shingle roofs, trees close by."
    treelineOffset={-560}
  />

  {/* 1. The map and the county list, exactly as on the home page. */}
  <ServiceArea />

  {/* 2. How the line is drawn: prose left, a fact plate on a sticky rail. */}
  <section class="section bg-cream-deep">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
      <div class="min-w-0">
        <h2 class="t-display-lg text-ink">How the line is drawn</h2>
        <div class="prose-page mt-6">
          <p class="t-lead text-body">
            The shaded area on the map isn't a circle with a compass point in Beaverton. It's
            everywhere you can drive to from the shop in about {drive.minutes} minutes, measured over
            real roads without rush-hour traffic.
          </p>
          <p>
            That's why the shape looks the way it does. It runs a long way down I-5 toward Salem and
            Albany, and up US-26 to Sandy and Welches, because those roads are fast. It stops well
            short of the coast, where the roads over the Coast Range are slow, even though the
            distance on a map is similar.
          </p>
          <h3>Why drive time</h3>
          <p>
            A roof is rarely one visit. There's the estimate, the job, sometimes a return trip for a
            flashing detail or a gutter adjustment, and a look after the first big storm. Keeping the
            work within a reasonable drive means more of each day goes into your roof and less into
            the truck, and it means we can come back without it being an expedition.
          </p>
          <h3>Why it stops at the Columbia</h3>
          <p>
            We're licensed with Oregon's Construction Contractors Board, CCB #{site.ccb}. A CCB
            license covers work in Oregon. Washington licenses contractors separately, so the line
            follows the state line and the river, not the drive time.
          </p>
          <p>
            You can look up any Oregon contractor's license, bond and insurance on the CCB's website.
            It's worth doing for anyone you hire.
          </p>
        </div>
      </div>

      <aside class="min-w-0">
        <div class="panel panel-keyline overflow-hidden lg:sticky lg:top-28">
          <div class="plate-label">
            <span class="t-spaced-sm">The line at a glance</span>
          </div>
          <dl class="glance px-6 py-3">
            <div>
              <dt>Shop</dt>
              <dd>{base.name}, OR</dd>
            </div>
            <div>
              <dt>Reach</dt>
              <dd>About {drive.minutes} minutes' drive</dd>
            </div>
            <div>
              <dt>Area</dt>
              <dd>About {(Math.round(drive.areaSqMi / 100) * 100).toLocaleString("en-US")} sq mi</dd>
            </div>
            <div>
              <dt>Counties</dt>
              <dd>{counties.length}, most in part</dd>
            </div>
            <div>
              <dt>State</dt>
              <dd>Oregon only</dd>
            </div>
            <div>
              <dt>License</dt>
              <dd>Oregon CCB #{site.ccb}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  {/* 3. County directory: a ruled reference, then an A-Z town index.
      Extra bottom padding: the forest band's treeline stands up into it. */}
  <section class="section bg-canvas pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <h2 class="t-display-lg text-ink">County by county</h2>
        <p class="t-lead max-w-2xl text-body">
          North to south, with the towns inside the line. Most counties are only partly in reach;
          the towns listed are the ones that are.
        </p>
      </div>

      <ol class="county-dir mt-12">
        {
          directory.map((county, index) => (
            <li id={county.id}>
              <div class="county-dir__name">
                <span class="county-dir__num" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="t-heading-md text-ink">{county.name} County</h3>
                  <span class="badge-tag mt-2">{county.note}</span>
                </div>
              </div>
              <p class="county-dir__towns">
                {county.townList.map((town, i) => (
                  <>
                    <span class="whitespace-nowrap">{town}</span>
                    {i < county.townList.length - 1 && <span class="text-mute" aria-hidden="true"> · </span>}
                  </>
                ))}
              </p>
              <p class="t-body-sm text-body">{county.about}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-16">
        <h3 class="ruled-label t-spaced text-forest">Towns, A to Z</h3>
        <ul class="town-index mt-8">
          {
            towns.map((entry) => (
              <li>
                <a href={`#${entry.id}`} class="group flex items-baseline justify-between gap-3">
                  <span class="t-body-md text-ink group-hover:text-forest group-hover:underline">{entry.town}</span>
                  <span class="t-caption shrink-0 text-mute">{entry.county}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* 4. Weather across the area, on a forest band. */}
  <section class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-140} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
        <h2 class="t-display-lg">What the weather does to roofs here</h2>
        <p class="t-lead text-on-forest-mute">
          One service area, four kinds of weather. It's all the Northwest, but a roof in Welches
          lives a different life from one in Tigard. In general terms, this is what each part of the
          area throws at a roof.
        </p>
      </div>

      <div class="zones mt-14">
        {
          zones.map((zone) => (
            <article>
              <h3 class="t-heading-xl">{zone.title}</h3>
              <p class="t-caption mt-2 text-on-forest-mute">{zone.where}</p>
              <p class="t-body-md mt-4 text-on-forest-mute">{zone.body}</p>
              <p class="t-spaced-sm mt-6 text-on-forest">What we look for</p>
              <ul class="check-list t-body-sm mt-3 text-on-forest-mute">
                {zone.watch.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        <figure class="photo-plate">
          <img
            src={asset("/images/service-area/columbia-gorge.jpg")}
            alt="The Columbia River Gorge under low cloud, with Vista House on Crown Point above the river"
            class="aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
          <figcaption>The west end of the Gorge, Crown Point on the right. In winter, the east wind comes down this corridor.</figcaption>
        </figure>
        <figure class="photo-plate">
          <img
            src={asset("/images/service-area/molalla-pasture.jpg")}
            alt="Cattle grazing in a green pasture near Molalla with bare trees and forested hills behind"
            class="aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Pasture near Molalla, where the valley floor starts to climb toward the Cascades.</figcaption>
        </figure>
        <figure class="photo-plate">
          <img
            src={asset("/images/service-area/mount-hood-from-sandy.jpg")}
            alt="Mount Hood above autumn forest outside Sandy, Oregon"
            class="aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Mount Hood from Sandy. The closer the mountain, the more snow and ice a roof sees.</figcaption>
        </figure>
      </div>
    </div>

    <Treeline tone="cream" height={64} offset={-430} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 5. Just outside the line. */}
  <section class="section bg-canvas">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start lg:gap-16">
      <div>
        <h2 class="t-display-lg text-balance text-ink">Just past the line? Call anyway</h2>
        <div class="prose-page mt-6">
          <p class="t-lead text-body">
            The line on the map is a guide, not a wall. If you're a few minutes outside it, in
            Oregon, call us. Depending on the job, we may still be able to schedule it.
          </p>
          <p>
            What decides it is mostly the size of the work and the time of year. A full replacement
            or a commercial roof is worth a longer drive; a small repair far outside the line may not
            be, and if it isn't, we'll say so and point you toward finding someone closer.
          </p>
        </div>
      </div>

      <div class="panel panel-keyline overflow-hidden">
        <div class="plate-label">
          <span class="t-spaced-sm">When you call</span>
        </div>
        <div class="px-6 py-7 sm:px-8">
          <p class="t-body-sm text-body">These help us give you a straight answer on the first call:</p>
          <ul class="check-list t-body-sm mt-4 text-body">
            <li>The town, or the nearest cross streets</li>
            <li>What kind of work: repair, replacement, gutters, maintenance</li>
            <li>A rough size, like a single-story house or a two-story with a garage</li>
            <li>Photos, if you can take them safely from the ground</li>
          </ul>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a href={site.phoneHref} class="btn btn-primary">Call {site.phone}</a>
            <a href={estimateHref} class="btn btn-outline">Send a request</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ClosingCta
    title="Inside the line?"
    body={`If you're within about ${drive.minutes} minutes of ${base.name}, the estimate is free and it's written down. Tell us what you're seeing and we'll come look.`}
  />
</Page>

<style>
  /* Fact plate on the rail. */
  .glance > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .glance > div:last-child {
    border-bottom: 0;
  }
  .glance dt {
    flex: none;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-mute);
  }
  .glance dd {
    margin: 0;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
  }

  /* County directory: one ruled row per county. Name and note, the towns
     set as a readable line, and a sentence of geography. Three columns on
     desktop, stacked on a phone. */
  .county-dir {
    border-top: 1px solid var(--color-hairline-strong);
  }
  .county-dir > li {
    display: grid;
    gap: 12px;
    padding-block: 24px;
    border-bottom: 1px solid var(--color-hairline);
  }
  @media (min-width: 900px) {
    .county-dir > li {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 5fr);
      gap: 32px;
      align-items: start;
    }
  }
  .county-dir__name {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .county-dir__num {
    flex: none;
    width: 34px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.18;
    color: var(--color-forest-mid);
  }
  .county-dir__towns {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-ink);
  }
  @media (max-width: 899.98px) {
    .county-dir__towns,
    .county-dir > li > p:last-child {
      padding-left: 50px;
    }
  }
  .county-dir > li:target {
    background-color: var(--color-cream-deep);
    outline: 12px solid var(--color-cream-deep);
  }

  /* A-Z index: ruled columns, town left and county right. */
  .town-index {
    columns: 1;
    column-gap: 40px;
  }
  @media (min-width: 560px) {
    .town-index {
      columns: 2;
    }
  }
  @media (min-width: 900px) {
    .town-index {
      columns: 3;
    }
  }
  @media (min-width: 1200px) {
    .town-index {
      columns: 4;
    }
  }
  .town-index > li {
    break-inside: avoid;
    border-bottom: 1px solid var(--color-hairline);
  }
  .town-index a {
    min-height: 44px;
    align-items: center;
  }

  /* Weather zones: a 2 x 2 of ruled cells on the band. */
  .zones {
    display: grid;
    border-top: 1px solid var(--color-hairline-dark);
  }
  .zones > article {
    padding-block: 32px;
    border-bottom: 1px solid var(--color-hairline-dark);
  }
  @media (min-width: 900px) {
    .zones {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .zones > article:nth-child(odd) {
      padding-right: 40px;
      border-right: 1px solid var(--color-hairline-dark);
    }
    .zones > article:nth-child(even) {
      padding-left: 40px;
    }
  }
</style>
