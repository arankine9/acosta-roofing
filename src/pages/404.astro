---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Text from "../components/Text.astro";
import { site } from "../data/site";
import { pages } from "../data/nav";
import { home, page } from "../lib/url";

// Not found. Kept small: one line of humor in the headline, then the four
// places most people were trying to get to. The breadcrumb is passed to the
// hero only, so no BreadcrumbList is published for a page that doesn't exist.
const crumbs = [{ label: "Page not found", href: page("/404/") }];

const k = "pages/404";

// Fixed destinations: each one's label and note are in content under its id.
const links = [
  { id: "home", href: home },
  { id: "services", href: pages.services },
  { id: "contact", href: pages.contact },
  { id: "phone", href: site.phoneHref },
];
---

<Page k={k} noindex>
  <PageHero k={`${k}:hero`} crumbs={crumbs} actions={false} treelineOffset={-40} />

  <section class="section bg-canvas pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <Text k={`${k}:links.title`} as="h2" class="t-heading-xl text-ink" />
      <ul class="mt-8 max-w-3xl border-t border-hairline">
        {
          links.map((link) => (
            <li class="border-b border-hairline">
              <a href={link.href} class="group flex min-h-16 items-center gap-6 py-4">
                <Text k={`${k}:links.${link.id}.label`} as="span" class="t-heading-md w-44 shrink-0 text-ink group-hover:text-forest max-[480px]:w-auto" />
                <Text k={`${k}:links.${link.id}.note`} as="span" class="t-body-sm flex-1 text-body max-[480px]:hidden" />
                <Icon name="arrow" size={20} class="ml-auto shrink-0 text-forest transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Page>
