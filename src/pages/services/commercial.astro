---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Treeline from "../../components/Treeline.astro";
import Icon from "../../components/Icon.astro";
import Text from "../../components/Text.astro";
import Img from "../../components/Img.astro";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";
import { site, counties } from "../../data/site";
import { file, list, item } from "../../lib/cms";

// Commercial roofing: single-ply membrane and low-slope roofs for shops,
// warehouses, offices and light-industrial buildings. Written for property
// managers, owners and facilities people. The footer links to #single-ply and
// #low-slope, so those two ids must stay.
//
// Photos (all Unsplash License: free for commercial use, no attribution
// required; credited here for the record):
// - commercial/white-membrane-rooftop-units.jpg: Toni Reed,
//   https://unsplash.com/photos/Ba_o2rvI5aY
// - commercial/light-industrial-low-slope.jpg: Alex Reynolds,
//   https://unsplash.com/photos/rHvi-_-0jUU (cropped)
// - commercial/rooftop-unit-parapet-drain.jpg: Linus Belanger,
//   https://unsplash.com/photos/vvDUCfhiDpE (cropped, saturation reduced)
//
// The low-slope cross-section is drawn inline below, in the house style.

const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Commercial roofing", href: serviceHref("commercial") },
];

const schema = {
  "@type": "Service",
  name: "Commercial roofing",
  serviceType: "Commercial low-slope and single-ply membrane roofing",
  description:
    "TPO and PVC single-ply membrane and low-slope roofing for shops, warehouses, offices and light-industrial buildings: replacement, repair, condition reports and maintenance.",
  url: new URL(serviceHref("commercial"), Astro.site).toString(),
  provider: {
    "@type": "RoofingContractor",
    name: site.legalName,
    telephone: site.phone,
    url: `https://${site.domain}`,
  },
  areaServed: counties.map((county) => `${county.name} County, OR`),
};

// Every word on this page is in src/content/pages/services-commercial.json;
// `k` is the key prefix into it and `c` its parsed content, for the lists.
const k = "pages/services-commercial";
const c = file(k);

// Chapter 3: the cross-section's keyed notes, in content order, carry these
// letters, which must match the markers in the drawing. A fixed set, so the
// notes are not an editable list.
const drainageKeys = ["A", "B", "C", "D", "E"];
---

<Page k={k} crumbs={crumbs} schema={schema}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-500} />

  {/* 1. The buildings. */}
  <section id="buildings" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-start lg:gap-16">
        <div>
          <Text k={`${k}:buildings.eyebrow`} class="t-eyebrow text-forest" />
          <Text k={`${k}:buildings.title`} as="h2" class="t-display-lg text-balance mt-4 text-ink" />
          <Text k={`${k}:buildings.body`} type="block" as="div" class="prose-page mt-6" />

          <dl class="mt-10 border-t border-hairline" {...list(`${k}:buildings.workTypes`)}>
            {
              c.buildings.workTypes.map((_: unknown, i: number) => (
                <div class="grid gap-2 border-b border-hairline py-5 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-6" {...item(i)}>
                  <Text k={`${k}:buildings.workTypes.${i}.title`} as="dt" class="t-heading-sm text-ink" />
                  <Text k={`${k}:buildings.workTypes.${i}.body`} as="dd" class="t-body-sm text-body" />
                </div>
              ))
            }
          </dl>
        </div>

        <figure class="photo-plate lg:mt-2">
          <Img k={`${k}:buildings.image`} loading="lazy" decoding="async" class="aspect-[4/3]" />
          <Text k={`${k}:buildings.caption`} as="figcaption" />
        </figure>
      </div>
    </div>
  </section>

  {/* 2. Single-ply. Extra bottom padding: the low-slope band's treeline
      stands 64px up into this section. */}
  <section id="single-ply" class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div class="min-w-0">
          <Text k={`${k}:singlePly.eyebrow`} class="t-eyebrow text-forest" />
          <Text k={`${k}:singlePly.title`} as="h2" class="t-display-lg text-balance mt-4 text-ink" />
          <Text k={`${k}:singlePly.body`} type="block" as="div" class="prose-page mt-6" />
        </div>

        {/* The rail: how the sheet is held down. */}
        <aside class="lg:pt-16">
          <div class="panel panel-keyline lg:sticky lg:top-28">
            <div class="plate-label">
              <Text k={`${k}:singlePly.attachment.label`} as="span" class="t-spaced" />
            </div>
            <div class="px-6 py-7 sm:px-8">
              {
                c.singlePly.attachment.items.map((_: unknown, index: number) => (
                  <div class:list={[index > 0 && "mt-6 border-t border-hairline pt-6"]}>
                    <Text k={`${k}:singlePly.attachment.items.${index}.title`} as="h3" class="t-heading-md text-ink" />
                    <Text k={`${k}:singlePly.attachment.items.${index}.body`} class="t-body-sm mt-2 text-body" />
                  </div>
                ))
              }
              <Text k={`${k}:singlePly.attachment.note`} class="t-caption mt-6 border-t border-hairline pt-5 text-mute" />
            </div>
          </div>
        </aside>
      </div>

      {/* Reference table: single-ply against the other low-slope systems. */}
      <div class="mt-16 lg:mt-20">
        <div class="grid gap-4 border-b border-hairline pb-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
          <Text k={`${k}:singlePly.compare.title`} as="h3" class="t-heading-xl text-balance text-ink" />
          <Text k={`${k}:singlePly.compare.intro`} class="t-body-md max-w-2xl text-body" />
        </div>
        <div class="table-scroll mt-8" tabindex="0" role="region" aria-label="Low-slope roofing systems compared in general terms">
          <table class="data-table min-w-[720px]">
            <caption class="sr-only">Low-slope roofing systems compared in general terms</caption>
            <thead>
              <tr>
                <Text k={`${k}:singlePly.compare.columns.name`} as="th" scope="col" class="w-[18%]" />
                <Text k={`${k}:singlePly.compare.columns.what`} as="th" scope="col" class="w-[28%]" />
                <Text k={`${k}:singlePly.compare.columns.seams`} as="th" scope="col" class="w-[18%]" />
                <Text k={`${k}:singlePly.compare.columns.note`} as="th" scope="col" />
              </tr>
            </thead>
            <tbody {...list(`${k}:singlePly.compare.systems`)}>
              {
                c.singlePly.compare.systems.map((_: unknown, i: number) => (
                  <tr {...item(i)}>
                    <Text k={`${k}:singlePly.compare.systems.${i}.name`} as="th" scope="row" />
                    <Text k={`${k}:singlePly.compare.systems.${i}.what`} as="td" />
                    <Text k={`${k}:singlePly.compare.systems.${i}.seams`} as="td" />
                    <Text k={`${k}:singlePly.compare.systems.${i}.note`} as="td" />
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  {/* 3. Low-slope drainage, on a forest band with a cross-section. */}
  <section id="low-slope" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-262} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
        <div>
          <Text k={`${k}:lowSlope.eyebrow`} class="t-eyebrow text-on-forest-mute" />
          <Text k={`${k}:lowSlope.title`} as="h2" class="t-display-lg text-balance mt-4 max-w-xl" />
        </div>
        <Text k={`${k}:lowSlope.intro`} class="t-lead max-w-xl text-on-forest-mute" />
      </div>

      <figure class="mt-12 border-y border-hairline-dark py-8">
        <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Cross-section of a low-slope roof">
          <svg
            viewBox="0 0 800 300"
            class="h-auto w-full min-w-[520px]"
            role="img"
            aria-labelledby="section-title section-desc"
          >
            <title id="section-title">Cross-section of a low-slope roof</title>
            <desc id="section-desc">
              A roof deck between two parapet walls. Tapered insulation slopes the membrane down to a drain. An
              overflow scupper passes through the left parapet above the roof surface. A rooftop unit sits on a
              curb with a cricket on its uphill side. Metal coping caps both parapets.
            </desc>
            <defs>
              <pattern id="deck-flutes" width="16" height="12" patternUnits="userSpaceOnUse">
                <path d="M0 0h8v12h8" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1" />
              </pattern>
              <pattern id="insul-hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <path d="M0 0v10" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" />
              </pattern>
            </defs>

            <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter">
              {/* Steel deck */}
              <rect x="30" y="236" width="740" height="12" fill="url(#deck-flutes)" />
              {/* Flat base insulation */}
              <rect x="60" y="222" width="680" height="14" fill="url(#insul-hatch)" stroke-opacity="0.6" />
              {/* Tapered insulation: sloping top down to the drain */}
              <path d="M60 222 V182 L340 214 L740 178 V222 Z" fill="url(#insul-hatch)" stroke-opacity="0.6" />

              {/* Parapets, with the scupper opening through the left one */}
              <path d="M30 236 V172 H60 V236" />
              <path d="M30 160 V94 H60 V160" />
              <path d="M740 236 V94 H770 V236" />
              {/* Scupper box and spout */}
              <path d="M30 160 H8 V172 H30" stroke-width="1.6" />
              {/* Coping caps */}
              <path d="M22 102 V88 H68 V102" stroke-width="2" />
              <path d="M732 102 V88 H778 V102" stroke-width="2" />

              {/* Membrane: up the walls, down the taper to the drain */}
              <path d="M60 108 V182 L340 214 L740 178 V108" stroke-width="3" />
              {/* Termination bars */}
              <path d="M56 110 h8 M736 110 h8" stroke-width="3" />

              {/* Drain: dome, bowl and leader through the deck */}
              <path d="M326 214 Q340 198 354 214" stroke-width="1.6" />
              <path d="M332 214 V292 M348 214 V292" stroke-width="1.6" />

              {/* Curb, unit and cricket */}
              <path d="M560 194.2 V160 H620 V188.8" stroke-width="1.6" />
              <rect x="548" y="104" width="84" height="56" stroke-width="1.6" />
              <path d="M560 118 H620 M560 128 H620 M560 138 H620" stroke-opacity="0.5" />
              <path d="M620 188.8 V174 L668 184.5" stroke-width="1.6" />
            </g>

            {/* Flow arrows along the surface, toward the drain */}
            <g fill="currentColor" fill-opacity="0.7">
              <path d="M170 190 l-12 -5 l2 5 l-2 4 z" transform="rotate(6.5 164 190)" />
              <path d="M250 199 l-12 -5 l2 5 l-2 4 z" transform="rotate(6.5 244 199)" />
              <path d="M446 199 l12 -4 l-2 5 l2 4 z" transform="rotate(-5 452 199)" />
              <path d="M700 175 l12 -4 l-2 5 l2 4 z" transform="rotate(-5 706 175)" />
            </g>

            {/* Keyed markers with dashed leaders */}
            <g stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" stroke-opacity="0.6">
              <path d="M24 56 V158" />
              <path d="M180 56 V194" />
              <path d="M340 56 V200" />
              <path d="M644 56 V176" />
              <path d="M755 56 V86" />
            </g>
            <g class="diagram-key">
              {
                [
                  { x: 24, k: "C" },
                  { x: 180, k: "A" },
                  { x: 340, k: "B" },
                  { x: 644, k: "D" },
                  { x: 755, k: "E" },
                ].map((m) => (
                  <g>
                    <rect x={m.x - 16} y="24" width="32" height="32" fill="var(--color-forest)" stroke="currentColor" stroke-width="1.2" />
                    <text x={m.x} y="46" text-anchor="middle" fill="currentColor">{m.k}</text>
                  </g>
                ))
              }
            </g>
          </svg>
        </div>
        <figcaption class="t-caption mt-6 text-on-forest-mute">
          <span class="sm:hidden"><Text k={`${k}:lowSlope.swipeHint`} bare /> </span><Text k={`${k}:lowSlope.caption`} bare />
        </figcaption>
      </figure>

      <ol class="mt-4 grid md:grid-cols-2 lg:grid-cols-3">
        {
          drainageKeys.map((key, i) => (
            <li class="border-b border-hairline-dark py-7 md:pr-8">
              <h3 class="t-heading-md flex items-baseline gap-3">
                <span class="inline-flex size-8 shrink-0 items-center justify-center border border-hairline-dark t-heading-sm" aria-hidden="true">
                  {key}
                </span>
                <Text k={`${k}:lowSlope.keys.${i}.title`} as="span" />
              </h3>
              <Text k={`${k}:lowSlope.keys.${i}.body`} class="t-body-sm mt-3 text-on-forest-mute" />
            </li>
          ))
        }
        <li class="border-b border-hairline-dark py-7 md:pr-8">
          <Text k={`${k}:lowSlope.details.title`} as="h3" class="t-heading-md" />
          <Text k={`${k}:lowSlope.details.body`} class="t-body-sm mt-3 text-on-forest-mute" />
        </li>
      </ol>
    </div>

    <Treeline tone="cream" height={64} offset={-388} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 4. The details. */}
  <section id="details" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div>
          <Text k={`${k}:details.eyebrow`} class="t-eyebrow text-forest" />
          <Text k={`${k}:details.title`} as="h2" class="t-display-lg text-balance mt-4 text-ink" />
          <Text k={`${k}:details.intro`} class="t-lead mt-5 text-body" />
          <figure class="photo-plate mt-10 lg:sticky lg:top-28">
            <Img k={`${k}:details.image`} loading="lazy" decoding="async" class="aspect-[4/5] max-lg:aspect-[4/3]" />
            <Text k={`${k}:details.caption`} as="figcaption" />
          </figure>
        </div>

        <dl class="border-t border-hairline lg:mt-2" {...list(`${k}:details.items`)}>
          {
            c.details.items.map((_: unknown, i: number) => (
              <div class="border-b border-hairline py-7" {...item(i)}>
                <Text k={`${k}:details.items.${i}.title`} as="dt" class="t-heading-md text-ink" />
                <Text k={`${k}:details.items.${i}.body`} as="dd" class="t-body-md mt-2 text-body" />
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* 5. Working around a running business. Extra bottom padding for the
      forest band's treeline. */}
  <section id="occupied" class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:occupied.title`} as="h2" class="t-display-lg text-balance text-ink" />
        <Text k={`${k}:occupied.intro`} class="t-body-md max-w-2xl text-body" />
      </div>

      <ol class="step-list border-t-0 [&>li]:content-start md:grid md:grid-cols-2 md:gap-x-12 lg:gap-x-16" {...list(`${k}:occupied.steps`)}>
        {
          c.occupied.steps.map((_: unknown, i: number) => (
            <li {...item(i)}>
              <Text k={`${k}:occupied.steps.${i}.title`} as="h3" class="t-heading-md text-ink" />
              <Text k={`${k}:occupied.steps.${i}.body`} class="t-body-sm text-body" />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* 6. Assessments and maintenance, on a forest band. */}
  <section id="maintenance" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-141} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="max-w-3xl">
        <Text k={`${k}:maintenance.eyebrow`} class="t-eyebrow text-on-forest-mute" />
        <Text k={`${k}:maintenance.title`} as="h2" class="t-display-lg text-balance mt-4" />
        <Text k={`${k}:maintenance.intro`} class="t-lead mt-5 text-on-forest-mute" />
      </div>

      <div class="mt-12 grid gap-12 border-t border-hairline-dark pt-10 md:grid-cols-2 md:gap-16">
        {
          ["report", "visit"].map((part) => (
            <div>
              <Text k={`${k}:maintenance.${part}.title`} as="h3" class="t-heading-md" />
              <ul class="check-list t-body-sm mt-6 text-on-forest-mute" {...list(`${k}:maintenance.${part}.items`)}>
                {c.maintenance[part].items.map((_: unknown, i: number) => (
                  <Text k={`${k}:maintenance.${part}.items.${i}`} as="li" {...item(i)} />
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-12 grid gap-6 border-t border-hairline-dark pt-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-16">
        <Text k={`${k}:maintenance.timing`} type="rich" class="t-body-md text-on-forest-mute" />
        <Text k={`${k}:maintenance.storms`} type="rich" class="t-body-md text-on-forest-mute" />
      </div>
    </div>

    <Treeline tone="cream" height={64} offset={-47} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 7. What we need to quote. */}
  <section id="quote" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
        <div>
          <Text k={`${k}:quote.title`} as="h2" class="t-display-lg text-balance text-ink" />
          <Text k={`${k}:quote.intro`} class="t-body-md mt-5 max-w-md text-body" />
          <a href={pages.contact} class="btn btn-primary mt-8">
            <Text k={`${k}:quote.button`} bare />
            <Icon name="arrow" size={18} />
          </a>
        </div>

        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <Text k={`${k}:quote.label`} as="span" class="t-spaced" />
          </div>
          <ol class="grid px-6 py-4 sm:grid-cols-2 sm:gap-x-10 sm:px-10 sm:py-6" {...list(`${k}:quote.items`)}>
            {
              c.quote.items.map((_: unknown, index: number) => (
                <li class="border-b border-hairline py-5" {...item(index)}>
                  <p class="t-spaced-sm text-forest-mid">{String(index + 1).padStart(2, "0")}</p>
                  <Text k={`${k}:quote.items.${index}.title`} as="h3" class="t-heading-sm mt-2 text-ink" />
                  <Text k={`${k}:quote.items.${index}.body`} class="t-body-sm mt-1.5 text-body" />
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <RelatedServices slugs={["multi-unit", "roof-maintenance", "gutters"]} k={`${k}:related`} surface="cream-deep" />

  <ClosingCta k={`${k}:closingCta`} surface="canvas" />
</Page>

<style>
  .diagram-key text {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
</style>
