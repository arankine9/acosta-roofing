---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import Treeline from "../../components/Treeline.astro";
import Icon from "../../components/Icon.astro";
import Text from "../../components/Text.astro";
import Img from "../../components/Img.astro";
import { site } from "../../data/site";
import { pages } from "../../data/nav";
import { serviceHref, serviceKey, servicesByGroup } from "../../data/services";
import { file, list, item, credit } from "../../lib/cms";

// Residential hub: where the home page's "Residential" tile lands. It
// orients a homeowner rather than repeating /services/: the four kinds of
// work on a house, an honest repair-or-replace guide (a reference table),
// what the local climate does to a roof (forest band), and how the free
// estimate works.
//
// Photos (public/images/residential/):
// - portland-bungalow-winter.jpg: Ian Poellet, "2442 NE 8 - Irvington HD -
//   Portland Oregon", Wikimedia Commons,
//   https://commons.wikimedia.org/wiki/File:2442_NE_8_-_Irvington_HD_-_Portland_Oregon.jpg
//   (CC BY-SA 4.0; credited in the hero caption).
// - bungalow-under-trees.jpg: Ian Poellet, "3343 NE 11 - Irvington HD -
//   Portland Oregon", Wikimedia Commons,
//   https://commons.wikimedia.org/wiki/File:3343_NE_11_-_Irvington_HD_-_Portland_Oregon.jpg
//   (CC BY-SA 4.0; credited in its caption).
// - worn-out-shingles.jpg: Dale Mahalko (DMahalko), "Failure of asphalt
//   shingles allowing roof leakage", Wikimedia Commons,
//   https://commons.wikimedia.org/wiki/File:Failure_of_asphalt_shingles_allowing_roof_leakage.JPG
//   (CC BY-SA 3.0; credited in its caption).
//
// Service lives are the same industry ranges as the home page's Materials
// band (architectural 25–30 years, designer 30 and up): guidance, not a warranty.

const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
];

// Every word on this page is in src/content/pages/services-residential.json;
// `k` is the key prefix into it and `c` its parsed content, for the lists.
// The four services' titles and summaries come from the registry so they
// stay in step with the nav; "usually when" is keyed by slug.
const k = "pages/services-residential";
const c = file(k);
const residential = servicesByGroup("residential");

type Verdict = "repair" | "maintenance" | "depends" | "replace";
const verdictStyle: Record<Verdict, string> = {
  repair: "border-hairline-strong text-forest",
  maintenance: "border-hairline-strong text-forest",
  depends: "border-hairline-strong text-ink",
  replace: "border-forest bg-forest text-cream",
};
const rows: { verdict: Verdict; note?: string }[] = c.decide.rows;
---


<Page k={k} crumbs={crumbs}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-260} />

  {/* Chapter 1: the four kinds of work, as ruled rows beside a sticky heading. */}
  <section class="section bg-canvas" aria-labelledby="work-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <div class="lg:sticky lg:top-28">
          <Text k={`${k}:work.title`} as="h2" id="work-heading" class="t-display-lg text-ink" />
          <Text k={`${k}:work.intro`} class="t-body-md mt-5 max-w-md text-body" />
          <a href={pages.services} class="t-spaced-sm mt-6 inline-flex min-h-12 items-center gap-2 text-forest hover:text-forest-deep">
            <Text k={`${k}:work.allServices`} bare />
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>

      <ol class="border-t border-hairline">
        {
          residential.map((service, index) => (
            <li class="border-b border-hairline">
              <a
                href={serviceHref(service.slug)}
                class="group grid grid-cols-[48px_minmax(0,1fr)] gap-x-5 py-8 sm:grid-cols-[64px_minmax(0,1fr)_auto] sm:items-start sm:gap-x-8"
              >
                <span class="t-display-lg leading-none text-forest-mid" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <Text k={`${serviceKey(service.slug)}.title`} as="h3" class="t-heading-xl text-ink group-hover:text-forest" />
                  <Text k={`${serviceKey(service.slug)}.summary`} class="t-body-md mt-3 max-w-xl text-body" />
                  <p class="t-body-sm mt-4 max-w-xl text-mute">
                    <Text k={`${k}:work.usuallyWhenLabel`} as="span" class="t-spaced-sm mr-2 text-forest" />
                    <Text k={`${k}:work.usuallyWhen.${service.slug}`} bare />
                  </p>
                </div>
                <span class="col-start-2 mt-5 inline-flex items-center gap-2 text-forest sm:col-start-auto sm:mt-1">
                  <Text k={`${k}:work.readMore`} as="span" class="t-spaced-sm sm:sr-only" />
                  <span class="flex size-12 items-center justify-center border-2 border-forest transition-colors group-hover:bg-forest group-hover:text-cream">
                    <Icon name="arrow" size={20} />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Chapter 2: repair or replace, as a reference table with a photo rail.
      Extra bottom padding: the forest band's treeline stands 64px into it. */}
  <section
    id="repair-or-replace"
    class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28"
    aria-labelledby="decide-heading"
  >
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:decide.title`} as="h2" id="decide-heading" class="t-display-lg text-ink" />
        <Text k={`${k}:decide.intro`} class="t-body-md max-w-2xl text-body" />
      </div>

      <div class="mt-10 grid gap-10 xl:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] xl:gap-12">
        <div class="min-w-0">
          {/* Phones get the same rows as ruled entries; three columns don't fit.
              Both views are the one list in the content, marked on each. */}
          <ul class="sm:hidden" {...list(`${k}:decide.rows`)}>
            {
              rows.map((row, i) => (
                <li class="border-b border-hairline py-5" {...item(i)}>
                  <div class="flex items-start justify-between gap-4">
                    <Text k={`${k}:decide.rows.${i}.sign`} as="h3" class="t-heading-sm text-ink" />
                    <Text k={`${k}:decide.verdicts.${row.verdict}`} as="span" class={`badge-tag shrink-0 ${verdictStyle[row.verdict]}`} />
                  </div>
                  <Text k={`${k}:decide.rows.${i}.means`} class="t-body-sm mt-2 text-body" />
                  {row.note && (
                    <p class="t-caption mt-2 text-mute">
                      <Text k={`${k}:decide.verdicts.${row.verdict}`} bare />: <Text k={`${k}:decide.rows.${i}.note`} bare />.
                    </p>
                  )}
                </li>
              ))
            }
          </ul>
          <div class="table-scroll hidden sm:block" tabindex="0" role="region" aria-label="Common roof problems, what they usually mean, and whether they point to repair or replacement">
            <table class="data-table min-w-[640px]">
              <caption class="sr-only">Common roof problems, what they usually mean, and whether they point to repair or replacement</caption>
              <thead>
                <tr>
                  <Text k={`${k}:decide.columns.sign`} as="th" scope="col" class="w-[30%]" />
                  <Text k={`${k}:decide.columns.means`} as="th" scope="col" />
                  <Text k={`${k}:decide.columns.verdict`} as="th" scope="col" class="w-[24%]" />
                </tr>
              </thead>
              <tbody {...list(`${k}:decide.rows`)}>
                {
                  rows.map((row, i) => (
                    <tr {...item(i)}>
                      <Text k={`${k}:decide.rows.${i}.sign`} as="th" scope="row" />
                      <Text k={`${k}:decide.rows.${i}.means`} as="td" />
                      <td>
                        <Text k={`${k}:decide.verdicts.${row.verdict}`} as="span" class={`badge-tag ${verdictStyle[row.verdict]}`} />
                        {row.note && <Text k={`${k}:decide.rows.${i}.note`} as="span" class="t-caption mt-2 block text-mute" />}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-1 xl:content-start">
          <figure class="photo-plate">
            <Img k={`${k}:decide.image`} loading="lazy" decoding="async" class="aspect-[4/3]" />
            <figcaption>
              <Text k={`${k}:decide.caption`} bare />
              <Fragment set:html={credit(`${k}:decide.image`)} />
            </figcaption>
          </figure>

          <div class="panel panel-keyline self-start overflow-hidden">
            <div class="plate-label">
              <Text k={`${k}:decide.rule.label`} as="span" class="t-spaced-sm" />
            </div>
            <div class="px-6 py-6">
              <Text k={`${k}:decide.rule.body`} class="t-body-sm text-body" />
              <div class="mt-5 flex flex-col gap-2 border-t border-hairline pt-5">
                <a href={serviceHref("roof-repair")} class="t-spaced-sm inline-flex min-h-10 items-center gap-2 text-forest hover:text-forest-deep">
                  <Text k={`${serviceKey("roof-repair")}.title`} bare /> <Icon name="arrow" size={16} />
                </a>
                <a href={serviceHref("roof-replacement")} class="t-spaced-sm inline-flex min-h-10 items-center gap-2 text-forest hover:text-forest-deep">
                  <Text k={`${serviceKey("roof-replacement")}.title`} bare /> <Icon name="arrow" size={16} />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Chapter 3: the climate, on a forest band. */}
  <section class="on-forest relative bg-forest text-on-forest" aria-labelledby="climate-heading">
    <Treeline tone="forest" height={64} offset={-345} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
        <Text k={`${k}:climate.title`} as="h2" id="climate-heading" class="t-display-lg max-w-xl" />
        <Text k={`${k}:climate.intro`} class="t-lead max-w-xl text-on-forest-mute" />
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <figure class="photo-plate self-start">
          <Img k={`${k}:climate.image`} loading="lazy" decoding="async" class="aspect-[4/3]" />
          <figcaption>
            <Text k={`${k}:climate.caption`} bare />
            <Fragment set:html={credit(`${k}:climate.image`)} />
          </figcaption>
        </figure>

        <div>
          <dl class="grid border-t border-hairline-dark sm:grid-cols-2 sm:gap-x-10" {...list(`${k}:climate.items`)}>
            {
              c.climate.items.map((_: unknown, i: number) => (
                <div class="border-b border-hairline-dark py-6" {...item(i)}>
                  <Text k={`${k}:climate.items.${i}.title`} as="dt" class="t-heading-sm" />
                  <Text k={`${k}:climate.items.${i}.body`} as="dd" class="t-body-sm mt-2 text-on-forest-mute" />
                </div>
              ))
            }
          </dl>
          <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
            <a href={pages.materials} class="btn btn-cream shrink-0 whitespace-nowrap">
              <Text k={`${k}:climate.materialsLink`} bare />
              <Icon name="arrow" size={18} />
            </a>
            <Text k={`${k}:climate.materialsNote`} class="t-body-sm max-w-sm text-on-forest-mute" />
          </div>
        </div>
      </div>
    </div>

    <Treeline tone="cream" height={64} offset={-90} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* Chapter 4: how the estimate works, four ruled columns, then what helps.
      The four steps are a fixed grid (their rules depend on position), so
      they are not an editable list. */}
  <section class="section bg-canvas" aria-labelledby="estimate-heading">
    <div class="container-page">
      <Text k={`${k}:estimate.title`} as="h2" id="estimate-heading" class="t-display-lg max-w-2xl text-ink" />
      <Text k={`${k}:estimate.intro`} class="t-lead mt-5 max-w-2xl text-body" />

      <ol class="mt-12 grid border-t border-hairline sm:grid-cols-2 lg:grid-cols-4 lg:border-b">
        {
          c.estimate.steps.map((_: unknown, index: number) => (
            <li
              class:list={[
                "border-b border-hairline py-8 sm:px-6",
                index % 2 === 0 ? "sm:pl-0" : "sm:border-l",
                "lg:border-b-0 lg:border-l lg:first:border-l-0 lg:pl-6 lg:first:pl-0",
                index === c.estimate.steps.length - 1 && "lg:pr-0",
              ]}
            >
              <span class="t-display-lg block leading-none text-forest-mid" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <Text k={`${k}:estimate.steps.${index}.title`} as="h3" class="t-heading-md mt-5 text-ink" />
              <Text k={`${k}:estimate.steps.${index}.body`} class="t-body-sm mt-3 text-body" />
            </li>
          ))
        }
      </ol>

      <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div>
          <Text k={`${k}:estimate.helpful.title`} as="h3" class="t-heading-xl text-ink" />
          <Text k={`${k}:estimate.helpful.intro`} class="t-body-md mt-3 max-w-xl text-body" />
          <ul class="check-list t-body-md mt-6 text-body" {...list(`${k}:estimate.helpful.items`)}>
            {c.estimate.helpful.items.map((_: unknown, i: number) => <Text k={`${k}:estimate.helpful.items.${i}`} as="li" {...item(i)} />)}
          </ul>
        </div>

        <aside class="panel panel-keyline self-start overflow-hidden">
          <div class="plate-label">
            <Text k={`${k}:estimate.facts.label`} as="span" class="t-spaced-sm" />
          </div>
          <dl class="px-6 py-2">
            {
              ["cost", "format", "credentials"].map((fact) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-hairline py-4">
                  <Text k={`${k}:estimate.facts.${fact}.label`} as="dt" class="t-spaced-sm text-mute" />
                  <Text k={`${k}:estimate.facts.${fact}.value`} as="dd" class="t-heading-sm text-right text-ink" />
                </div>
              ))
            }
            <div class="flex items-baseline justify-between gap-4 border-b border-hairline py-4">
              <Text k={`${k}:estimate.facts.ccb.label`} as="dt" class="t-spaced-sm text-mute" />
              <Text k={`${k}:estimate.facts.ccb.value`} as="dd" class="t-heading-sm text-right text-forest" />
            </div>
            <div class="flex items-baseline justify-between gap-4 py-4">
              <Text k={`${k}:estimate.facts.areaLabel`} as="dt" class="t-spaced-sm text-mute" />
              <dd class="t-heading-sm text-right">
                <a href={pages.serviceArea} class="text-forest underline underline-offset-4 hover:text-forest-deep">{site.serviceArea.replace(/^the /, "")}</a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <ClosingCta k={`${k}:closingCta`} />
</Page>
