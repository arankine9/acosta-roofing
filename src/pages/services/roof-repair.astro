---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import LeakCall from "../../components/LeakCall.astro";
import Treeline from "../../components/Treeline.astro";
import LeakPath from "../../components/roof-repair/LeakPath.astro";
import Text from "../../components/Text.astro";
import Img from "../../components/Img.astro";
import { site } from "../../data/site";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";
import { file, list, item, credit } from "../../lib/cms";

// Roof repair: the common repairs (photos, then a ruled grid), how a leak is
// traced (drawn section plus the method), what a homeowner can safely do
// before we arrive (forest band), matching and when a repair isn't worth it,
// then the leak call-out.
//
// Insurance constraint: the business does not advertise emergency repair.
// The only response wording is LeakCall's approved line; temporary tarping
// is described as something we *may* be able to do, depending on the job.
//
// Photos (public/images/roof-repair/):
// - opened-roof-section.jpg: Zohair Mirza, "A man standing on the roof of a
//   house", Unsplash, https://unsplash.com/photos/a-man-standing-on-the-roof-of-a-house--1l0iZaM8ms
//   (Unsplash License: free for commercial use, no attribution required).
// - failed-chimney-flashing.jpg: Sandul1234, "Bad chimney flashing",
//   Wikimedia Commons, https://commons.wikimedia.org/wiki/File:Bad_chimney_flashing.jpg
//   (CC BY-SA 4.0; credited in its caption).
// - limb-through-shingles.jpg: Sandul1234, "Branch in a roof", Wikimedia
//   Commons, https://commons.wikimedia.org/wiki/File:Branch_in_a_roof.jpg
//   (CC BY-SA 4.0; credited in its caption).

const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
  { label: "Roof repair", href: serviceHref("roof-repair") },
];

const schema = {
  "@type": "Service",
  name: "Roof repair",
  serviceType: "Roof repair",
  description:
    "Residential roof repair: leaks traced to the source, missing and lifted shingles, pipe boots, chimney, wall and skylight flashing, valleys, ridge caps, nail pops, storm and tree-limb damage.",
  provider: { "@type": "RoofingContractor", name: site.legalName, telephone: site.phone },
  areaServed: "Portland metro, Oregon",
};

// Every word on this page is in src/content/pages/services-roof-repair.json;
// `k` is the key prefix into it and `c` its parsed content, for the lists.
const k = "pages/services-roof-repair";
const c = file(k);

// The legend's keys are the letters drawn in LeakPath, so they stay with the
// drawing rather than the copy: A, B, C, D in legend order.
const legendKey = (index: number) => String.fromCharCode(65 + index);
---

<Page k={k} crumbs={crumbs} schema={schema}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-330} />

  {/* Chapter 1: common repairs. Two photo plates, then a ruled four-up grid. */}
  <section class="section bg-canvas" aria-labelledby="repairs-heading">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:repairs.title`} as="h2" id="repairs-heading" class="t-display-lg text-ink" />
        <Text k={`${k}:repairs.intro`} class="t-body-md max-w-xl text-body" />
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {
          c.repairs.photos.map((_: unknown, i: number) => (
            <figure class="photo-plate">
              <Img k={`${k}:repairs.photos.${i}.image`} loading="lazy" decoding="async" class="aspect-[3/2]" />
              <figcaption>
                <Text k={`${k}:repairs.photos.${i}.caption`} bare />
                <Fragment set:html={credit(`${k}:repairs.photos.${i}.image`)} />
              </figcaption>
            </figure>
          ))
        }
      </div>

      <dl class="mt-12 grid border-t border-hairline sm:grid-cols-2 sm:gap-x-10 xl:grid-cols-4">
        {
          c.repairs.items.map((_: unknown, i: number) => (
            <div class="border-b border-hairline py-6">
              <Text k={`${k}:repairs.items.${i}.title`} as="dt" class="t-heading-md text-ink" />
              <Text k={`${k}:repairs.items.${i}.body`} as="dd" class="t-body-sm mt-3 text-body" />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Chapter 2: tracing the leak, drawn. Extra bottom padding: the forest
      band's treeline stands 64px into it. */}
  <section class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28" aria-labelledby="trace-heading">
    <div class="container-page">
      <Text k={`${k}:trace.eyebrow`} class="t-eyebrow text-forest" />
      <Text k={`${k}:trace.title`} as="h2" id="trace-heading" class="t-display-lg mt-4 max-w-3xl text-ink" />
      <Text k={`${k}:trace.lead`} class="t-lead mt-5 max-w-2xl text-body" />

      <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <figure class="min-w-0 self-start">
          <div class="panel panel-keyline overflow-hidden">
            <div class="plate-label">
              <Text k={`${k}:trace.plateLabel`} as="span" class="t-spaced-sm" />
            </div>
            <div class="px-2 pt-5 pb-3 sm:px-6">
              <LeakPath class="block h-auto w-full" />
            </div>
          </div>
          <dl class="mt-6 grid gap-x-8 border-t border-hairline sm:grid-cols-2">
            {
              c.trace.legend.map((_: unknown, i: number) => (
                <div class="grid grid-cols-[32px_minmax(0,1fr)] gap-x-4 border-b border-hairline py-4">
                  <span class="t-heading-sm flex size-8 items-center justify-center bg-forest text-cream" aria-hidden="true">
                    {legendKey(i)}
                  </span>
                  <div>
                    <Text k={`${k}:trace.legend.${i}.title`} as="dt" class="t-heading-sm text-ink" />
                    <Text k={`${k}:trace.legend.${i}.body`} as="dd" class="t-body-sm mt-1 text-body" />
                  </div>
                </div>
              ))
            }
          </dl>
        </figure>

        <div>
          <Text k={`${k}:trace.methodTitle`} as="h3" class="t-heading-xl text-ink" />
          <ol class="step-list mt-6" {...list(`${k}:trace.method`)}>
            {
              c.trace.method.map((_: unknown, i: number) => (
                <li {...item(i)}>
                  <Text k={`${k}:trace.method.${i}.title`} as="h4" class="t-heading-sm text-ink" />
                  <Text k={`${k}:trace.method.${i}.body`} class="t-body-sm text-body" />
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* Chapter 3: what to do before we arrive, on a forest band. */}
  <section class="on-forest relative bg-forest text-on-forest" aria-labelledby="before-heading">
    <Treeline tone="forest" height={64} offset={-160} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="max-w-3xl">
        <Text k={`${k}:before.title`} as="h2" id="before-heading" class="t-display-lg" />
        <Text k={`${k}:before.lead`} class="t-lead mt-5 text-on-forest-mute" />
      </div>

      <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <div>
          <Text k={`${k}:before.safeLabel`} class="t-spaced border-b border-hairline-dark pb-4" />
          <ul class="check-list t-body-md mt-6 text-on-forest-mute" {...list(`${k}:before.safe`)}>
            {c.before.safe.map((_: unknown, i: number) => <Text k={`${k}:before.safe.${i}`} as="li" {...item(i)} />)}
          </ul>
        </div>

        <div>
          <Text k={`${k}:before.leaveLabel`} class="t-spaced border-b border-hairline-dark pb-4" />
          <ul {...list(`${k}:before.leave`)}>
            {
              c.before.leave.map((_: unknown, i: number) => (
                <li class="border-b border-hairline-dark py-5" {...item(i)}>
                  <Text k={`${k}:before.leave.${i}.title`} as="h3" class="t-heading-sm" />
                  <Text k={`${k}:before.leave.${i}.body`} class="t-body-sm mt-2 text-on-forest-mute" />
                </li>
              ))
            }
          </ul>
          <Text k={`${k}:before.note`} class="t-body-sm mt-6 text-on-forest-mute" />
        </div>
      </div>
    </div>

    <Treeline tone="cream" height={64} offset={-470} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* Chapter 4: matching, and when a repair isn't worth it. */}
  <section class="section bg-canvas" aria-labelledby="match-heading">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
      <div>
        <Text k={`${k}:match.title`} as="h2" id="match-heading" class="t-display-lg text-ink" />
        <Text k={`${k}:match.body`} type="block" as="div" class="prose-page mt-6" />
      </div>

      <aside class="self-start">
        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <Text k={`${k}:match.notWorthIt.label`} as="span" class="t-spaced-sm" />
          </div>
          <div class="px-6 py-7 sm:px-8">
            <Text k={`${k}:match.notWorthIt.intro`} class="t-body-md text-body" />
            <ul class="check-list t-body-sm mt-5 text-body" {...list(`${k}:match.notWorthIt.items`)}>
              {c.match.notWorthIt.items.map((_: unknown, i: number) => <Text k={`${k}:match.notWorthIt.items.${i}`} as="li" {...item(i)} />)}
            </ul>
            <Text k={`${k}:match.notWorthIt.more`} type="rich" class="t-body-sm mt-6 border-t border-hairline pt-5 text-body" />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <LeakCall />

  <RelatedServices current="roof-repair" k={`${k}:related`} />

  <ClosingCta k={`${k}:closingCta`} />
</Page>
