---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Treeline from "../../components/Treeline.astro";
import Icon from "../../components/Icon.astro";
import RoofLayers from "../../components/roof-replacement/RoofLayers.astro";
import { asset } from "../../lib/url";
import { site } from "../../data/site";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";

// Roof replacement: the full job, in order, for a homeowner deciding whether
// and how to replace. Chapters: the layers (drawn), the steps (ruled list
// with a sticky photo rail), the day itself (forest band), choosing the
// shingle (reference table), and the signs that point to replacement.
//
// Photos (public/images/roof-replacement/):
// - shingles-over-underlayment.jpg: Ryan Stephens, "Professional Roofer
//   Installing Shingles on New Roof", Pexels,
//   https://www.pexels.com/photo/professional-roofer-installing-shingles-on-new-roof-33404248/
//   (Pexels License: free for commercial use, no attribution required).
// - deck-and-underlayment.jpg: Ryan Stephens, "Historic Home Roof Replacement
//   in Weatherford", Pexels,
//   https://www.pexels.com/photo/historic-home-roof-replacement-in-weatherford-33501308/
//   (Pexels License).
// - cracked-shingles.jpg: Samuel Bolton, "Asphalt shingles damage", Wikimedia
//   Commons, https://commons.wikimedia.org/wiki/File:Asphalt_shingles_damage.jpg
//   (CC BY-SA 4.0; credited in its caption, as the licence requires).
//
// Service lives (15–20 / 25–30 years) are the same industry ranges the home
// page's Materials band uses: general guidance, not a warranty.

const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
  { label: "Roof replacement", href: serviceHref("roof-replacement") },
];

const schema = {
  "@type": "Service",
  name: "Roof replacement",
  serviceType: "Roof replacement",
  description:
    "Residential roof replacement: tear-off to the deck, deck repair, drip edge, ice-and-water shield, synthetic underlayment, flashing, shingles and ridge ventilation.",
  provider: { "@type": "RoofingContractor", name: site.legalName, telephone: site.phone },
  areaServed: "Portland metro, Oregon",
};

const layers = [
  {
    title: "Roof deck",
    body: "The plywood or OSB sheathing nailed to the rafters. Everything above is fastened to it, so soft or delaminated sheets are replaced, never covered over.",
  },
  {
    title: "Drip edge",
    body: "Bent metal along the eaves and rakes. It carries water past the fascia and into the gutter instead of letting it wick back into the wood.",
  },
  {
    title: "Ice-and-water shield",
    body: "Self-adhering membrane at the eaves, in the valleys and around every penetration. It seals around each nail, which is what stops water that gets pushed back up under the shingles.",
  },
  {
    title: "Synthetic underlayment",
    body: "Covers the rest of the deck, lapped over the ice-and-water shield. Tougher than the old felt paper, and it keeps the house dry while the shingles go on.",
  },
  {
    title: "Starter course",
    body: "An adhesive strip along the eaves and rakes, so the first course and the roof edges are sealed down against wind.",
  },
  {
    title: "Shingles",
    body: "Nailed where the manufacturer's instructions put the nails, at the exposure they call for. The wind rating depends on it.",
  },
  {
    title: "Flashing and pipe boots",
    body: "Metal and rubber at every place the roof is interrupted: pipes, chimneys, walls, skylights. It is where most leaks start.",
  },
  {
    title: "Ridge vent",
    body: "A continuous opening along the peak under a vented cap, where warm, damp attic air leaves.",
  },
  {
    title: "Attic airflow",
    body: "Air comes in at the soffit vents and out at the ridge. In a wet climate, that draft is what keeps condensation off the underside of the deck.",
  },
];

const steps = [
  {
    title: "Estimate and deck assessment",
    body: "We walk the roof, look in the attic if there's a hatch, and count how many layers are on. Soft spots underfoot, sags between rafters and stained sheathing tell us how much deck may need work before anything comes off. You get the estimate in writing, itemized.",
  },
  {
    title: "Tear-off to the deck",
    body: "Tarps go down over beds and along the walls first. Then the old shingles, underlayment and nails come off, down to bare wood, straight into the trailer or bin. A new roof laid over an old one hides the deck and wears out sooner, so everything comes off.",
  },
  {
    title: "Deck repair and re-sheathing",
    body: "Soft, rotted or delaminated sheets are cut out and replaced. Older houses with board decking and wide gaps between the boards may need new sheathing over the whole roof. We show you what we found before we replace it.",
  },
  {
    title: "Drip edge",
    body: "Metal along the eaves goes on first, under the membrane. The rakes get theirs after the underlayment, over it. Each piece laps the way water runs.",
  },
  {
    title: "Ice-and-water shield",
    body: "Along the eaves, up every valley and around chimneys, skylights and pipes: the places where water slows down, collects or gets driven sideways by wind.",
  },
  {
    title: "Synthetic underlayment",
    body: "Across the rest of the deck, lapped over the shield and fastened on the manufacturer's schedule. From here the house is dried in, so a rain shower between steps doesn't reach the attic.",
  },
  {
    title: "Starter course",
    body: "Along the eaves and up the rakes, so the first row of shingles and the roof edges have a sealed strip under them.",
  },
  {
    title: "Flashing",
    body: "Step flashing woven in with each course where the roof meets a wall. Counter-flashing let into the chimney's mortar joints and lapped over the step flashing. New pipe boots and vent flashing at every penetration. It is where roofs leak, so it's replaced rather than patched around.",
  },
  {
    title: "Shingles",
    body: "Courses snapped to chalk lines and kept straight, nails where the wrapper says, valleys cut clean, hips and ridge capped.",
  },
  {
    title: "Ridge vent and attic ventilation",
    body: "A continuous vent along the ridge, balanced against the intake at the soffits. If the attic doesn't have enough intake, we'll tell you, because a ridge vent with no air coming in at the bottom doesn't move much air.",
  },
  {
    title: "Cleanup and magnetic nail sweep",
    body: "Debris to the trailer, gutters flushed of grit and stray nails, then a rolling magnet over the lawn, beds, driveway and the street edge.",
  },
  {
    title: "Final walk-through",
    body: "We walk the job with you and go over what we found under the old roof, what we replaced and why, with photos of anything you couldn't see from the ground.",
  },
];

const onTheDay = [
  {
    title: "Noise",
    body: "Hammers and nail guns overhead for most of the day. If you work from home, plan to work somewhere else for the tear-off.",
  },
  {
    title: "Driveway",
    body: "We need it for the trailer and the materials. Park on the street the night before, and take the car out of the garage if the driveway is the only way out.",
  },
  {
    title: "Pets and kids",
    body: "The noise upsets most dogs and cats; a quiet room at the other end of the house, or a day away, helps. Keep everyone clear of the drip line, where debris comes down.",
  },
  {
    title: "Walls and attic",
    body: "Hammering shakes the top floor. Take down mirrors and framed pictures up there. Anything stored in the attic will collect dust and grit, so cover it or move it.",
  },
  {
    title: "Yard",
    body: "Point out sprinkler heads, a fragile plant or a spot you'd rather the trailer didn't sit. It's easier before the tarps go down.",
  },
];

const shingleRows = [
  { label: "Construction", tab: "One flat layer with cutouts that make three tabs", arch: "Two layers laminated together, thicker and heavier" },
  { label: "Look", tab: "Flat and uniform, even slots", arch: "Shadowed and dimensional; reads like shake from the street" },
  { label: "Wind", tab: "Lower wind ratings", arch: "Higher wind ratings; the weight helps it stay down" },
  { label: "Typical life", tab: "15–20 years", arch: "25–30 years" },
  { label: "Where it fits", tab: "Garages, sheds and outbuildings; the tightest budgets", arch: "Most houses, especially if you plan to stay" },
];

const signs = [
  "It's old for what it is: 3-tab past about 15–20 years, architectural past 25 or so.",
  "Granules collecting in the gutters and at the downspout, and dark, bare patches on the shingles.",
  "Edges curling up or cupping, or shingles gone brittle enough to crack when they're lifted.",
  "Leaks in more than one place, or the same leak back after a repair.",
  "Decking that feels soft or springy underfoot, or a roofline that dips between rafters.",
  "Years of moss grown in under the shingle edges and lifting them.",
  "Dark staining on the underside of the deck in the attic, or daylight between the boards.",
];
---

<Page
  title="Roof Replacement"
  description="How Acosta Roofing replaces a house roof in the Portland metro: tear-off to the deck, deck repair, drip edge, ice-and-water shield, synthetic underlayment, flashing, shingles and ridge ventilation, step by step."
  crumbs={crumbs}
  schema={schema}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Residential"
    title="Roof replacement"
    lead="Everything comes off, down to the wood. Then the roof goes back on in layers, and each layer is there for a reason. This is the whole job, in the order we do it."
    image="/images/roof-replacement/shingles-over-underlayment.jpg"
    imageAlt="Roofer nailing a new course of architectural shingles over gray synthetic underlayment"
    treelineOffset={-40}
  />

  {/* Chapter 1: the layers, drawn, with the legend beside the drawing. */}
  <section class="section bg-canvas" aria-labelledby="layers-heading">
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <h2 id="layers-heading" class="t-display-lg text-ink">What's under the shingles</h2>
        <p class="t-body-md max-w-xl text-body">
          The shingles shed most of the water. The layers under them deal with what gets past, and the flashing
          deals with every place the roof is interrupted. A roof that leaks young usually has a layer missing or
          done cheaply, not a bad shingle.
        </p>
      </div>

      <figure class="panel panel-keyline mt-10 overflow-hidden">
        <div class="plate-label">
          <span class="t-spaced-sm">Section at the eave &middot; not to scale</span>
        </div>
        <div class="mx-auto max-w-[980px] px-2 pt-6 pb-2 sm:px-8 sm:pt-8">
          <RoofLayers class="block h-auto w-full" />
        </div>
        <figcaption class="t-caption border-t border-hairline px-5 py-4 text-mute sm:px-8">
          Shingles cut back part way up the slope to show the layers beneath. The dashed line is attic air, in at the
          soffit and out at the ridge.
        </figcaption>
      </figure>

      <ol class="mt-10 grid gap-x-10 border-t border-hairline sm:grid-cols-2 lg:grid-cols-3">
        {
          layers.map((layer, index) => (
            <li class="grid grid-cols-[32px_minmax(0,1fr)] gap-x-4 border-b border-hairline py-5">
              <span class="t-heading-sm flex size-8 items-center justify-center bg-forest text-cream" aria-hidden="true">
                {index + 1}
              </span>
              <div>
                <h3 class="t-heading-sm text-ink">{layer.title}</h3>
                <p class="t-body-sm mt-1 text-body">{layer.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Chapter 2: the steps. Extra bottom padding: the forest band's treeline
      stands 64px into this section. */}
  <section class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28" aria-labelledby="steps-heading">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div class="min-w-0">
          <p class="t-eyebrow text-forest">Twelve steps</p>
          <h2 id="steps-heading" class="t-display-lg mt-4 text-ink">The job, start to finish</h2>
          <p class="t-lead mt-5 max-w-2xl text-body">
            Every roof we replace goes through the same sequence. The order matters: each layer laps over the one
            before it, the way water runs downhill.
          </p>

          <ol class="step-list mt-10">
            {
              steps.map((step) => (
                <li>
                  <h3 class="t-heading-md text-ink">{step.title}</h3>
                  <p class="t-body-md text-body">{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <aside class="min-w-0">
          <div class="flex flex-col gap-8 lg:sticky lg:top-28">
            <figure class="photo-plate">
              <img
                src={asset("/images/roof-replacement/deck-and-underlayment.jpg")}
                alt="A crew mid-replacement on an old two-story house: bare wood decking on one roof section, synthetic underlayment already down on the main roof"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3]"
              />
              <figcaption>
                Mid-job. On the right the deck is bare and waiting; on the main roof the underlayment is down, so that
                part of the house is dry even before a shingle goes on.
              </figcaption>
            </figure>

            <div class="panel panel-keyline overflow-hidden">
              <div class="plate-label">
                <span class="t-spaced-sm">The part nobody can see yet</span>
              </div>
              <div class="px-6 py-6">
                <p class="t-body-sm text-body">
                  Nobody knows the exact state of the deck until the old roof is off. The estimate tells you what we
                  expect from the attic and the walk, and how deck repair is handled if there's more. If there is,
                  we show you before we replace it.
                </p>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* Chapter 3: the day itself, on a forest band. */}
  <section class="on-forest relative bg-forest text-on-forest" aria-labelledby="day-heading">
    <Treeline tone="forest" height={64} offset={-515} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div>
          <h2 id="day-heading" class="t-display-lg">What to expect on the day</h2>
          <p class="t-lead mt-5 text-on-forest-mute">
            A tear-off is loud, busy and fast. Here's what it looks like from inside the house, and what makes it
            easier.
          </p>

          <dl class="mt-10 grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-6 border-t border-hairline-dark pt-6">
            <dd class="t-display-lg leading-none">1–3</dd>
            <dt class="t-spaced-sm text-on-forest-mute">Days for a typical house</dt>
          </dl>
          <p class="t-body-sm mt-5 max-w-md text-on-forest-mute">
            A simple single-story roof can be one long day. Steep pitches, a roof cut up by dormers and valleys, a
            second layer coming off or a lot of deck repair all add time, and so does rain. We only open up as much
            roof as can be dried in the same day.
          </p>
        </div>

        <ul class="border-t border-hairline-dark">
          {
            onTheDay.map((item) => (
              <li class="grid gap-2 border-b border-hairline-dark py-6 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-8">
                <h3 class="t-heading-sm">{item.title}</h3>
                <p class="t-body-md text-on-forest-mute">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <Treeline tone="cream" height={64} offset={-205} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* Chapter 4: choosing the shingle, as a reference table. */}
  <section class="section bg-canvas" aria-labelledby="shingle-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 id="shingle-heading" class="t-display-lg text-ink">Choosing the shingle</h2>
        <div class="prose-page mt-5">
          <p>
            On a house, the choice is usually between 3-tab and architectural shingle. The layers under them are the
            same either way; the difference is weight, wind resistance, looks and how long they last.
          </p>
          <p>
            Shingles need enough pitch to shed water. A near-flat porch roof or a low addition gets single-ply
            membrane (TPO or PVC) instead, flashed into the shingles where the two meet.
          </p>
        </div>
        <a href={pages.materials} class="btn btn-outline mt-8">
          Compare materials
          <Icon name="arrow" size={18} />
        </a>
      </div>

      <div class="min-w-0 self-start">
        <div class="table-scroll">
          <table class="data-table min-w-[560px]">
            <caption class="sr-only">3-tab and architectural shingle compared</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Feature</span></th>
                <th scope="col">3-tab asphalt shingle</th>
                <th scope="col">Architectural shingle</th>
              </tr>
            </thead>
            <tbody>
              {
                shingleRows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td>{row.tab}</td>
                    <td>{row.arch}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="t-caption mt-3 text-mute">
          Lifespans are typical industry ranges with proper installation and upkeep, not a promise about any one roof.
          Moss, shade and ventilation all move the number.
        </p>
      </div>
    </div>
  </section>

  {/* Chapter 5: signs it's time, photo plate beside a checked list. */}
  <section class="section bg-cream-deep" aria-labelledby="signs-heading">
    <div class="container-page grid gap-10 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-start lg:gap-16">
      <div>
        <h2 id="signs-heading" class="t-display-lg text-ink">Signs it's time</h2>
        <p class="t-lead mt-5 text-body">
          One of these on one slope may be a repair. Several of them, across the roof, usually aren't.
        </p>
        <ul class="check-list t-body-md mt-8 text-body">
          {signs.map((sign) => <li>{sign}</li>)}
        </ul>
        <p class="t-body-md mt-8 text-body">
          Not sure which side of the line you're on? Start with <a href={serviceHref("roof-repair")} class="link-inline">roof repair</a>,
          or read the <a href={`${pages.residential}#repair-or-replace`} class="link-inline">repair-or-replace guide</a>. If a repair buys you
          real years, we'll say so.
        </p>
      </div>
      <figure class="photo-plate">
        <img
          src={asset("/images/roof-replacement/cracked-shingles.jpg")}
          alt="Worn 3-tab shingles with cracked, split and buckled tabs across the slope"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3]"
        />
        <figcaption>
          Cracks and splits running across many courses, not one. That's a roof wearing out, not a repair.
          Photo: Samuel Bolton, CC BY-SA 4.0.
        </figcaption>
      </figure>

    </div>
  </section>

  <RelatedServices current="roof-replacement" title="Also on a house" />

  <ClosingCta
    title="Get a replacement estimate"
    body="We'll walk the roof, look in the attic and count the layers, then write down exactly what the job includes. Free, and no pressure to decide on the spot."
  />
</Page>
