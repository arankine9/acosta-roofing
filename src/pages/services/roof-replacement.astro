---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Treeline from "../../components/Treeline.astro";
import Icon from "../../components/Icon.astro";
import RoofLayers from "../../components/roof-replacement/RoofLayers.astro";
import Text from "../../components/Text.astro";
import Img from "../../components/Img.astro";
import { site } from "../../data/site";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";
import { file, list, item, credit } from "../../lib/cms";

// Roof replacement: the full job, in order, for a homeowner deciding whether
// and how to replace. Chapters: the layers (drawn), the steps (ruled list
// with a sticky photo rail), the day itself (forest band), choosing the
// shingle (reference table), and the signs that point to replacement.
//
// Photos (public/images/roof-replacement/):
// - shingles-over-underlayment.jpg: Ryan Stephens, "Professional Roofer
//   Installing Shingles on New Roof", Pexels,
//   https://www.pexels.com/photo/professional-roofer-installing-shingles-on-new-roof-33404248/
//   (Pexels License: free for commercial use, no attribution required).
// - deck-and-underlayment.jpg: Ryan Stephens, "Historic Home Roof Replacement
//   in Weatherford", Pexels,
//   https://www.pexels.com/photo/historic-home-roof-replacement-in-weatherford-33501308/
//   (Pexels License).
// - cracked-shingles.jpg: Samuel Bolton, "Asphalt shingles damage", Wikimedia
//   Commons, https://commons.wikimedia.org/wiki/File:Asphalt_shingles_damage.jpg
//   (CC BY-SA 4.0; credited in its caption, as the licence requires).
//
// Service lives (25–30 / 30+ years) are the same industry ranges the home
// page's Materials band uses: general guidance, not a warranty.

const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
  { label: "Roof replacement", href: serviceHref("roof-replacement") },
];

const schema = {
  "@type": "Service",
  name: "Roof replacement",
  serviceType: "Roof replacement",
  description:
    "Residential roof replacement: tear-off to the deck, deck repair, drip edge, ice-and-water shield, synthetic underlayment, flashing, shingles and ridge ventilation.",
  provider: { "@type": "RoofingContractor", name: site.legalName, telephone: site.phone },
  areaServed: "Portland metro, Oregon",
};

// Every word on this page is in src/content/pages/services-roof-replacement.json;
// `k` is the key prefix into it and `c` its parsed content, for the lists.
const k = "pages/services-roof-replacement";
const c = file(k);
---

<Page k={k} crumbs={crumbs} schema={schema}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-40} />

  {/* Chapter 1: the layers, drawn, with the legend beside the drawing. The
      legend is numbered to match the drawing, so it is a fixed set of nine. */}
  <section class="section bg-canvas" aria-labelledby="layers-heading">
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:layers.title`} as="h2" id="layers-heading" class="t-display-lg text-ink" />
        <Text k={`${k}:layers.intro`} class="t-body-md max-w-xl text-body" />
      </div>

      <figure class="panel panel-keyline mt-10 overflow-hidden">
        <div class="plate-label">
          <Text k={`${k}:layers.plateLabel`} as="span" class="t-spaced-sm" />
        </div>
        <div class="mx-auto max-w-[980px] px-2 pt-6 pb-2 sm:px-8 sm:pt-8">
          <RoofLayers class="block h-auto w-full" />
        </div>
        <Text k={`${k}:layers.caption`} as="figcaption" class="t-caption border-t border-hairline px-5 py-4 text-mute sm:px-8" />
      </figure>

      <ol class="mt-10 grid gap-x-10 border-t border-hairline sm:grid-cols-2 lg:grid-cols-3">
        {
          c.layers.items.map((_: unknown, index: number) => (
            <li class="grid grid-cols-[32px_minmax(0,1fr)] gap-x-4 border-b border-hairline py-5">
              <span class="t-heading-sm flex size-8 items-center justify-center bg-forest text-cream" aria-hidden="true">
                {index + 1}
              </span>
              <div>
                <Text k={`${k}:layers.items.${index}.title`} as="h3" class="t-heading-sm text-ink" />
                <Text k={`${k}:layers.items.${index}.body`} class="t-body-sm mt-1 text-body" />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Chapter 2: the steps. Extra bottom padding: the forest band's treeline
      stands 64px into this section. */}
  <section class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28" aria-labelledby="steps-heading">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div class="min-w-0">
          <Text k={`${k}:steps.eyebrow`} class="t-eyebrow text-forest" />
          <Text k={`${k}:steps.title`} as="h2" id="steps-heading" class="t-display-lg mt-4 text-ink" />
          <Text k={`${k}:steps.lead`} class="t-lead mt-5 max-w-2xl text-body" />

          <ol class="step-list mt-10" {...list(`${k}:steps.items`)}>
            {
              c.steps.items.map((_: unknown, i: number) => (
                <li {...item(i)}>
                  <Text k={`${k}:steps.items.${i}.title`} as="h3" class="t-heading-md text-ink" />
                  <Text k={`${k}:steps.items.${i}.body`} class="t-body-md text-body" />
                </li>
              ))
            }
          </ol>
        </div>

        <aside class="min-w-0">
          <div class="flex flex-col gap-8 lg:sticky lg:top-28">
            <figure class="photo-plate">
              <Img k={`${k}:steps.image`} loading="lazy" decoding="async" class="aspect-[4/3]" />
              <Text k={`${k}:steps.caption`} as="figcaption" />
            </figure>

            <div class="panel panel-keyline overflow-hidden">
              <div class="plate-label">
                <Text k={`${k}:steps.deck.label`} as="span" class="t-spaced-sm" />
              </div>
              <div class="px-6 py-6">
                <Text k={`${k}:steps.deck.body`} class="t-body-sm text-body" />
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* Chapter 3: the day itself, on a forest band. */}
  <section class="on-forest relative bg-forest text-on-forest" aria-labelledby="day-heading">
    <Treeline tone="forest" height={64} offset={-515} class="absolute inset-x-0 bottom-full" />

    <div class="container-page pt-24 pb-36 md:pt-28 md:pb-40">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div>
          <Text k={`${k}:day.title`} as="h2" id="day-heading" class="t-display-lg" />
          <Text k={`${k}:day.lead`} class="t-lead mt-5 text-on-forest-mute" />

          <dl class="mt-10 grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-6 border-t border-hairline-dark pt-6">
            <Text k={`${k}:day.stat.value`} as="dd" class="t-display-lg leading-none" />
            <Text k={`${k}:day.stat.label`} as="dt" class="t-spaced-sm text-on-forest-mute" />
          </dl>
          <Text k={`${k}:day.note`} class="t-body-sm mt-5 max-w-md text-on-forest-mute" />
        </div>

        <ul class="border-t border-hairline-dark" {...list(`${k}:day.items`)}>
          {
            c.day.items.map((_: unknown, i: number) => (
              <li class="grid gap-2 border-b border-hairline-dark py-6 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-8" {...item(i)}>
                <Text k={`${k}:day.items.${i}.title`} as="h3" class="t-heading-sm" />
                <Text k={`${k}:day.items.${i}.body`} class="t-body-md text-on-forest-mute" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <Treeline tone="cream" height={64} offset={-205} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* Chapter 4: choosing the shingle, as a reference table. */}
  <section class="section bg-canvas" aria-labelledby="shingle-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <Text k={`${k}:shingle.title`} as="h2" id="shingle-heading" class="t-display-lg text-ink" />
        <Text k={`${k}:shingle.body`} type="block" as="div" class="prose-page mt-5" />
        <a href={pages.materials} class="btn btn-outline mt-8">
          <Text k={`${k}:shingle.button`} bare />
          <Icon name="arrow" size={18} />
        </a>
      </div>

      <div class="min-w-0 self-start">
        <div class="table-scroll" tabindex="0" role="region" aria-label="Architectural and designer shingle compared">
          <table class="data-table min-w-[560px]">
            <caption class="sr-only">Architectural and designer shingle compared</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Feature</span></th>
                <Text k={`${k}:shingle.table.arch`} as="th" scope="col" />
                <Text k={`${k}:shingle.table.designer`} as="th" scope="col" />
              </tr>
            </thead>
            <tbody {...list(`${k}:shingle.table.rows`)}>
              {
                c.shingle.table.rows.map((_: unknown, i: number) => (
                  <tr {...item(i)}>
                    <Text k={`${k}:shingle.table.rows.${i}.label`} as="th" scope="row" />
                    <Text k={`${k}:shingle.table.rows.${i}.arch`} as="td" />
                    <Text k={`${k}:shingle.table.rows.${i}.designer`} as="td" />
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <Text k={`${k}:shingle.note`} class="t-caption mt-3 text-mute" />
      </div>
    </div>
  </section>

  {/* Chapter 5: signs it's time, photo plate beside a checked list. */}
  <section class="section bg-cream-deep" aria-labelledby="signs-heading">
    <div class="container-page grid gap-10 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-start lg:gap-16">
      <div>
        <Text k={`${k}:signs.title`} as="h2" id="signs-heading" class="t-display-lg text-ink" />
        <Text k={`${k}:signs.lead`} class="t-lead mt-5 text-body" />
        <ul class="check-list t-body-md mt-8 text-body" {...list(`${k}:signs.items`)}>
          {c.signs.items.map((_: unknown, i: number) => <Text k={`${k}:signs.items.${i}`} as="li" {...item(i)} />)}
        </ul>
        <Text k={`${k}:signs.more`} type="rich" class="t-body-md mt-8 text-body" />
      </div>
      <figure class="photo-plate">
        <Img k={`${k}:signs.image`} loading="lazy" decoding="async" class="aspect-[4/3]" />
        <figcaption>
          <Text k={`${k}:signs.caption`} bare />
          <Fragment set:html={credit(`${k}:signs.image`)} />
        </figcaption>
      </figure>

    </div>
  </section>

  <RelatedServices current="roof-replacement" k={`${k}:related`} />

  <ClosingCta k={`${k}:closingCta`} />
</Page>
