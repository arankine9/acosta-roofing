---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Treeline from "../../components/Treeline.astro";
import EaveDiagram from "../../components/gutters/EaveDiagram.astro";
import { asset } from "../../lib/url";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";
import { site } from "../../data/site";

// Gutter systems: how water should leave the roof (the eave diagram), how
// big the gutter and downspouts need to be, how a seamless run goes up,
// where the water goes after the downspout, gutter guards, and the signs a
// system isn't keeping up.
//
// Photos (public/images/gutters/), all free for commercial use with credit:
// - gutter-running-full-in-rain.jpg: "2015-365-185 Gutter Rain Dance" by
//   Alan Levine (cogdogblog), https://www.flickr.com/photos/cogdogblog/19422570802
//   via Wikimedia Commons. CC BY 2.0.
// - seamless-gutter-machine.jpg: "Seamless aluminum gutter making machine" by
//   pointnshoot, https://www.flickr.com/photos/18244673@N00/362243326. CC BY 2.0.
// - gutter-outlet-and-downspout.jpg: "Upstate New York Seamless Aluminum
//   Gutters 02" by Stilfehler, https://commons.wikimedia.org/wiki/File:Upstate_New_York_Seamless_Aluminum_Gutters_02.jpg.
//   CC BY-SA 4.0.
// - standing-water-in-gutter.jpg: "Gutter clog" by Eric Schmuttenmaer (akeg),
//   https://www.flickr.com/photos/88583398@N00/2529849524. CC BY-SA 2.0.
// All four are resized and recompressed; nothing else is changed.
//
// Sizing figures are industry rules of thumb, phrased as such: a 6" K-style
// carries roughly 40% more than a 5"; about 100 sq ft of roof per square
// inch of downspout opening (2x3 = 6 sq in, 3x4 = 12 sq in); about 1/4" of
// fall per 10 ft of gutter; an inch of rain on 1,000 sq ft is ~620 gallons.
const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
  { label: "Gutter systems", href: serviceHref("gutters") },
];

const schema = {
  "@type": "Service",
  name: "Gutter systems",
  serviceType: "Seamless gutter and downspout installation",
  description:
    "Seamless K-style gutters formed on site, sized downspouts, hidden hangers, drip edge and gutter apron, and downspout extensions, for homes across the Portland metro.",
  provider: { "@type": "RoofingContractor", name: site.legalName, telephone: site.phone },
  areaServed: "Portland metro, Oregon",
};

const legend = [
  {
    title: "Shingle edge",
    body: "The first course overhangs the eave a little, so water drops off the shingle instead of curling back underneath it.",
  },
  {
    title: "Drip edge",
    body: "Metal flashing along the edge of the roof deck. It stiffens the edge, keeps water off the deck and fascia, and turns it downward.",
  },
  {
    title: "Gutter apron",
    body: "A second strip of flashing tucked under the shingles and lapped into the gutter. It closes the gap between roof and gutter, so water ends up in the trough, not on the fascia behind it.",
  },
  {
    title: "Hidden hanger",
    body: "A bracket inside the gutter, screwed through the back into the fascia. Nothing shows from the ground, and a screw holds where an old spike works loose.",
  },
  {
    title: "K-style gutter",
    body: "The flat-backed profile on most houses here. The front lip sits a little lower than the back, so if it ever overflows, it spills out the front, away from the house.",
  },
  {
    title: "Downspout",
    body: "Sized to the roof area feeding it, with elbows that bring it back tight to the wall.",
  },
  {
    title: "Extension",
    body: "Carries the water out onto ground that slopes away from the foundation. A downspout that empties at the wall just moves the problem to the crawlspace.",
  },
  {
    title: "Fascia",
    body: "The board the gutter hangs on. If it's soft, it gets replaced before a new gutter goes up; no hanger holds in rotten wood.",
  },
];

const sizes = [
  {
    name: "5\" K-style gutter",
    carries: "The baseline",
    fits: "Most houses with moderate roof planes and an ordinary pitch.",
    watch: "Fills with needles sooner than a 6\" under firs.",
  },
  {
    name: "6\" K-style gutter",
    carries: "Roughly 40% more water than a 5\"",
    fits: "Big or steep roof planes, long runs, valleys that empty into one spot, heavy tree cover.",
    watch: "Needs a fascia tall enough to carry it. Reads a little heavier on a small house.",
  },
  {
    name: "2×3 downspout",
    carries: "About 6 sq in of opening. Roughly 600 sq ft of roof each.",
    fits: "Short runs and small roof areas on a 5\" gutter.",
    watch: "Needles and fir cones plug it at the outlet and the first elbow.",
  },
  {
    name: "3×4 downspout",
    carries: "About 12 sq in of opening. Roughly twice a 2×3.",
    fits: "6\" gutters, long runs, and anywhere trees drop debris.",
    watch: "Needs a gutter bottom wide enough to take the bigger outlet.",
  },
];

const upsize = [
  {
    title: "Big roof planes draining to one run.",
    body: "The more square feet shedding into a single gutter, the more it has to carry at the peak of a downpour.",
  },
  {
    title: "Steep pitch.",
    body: "Water comes off a steep roof fast enough to shoot past the front of a small gutter. A wider trough catches it.",
  },
  {
    title: "A long valley emptying into one corner.",
    body: "A valley gathers two roof planes into one stream and aims it at a single spot. That corner often needs its own downspout, or a splash guard so water can't jump the lip.",
  },
  {
    title: "Runs longer than about 40 feet.",
    body: "Better pitched both ways to a downspout at each end than asked to carry everything to one.",
  },
  {
    title: "An upper roof draining onto a lower one.",
    body: "A downspout emptying onto shingles wears a stripe down the lower roof. It should run to the lower gutter, or be spread.",
  },
  {
    title: "Firs, cedars and big maples overhead.",
    body: "Bigger outlets and 3×4 downspouts pass the needles and cones that plug a 2×3.",
  },
];

const steps = [
  {
    title: "Measure and plan the outlets",
    body: "Every run is measured, and downspouts go where the water can go somewhere useful, not just where they're easiest to hang.",
  },
  {
    title: "Check the fascia and the roof edge",
    body: "Soft fascia is replaced and missing drip edge or apron is added first. A new gutter on a bad board pulls loose in its first heavy winter.",
  },
  {
    title: "Form each run on site",
    body: "Prefinished aluminum coil runs through a forming machine at the curb, and each run comes off in one length. Corners and end caps are riveted and sealed.",
  },
  {
    title: "Hang it on hidden hangers",
    body: "Roughly every two feet, closer under big trees or where snow and ice slide off the roof. A gutter full of wet needles and slush is heavy.",
  },
  {
    title: "Set the pitch toward the outlet",
    body: "About a quarter inch of fall for every ten feet. Enough to drain, not so much that the gutter visibly tilts along the house.",
  },
  {
    title: "Downspouts, elbows and extensions",
    body: "Strapped tight to the wall, with each one ending somewhere the water can soak in or drain away.",
  },
  {
    title: "Run water through it",
    body: "A hose at the high end of each run shows the pitch and every seam before the job is called done.",
  },
];

const signs = [
  {
    sign: "Water spilling over the front in an ordinary rain",
    means: "A clogged outlet or downspout, or a gutter too small for the roof above it.",
  },
  {
    sign: "Water running down behind the gutter",
    means: "A gap between roof and gutter: no gutter apron, or a drip edge that stops short.",
  },
  {
    sign: "Standing water long after the rain stops",
    means: "The pitch is wrong, or a hanger has let go and made a low spot.",
  },
  {
    sign: "A sagging run, or a gap at the fascia",
    means: "Hangers pulled loose, often from rotten wood or a winter's weight of debris and ice.",
  },
  {
    sign: "Peeling paint or soft wood on the fascia",
    means: "Water has been getting behind the gutter for a while. The rafter tails are next.",
  },
  {
    sign: "Drip lines and water stains on the siding",
    means: "Overflow, or a leaking seam or corner, usually at the same spot every storm.",
  },
  {
    sign: "A trench worn in the bed under the eave",
    means: "Water is coming over the edge instead of down the downspout.",
  },
  {
    sign: "A damp basement or crawlspace, or puddles by the foundation",
    means: "Downspouts emptying too close to the house, or an underground line that's broken or plugged.",
  },
];
---

<Page
  title="Gutter systems"
  description={`Seamless gutters formed on site, 5" and 6" K-style sizing, 2×3 and 3×4 downspouts, hidden hangers, drip edge and gutter apron, for homes across the Portland metro. From ${site.name} in Beaverton.`}
  crumbs={crumbs}
  schema={schema}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Residential"
    title="Gutter systems"
    lead="Seamless gutters and downspouts sized for the rain we actually get, pitched to drain and hung to carry a winter's load. The job is simple: take the water off the roof and put it somewhere that isn't your foundation."
    image="/images/gutters/gutter-running-full-in-rain.jpg"
    imageAlt="A white K-style gutter running full in a heavy rain, with water sheeting off the roof edge into it and conifers behind"
    imageCaption="A gutter running full in a downpour. Sized right and kept clear, it carries every drop to the downspout."
    treelineOffset={-410}
  />

  {/* 1. The water path: the eave section with its legend. */}
  <section id="water-path" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <h2 class="t-display-lg text-balance text-ink">Where the water should go</h2>
        <p class="t-body-md max-w-xl text-body">
          A gutter is the last few inches of the roof. Most of the gutter
          problems we're called out for are water getting behind the gutter,
          spilling over it, or landing next to the foundation. This is the path
          it should take instead.
        </p>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
        <figure class="m-0 lg:sticky lg:top-28 lg:self-start">
          <div class="panel panel-keyline p-4 sm:p-6">
            <EaveDiagram class="mx-auto block h-auto w-full max-w-[560px]" />
          </div>
          <figcaption class="t-caption mt-3 border-t border-hairline pt-3 text-mute">
            Section through an eave, with the drop from gutter to ground shortened at the break.
          </figcaption>
        </figure>

        <ol class="border-t border-hairline">
          {
            legend.map((item, index) => (
              <li class="grid grid-cols-[30px_minmax(0,1fr)] gap-x-4 border-b border-hairline py-4">
                <span
                  class="flex size-[30px] items-center justify-center bg-forest font-display text-[17px] leading-none font-bold text-cream"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <div>
                  <h3 class="t-heading-sm text-ink">
                    <span class="sr-only">{index + 1}. </span>
                    {item.title}
                  </h3>
                  <p class="t-body-sm mt-1 text-body">{item.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* 2. Sizing. Extra bottom padding: the forest band's treeline stands into it. */}
  <section id="sizing" class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <h2 class="t-display-lg text-balance text-ink">Five inches or six</h2>
        <p class="t-body-md max-w-xl text-body">
          Most houses in the Portland metro carry a 5" or 6" K-style gutter
          with 2×3 or 3×4 downspouts. The right pair depends on how much roof
          drains to each run, how steep it is, and what's growing over it.
        </p>
      </div>

      <div class="table-scroll mt-10">
        <table class="data-table min-w-[720px]">
          <caption class="sr-only">Gutter and downspout sizes compared</caption>
          <thead>
            <tr>
              <th scope="col" class="w-[18%]">Size</th>
              <th scope="col" class="w-[24%]">Carries</th>
              <th scope="col">Usually right for</th>
              <th scope="col">Watch for</th>
            </tr>
          </thead>
          <tbody>
            {
              sizes.map((row) => (
                <tr>
                  <th scope="row">{row.name}</th>
                  <td>{row.carries}</td>
                  <td>{row.fits}</td>
                  <td>{row.watch}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="t-caption mt-3 max-w-3xl text-mute">
        Rules of thumb, not a calculation. The real answer depends on the roof
        area feeding each outlet, the pitch, and how hard it rains in a short
        burst. We measure each run before recommending a size.
      </p>

      <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
        <div>
          <h3 class="t-heading-xl text-ink">When to go bigger, or add a downspout</h3>
          <ul class="mt-6 border-t border-hairline">
            {
              upsize.map((item) => (
                <li class="border-b border-hairline py-4">
                  <p class="t-body-md text-body">
                    <strong class="font-semibold text-ink">{item.title}</strong> {item.body}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
        <figure class="photo-plate lg:pt-2">
          <img
            src={asset("/images/gutters/gutter-outlet-and-downspout.jpg")}
            alt="Close view of a white seamless gutter at a house corner, with the outlet dropping into two elbows and a downspout held against the wall"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3]"
          />
          <figcaption>
            Outlet, elbows and downspout on a seamless run. Debris stops at the
            outlet first, so its size matters as much as the gutter's.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* 3. Forest band: how a seamless run goes up. */}
  <section id="install" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-260} class="absolute inset-x-0 bottom-full" />
    <div class="container-page pt-20 pb-36 md:pt-24 md:pb-40">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <div>
          <p class="t-eyebrow text-on-forest-mute">Seamless, formed on site</p>
          <h2 class="t-display-lg mt-4 text-balance">How a gutter run goes up</h2>
          <p class="t-lead mt-5 max-w-2xl text-on-forest-mute">
            A seamless gutter is formed from a coil of aluminum at your house
            and cut to the length of each run. The only joints are where they
            have to be: corners, end caps and outlets. Fewer joints, fewer
            places to drip.
          </p>

          <ol class="step-list mt-10">
            {
              steps.map((step) => (
                <li>
                  <h3 class="t-heading-md">{step.title}</h3>
                  <p class="t-body-md text-on-forest-mute">{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <aside class="lg:pt-[140px]">
          <div class="lg:sticky lg:top-28">
            <figure class="photo-plate">
              <img
                src={asset("/images/gutters/seamless-gutter-machine.jpg")}
                alt="A gutter installer at a trailer-mounted seamless gutter machine parked on a residential street, with coils of aluminum on the trailer"
                loading="lazy"
                decoding="async"
                class="aspect-[3/2]"
              />
              <figcaption>
                A seamless gutter machine on a trailer at the curb. Coil goes in
                one end; a finished run comes out the other.
              </figcaption>
            </figure>
            <dl class="mt-8 grid grid-cols-2 border-t border-hairline-dark">
              <div class="border-r border-b border-hairline-dark py-5 pr-4">
                <dt class="t-spaced-sm text-on-forest-mute">Hidden hangers</dt>
                <dd class="t-heading-md mt-2">Every 2 ft</dd>
              </div>
              <div class="border-b border-hairline-dark py-5 pl-4">
                <dt class="t-spaced-sm text-on-forest-mute">Fall</dt>
                <dd class="t-heading-md mt-2">¼" per 10 ft</dd>
              </div>
              <div class="border-r border-b border-hairline-dark py-5 pr-4">
                <dt class="t-spaced-sm text-on-forest-mute">K-style gutter</dt>
                <dd class="t-heading-md mt-2">5" or 6"</dd>
              </div>
              <div class="border-b border-hairline-dark py-5 pl-4">
                <dt class="t-spaced-sm text-on-forest-mute">Downspouts</dt>
                <dd class="t-heading-md mt-2">2×3 or 3×4</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
    <Treeline tone="cream" height={64} offset={-40} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 4. After the downspout, and gutter guards. */}
  <section id="discharge" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <div>
          <h2 class="t-display-lg text-balance text-ink">Get the water away from the house</h2>
          <div class="prose-page mt-6">
          <p>
            An inch of rain on 1,000 square feet of roof is about 620 gallons,
            and all of it comes out of the downspouts. Where they empty matters
            as much as the gutter. Water dumped at the wall soaks down beside
            the footing, and that's how crawlspaces and basements get damp.
          </p>
          <ul>
            <li>
              <strong>Extensions or splash blocks</strong> carry water several
              feet out, 4 to 6 is a common target, onto ground that slopes away
              from the house.
            </li>
            <li>
              <strong>Downspouts go where the yard can take the water:</strong>
              not onto a walkway that ices over, not toward the neighbor's
              side, not into a bed that already stays wet.
            </li>
            <li>
              <strong>Many older houses here have downspouts that run into a
              pipe in the ground,</strong> to a drywell, a drain line or the
              sewer. Whether to keep, repair or disconnect one depends on the
              property and on what the city or county allows. We'll look at
              where yours go and check what applies before recommending
              anything.
            </li>
          </ul>
          <p>
            Clearing is part of it too. Under Douglas firs, a gutter can need
            attention more than once between October and spring. Our
            <a href={serviceHref("roof-maintenance")}>roof maintenance</a> page
            has a seasonal calendar.
          </p>
          </div>
        </div>

        <aside class="lg:pt-3">
          <div class="panel panel-keyline overflow-hidden">
            <div class="plate-label">
              <span class="t-spaced">Gutter guards, honestly</span>
            </div>
            <div class="px-6 py-8 sm:px-8">
              <p class="t-heading-md text-ink">They cut down how often a gutter needs clearing. They don't end it.</p>
              <ul class="t-body-sm mt-6 border-t border-hairline text-body [&>li]:border-b [&>li]:border-hairline [&>li]:py-3">
                <li>Screens and micro-mesh keep leaves and cones out of the trough, which is most of the battle under maples and oaks.</li>
                <li>Fir needles are the hard case. They slip through coarse screens, and on fine mesh they mat on top and hold water. Moss can start on the mat.</li>
                <li>A guard still needs brushing off, often once or twice a year under firs, and it makes the gutter harder to clean when something does get in.</li>
                <li>Solid hood guards that curl water around a rounded nose can shed it straight over the edge in a hard rain.</li>
                <li>No guard fixes a gutter that's too small, pitched wrong, or draining to the wrong place.</li>
              </ul>
              <p class="t-body-sm mt-5 text-body">
                If a guard makes sense for your trees, we'll say so, and tell
                you what it won't do.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* 5. Signs of trouble. */}
  <section id="signs" class="section bg-cream-deep">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div>
          <h2 class="t-display-lg text-balance text-ink">Signs your gutters aren't keeping up</h2>
          <p class="t-body-md mt-5 max-w-xl text-body">
            Most of these show up from the ground, and the best time to look
            is during a real rain. Stand under the eaves with a coat on and
            watch where the water goes.
          </p>
          <figure class="photo-plate mt-10">
            <img
              src={asset("/images/gutters/standing-water-in-gutter.jpg")}
              alt="Looking along a white gutter under gray asphalt shingles, with leaves floating in standing water"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3]"
            />
            <figcaption>
              Leaves floating in a gutter that isn't draining. Water that sits
              in the trough means the pitch is off or a hanger has let go.
            </figcaption>
          </figure>
        </div>

        <dl class="border-t border-hairline lg:mt-2">
          {
            signs.map((item) => (
              <div class="grid gap-2 border-b border-hairline py-5 sm:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] sm:gap-8">
                <dt class="t-heading-sm text-ink">{item.sign}</dt>
                <dd class="t-body-sm text-body">{item.means}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <RelatedServices current="gutters" surface="canvas" />

  <ClosingCta
    title="Get your gutters looked at"
    body="We'll walk the eaves, check the fascia and the downspouts, and tell you whether it's a cleaning, a repair or a new system. The estimate is free and written down."
  />
</Page>
