---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Treeline from "../../components/Treeline.astro";
import EaveDiagram from "../../components/gutters/EaveDiagram.astro";
import Text from "../../components/Text.astro";
import Img from "../../components/Img.astro";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";
import { site } from "../../data/site";
import { file, list, item } from "../../lib/cms";

// Gutter systems: how water should leave the roof (the eave diagram), how
// big the gutter and downspouts need to be, how a seamless run goes up,
// where the water goes after the downspout, gutter guards, and the signs a
// system isn't keeping up.
//
// Photos (public/images/gutters/), all free for commercial use with credit:
// - gutter-running-full-in-rain.jpg: "2015-365-185 Gutter Rain Dance" by
//   Alan Levine (cogdogblog), https://www.flickr.com/photos/cogdogblog/19422570802
//   via Wikimedia Commons. CC BY 2.0.
// - seamless-gutter-machine.jpg: "Seamless aluminum gutter making machine" by
//   pointnshoot, https://www.flickr.com/photos/18244673@N00/362243326. CC BY 2.0.
// - gutter-outlet-and-downspout.jpg: "Upstate New York Seamless Aluminum
//   Gutters 02" by Stilfehler, https://commons.wikimedia.org/wiki/File:Upstate_New_York_Seamless_Aluminum_Gutters_02.jpg.
//   CC BY-SA 4.0.
// - standing-water-in-gutter.jpg: "Gutter clog" by Eric Schmuttenmaer (akeg),
//   https://www.flickr.com/photos/88583398@N00/2529849524. CC BY-SA 2.0.
// All four are resized and recompressed; nothing else is changed.
//
// Sizing figures are industry rules of thumb, phrased as such: a 6" K-style
// carries roughly 40% more than a 5"; about 100 sq ft of roof per square
// inch of downspout opening (2x3 = 6 sq in, 3x4 = 12 sq in); about 1/4" of
// fall per 10 ft of gutter; an inch of rain on 1,000 sq ft is ~620 gallons.
const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
  { label: "Gutter systems", href: serviceHref("gutters") },
];

const schema = {
  "@type": "Service",
  name: "Gutter systems",
  serviceType: "Seamless gutter and downspout installation",
  description:
    "Seamless K-style gutters formed on site, sized downspouts, hidden hangers, drip edge and gutter apron, and downspout extensions, for homes across the Portland metro.",
  provider: { "@type": "RoofingContractor", name: site.legalName, telephone: site.phone },
  areaServed: "Portland metro, Oregon",
};

// Every word on this page is in src/content/pages/services-gutters.json;
// `k` is the key prefix into it and `c` its parsed content, for the lists.
const k = "pages/services-gutters";
const c = file(k);
---

<Page k={k} crumbs={crumbs} schema={schema}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-410} />

  {/* 1. The water path: the eave section with its legend. The legend is
      numbered to match the drawing, so it is a fixed set of eight. */}
  <section id="water-path" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:waterPath.title`} as="h2" class="t-display-lg text-balance text-ink" />
        <Text k={`${k}:waterPath.intro`} class="t-body-md max-w-xl text-body" />
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
        <figure class="m-0 lg:sticky lg:top-28 lg:self-start">
          <div class="panel panel-keyline p-4 sm:p-6">
            <EaveDiagram class="mx-auto block h-auto w-full max-w-[560px]" />
          </div>
          <Text k={`${k}:waterPath.caption`} as="figcaption" class="t-caption mt-3 border-t border-hairline pt-3 text-mute" />
        </figure>

        <ol class="border-t border-hairline">
          {
            c.waterPath.legend.map((_: unknown, index: number) => (
              <li class="grid grid-cols-[30px_minmax(0,1fr)] gap-x-4 border-b border-hairline py-4">
                <span
                  class="flex size-[30px] items-center justify-center bg-forest font-display text-[17px] leading-none font-bold text-cream"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <div>
                  <h3 class="t-heading-sm text-ink">
                    <span class="sr-only">{index + 1}. </span>
                    <Text k={`${k}:waterPath.legend.${index}.title`} bare />
                  </h3>
                  <Text k={`${k}:waterPath.legend.${index}.body`} class="t-body-sm mt-1 text-body" />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* 2. Sizing. Extra bottom padding: the forest band's treeline stands into it. */}
  <section id="sizing" class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:sizing.title`} as="h2" class="t-display-lg text-balance text-ink" />
        <Text k={`${k}:sizing.intro`} class="t-body-md max-w-xl text-body" />
      </div>

      <div class="table-scroll mt-10" tabindex="0" role="region" aria-label="Gutter and downspout sizes compared">
        <table class="data-table min-w-[720px]">
          <caption class="sr-only">Gutter and downspout sizes compared</caption>
          <thead>
            <tr>
              <Text k={`${k}:sizing.table.name`} as="th" scope="col" class="w-[18%]" />
              <Text k={`${k}:sizing.table.carries`} as="th" scope="col" class="w-[24%]" />
              <Text k={`${k}:sizing.table.fits`} as="th" scope="col" />
              <Text k={`${k}:sizing.table.watch`} as="th" scope="col" />
            </tr>
          </thead>
          <tbody {...list(`${k}:sizing.table.rows`)}>
            {
              c.sizing.table.rows.map((_: unknown, i: number) => (
                <tr {...item(i)}>
                  <Text k={`${k}:sizing.table.rows.${i}.name`} as="th" scope="row" />
                  <Text k={`${k}:sizing.table.rows.${i}.carries`} as="td" />
                  <Text k={`${k}:sizing.table.rows.${i}.fits`} as="td" />
                  <Text k={`${k}:sizing.table.rows.${i}.watch`} as="td" />
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <Text k={`${k}:sizing.note`} class="t-caption mt-3 max-w-3xl text-mute" />

      <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
        <div>
          <Text k={`${k}:sizing.upsize.title`} as="h3" class="t-heading-xl text-ink" />
          <ul class="mt-6 border-t border-hairline" {...list(`${k}:sizing.upsize.items`)}>
            {
              c.sizing.upsize.items.map((_: unknown, i: number) => (
                <li class="border-b border-hairline py-4" {...item(i)}>
                  <p class="t-body-md text-body">
                    <strong class="font-semibold text-ink"><Text k={`${k}:sizing.upsize.items.${i}.title`} bare /></strong> <Text k={`${k}:sizing.upsize.items.${i}.body`} bare />
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
        <figure class="photo-plate lg:pt-2">
          <Img k={`${k}:sizing.image`} loading="lazy" decoding="async" class="aspect-[4/3]" />
          <Text k={`${k}:sizing.caption`} as="figcaption" />
        </figure>
      </div>
    </div>
  </section>

  {/* 3. Forest band: how a seamless run goes up. */}
  <section id="install" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-260} class="absolute inset-x-0 bottom-full" />
    <div class="container-page pt-20 pb-36 md:pt-24 md:pb-40">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <div>
          <Text k={`${k}:install.eyebrow`} class="t-eyebrow text-on-forest-mute" />
          <Text k={`${k}:install.title`} as="h2" class="t-display-lg mt-4 text-balance" />
          <Text k={`${k}:install.lead`} class="t-lead mt-5 max-w-2xl text-on-forest-mute" />

          <ol class="step-list mt-10" {...list(`${k}:install.steps`)}>
            {
              c.install.steps.map((_: unknown, i: number) => (
                <li {...item(i)}>
                  <Text k={`${k}:install.steps.${i}.title`} as="h3" class="t-heading-md" />
                  <Text k={`${k}:install.steps.${i}.body`} class="t-body-md text-on-forest-mute" />
                </li>
              ))
            }
          </ol>
        </div>

        <aside class="lg:pt-[140px]">
          <div class="lg:sticky lg:top-28">
            <figure class="photo-plate">
              <Img k={`${k}:install.image`} loading="lazy" decoding="async" class="aspect-[3/2]" />
              <Text k={`${k}:install.caption`} as="figcaption" />
            </figure>
            {/* A fixed two-by-two: the rules between cells follow the column. */}
            <dl class="mt-8 grid grid-cols-2 border-t border-hairline-dark">
              {
                c.install.facts.map((_: unknown, i: number) => (
                  <div class={i % 2 === 0 ? "border-r border-b border-hairline-dark py-5 pr-4" : "border-b border-hairline-dark py-5 pl-4"}>
                    <Text k={`${k}:install.facts.${i}.label`} as="dt" class="t-spaced-sm text-on-forest-mute" />
                    <Text k={`${k}:install.facts.${i}.value`} as="dd" class="t-heading-md mt-2" />
                  </div>
                ))
              }
            </dl>
          </div>
        </aside>
      </div>
    </div>
    <Treeline tone="cream" height={64} offset={-40} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 4. After the downspout, and gutter guards. */}
  <section id="discharge" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
        <div>
          <Text k={`${k}:discharge.title`} as="h2" class="t-display-lg text-balance text-ink" />
          <Text k={`${k}:discharge.body`} type="block" as="div" class="prose-page mt-6" />
        </div>

        <aside class="lg:pt-3">
          <div class="panel panel-keyline overflow-hidden">
            <div class="plate-label">
              <Text k={`${k}:discharge.guards.label`} as="span" class="t-spaced" />
            </div>
            <div class="px-6 py-8 sm:px-8">
              <Text k={`${k}:discharge.guards.title`} class="t-heading-md text-ink" />
              <ul class="t-body-sm mt-6 border-t border-hairline text-body [&>li]:border-b [&>li]:border-hairline [&>li]:py-3" {...list(`${k}:discharge.guards.items`)}>
                {c.discharge.guards.items.map((_: unknown, i: number) => <Text k={`${k}:discharge.guards.items.${i}`} as="li" {...item(i)} />)}
              </ul>
              <Text k={`${k}:discharge.guards.note`} class="t-body-sm mt-5 text-body" />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* 5. Signs of trouble. */}
  <section id="signs" class="section bg-cream-deep">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div>
          <Text k={`${k}:signs.title`} as="h2" class="t-display-lg text-balance text-ink" />
          <Text k={`${k}:signs.intro`} class="t-body-md mt-5 max-w-xl text-body" />
          <figure class="photo-plate mt-10">
            <Img k={`${k}:signs.image`} loading="lazy" decoding="async" class="aspect-[4/3]" />
            <Text k={`${k}:signs.caption`} as="figcaption" />
          </figure>
        </div>

        <dl class="border-t border-hairline lg:mt-2" {...list(`${k}:signs.items`)}>
          {
            c.signs.items.map((_: unknown, i: number) => (
              <div class="grid gap-2 border-b border-hairline py-5 sm:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] sm:gap-8" {...item(i)}>
                <Text k={`${k}:signs.items.${i}.sign`} as="dt" class="t-heading-sm text-ink" />
                <Text k={`${k}:signs.items.${i}.means`} as="dd" class="t-body-sm text-body" />
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <RelatedServices current="gutters" k={`${k}:related`} surface="canvas" />

  <ClosingCta k={`${k}:closingCta`} />
</Page>
