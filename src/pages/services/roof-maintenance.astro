---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Treeline from "../../components/Treeline.astro";
import { asset } from "../../lib/url";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";
import { site } from "../../data/site";

// Roof maintenance: the Portland case for it. Moss and lichen (why they grow,
// what they do, how they come off without damaging the roof), debris and the
// places water backs up, a real inspection checklist, a seasonal calendar
// with rough intervals, and what the homeowner gets back after a visit.
// There is no maintenance plan or package; intervals are general guidance.
//
// Photos (public/images/roof-maintenance/), all free for commercial use with
// credit:
// - moss-shingle-roof-skylight.jpg: "Moss on roof" by Jay Pscheidt, Oregon
//   State University Extension Service,
//   https://www.flickr.com/photos/oregonstateuniversity/49527862622. CC BY-SA 2.0.
// - moss-in-shingle-keyways.jpg: "Roof before treatment" by Joey (jchaven),
//   https://www.flickr.com/photos/88201963@N00/54048044054. CC BY 2.0.
// - moss-on-shingles-close.jpg: "Nature vs. Roof" by GollyGforce,
//   https://www.flickr.com/photos/20581458@N00/14654053753. CC BY 2.0.
// All three are resized and recompressed; nothing else is changed.
const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
  { label: "Roof maintenance", href: serviceHref("roof-maintenance") },
];

const schema = {
  "@type": "Service",
  name: "Roof maintenance",
  serviceType: "Roof maintenance, moss treatment and roof inspection",
  description:
    "Moss removal and treatment, debris and gutter clearing, and a close roof and attic inspection with photos and written findings, for homes across the Portland metro.",
  provider: { "@type": "RoofingContractor", name: site.legalName, telephone: site.phone },
  areaServed: "Portland metro, Oregon",
};

const debris = [
  {
    title: "Valleys",
    body: "Where two slopes meet, a valley carries the water of both. A dam of needles pushes that water sideways, under the shingles along the valley's edges.",
  },
  {
    title: "Behind chimneys",
    body: "The uphill side of a chimney is a pocket. Debris piles against it, water pools, and the flashing there sits under water every storm. A wide chimney should have a cricket, a small peaked saddle that splits the flow around it.",
  },
  {
    title: "Above skylights and at walls",
    body: "The same thing on a smaller scale. Anything that interrupts the flow down the roof collects whatever is coming down with it.",
  },
  {
    title: "Gutters and downspouts",
    body: "Where everything ends up. A plugged outlet turns the gutter into a trough that spills over the front, or behind it onto the fascia.",
  },
];

const inspection = [
  {
    title: "On the roof",
    items: [
      ["Pipe boots", "The rubber collars around plumbing vents crack with sun and age. A split boot sends water straight down the pipe."],
      ["Flashing", "Step and counter flashing at walls and chimneys: lifted, rusted, or patched with caulk where there should be metal."],
      ["Sealant", "Dried out, cracked, or shrunk away from flashing edges and exposed nail heads."],
      ["Nail pops", "Nails backing out and pushing up the shingle above them. Each one is a hole waiting to open."],
      ["Granule loss", "Bare patches on the shingles and granules piling up in the gutters, the clearest sign of an aging roof."],
      ["Ridge caps", "Cracked, lifted or missing. They take the wind first, and an east wind finds the loose ones."],
      ["Valleys", "Debris dams, worn shingles, and nails showing where they shouldn't."],
      ["Skylights", "The flashing kit, the seals, and debris packed against the uphill side."],
    ],
  },
  {
    title: "At the edges",
    items: [
      ["Drip edge and apron", "Present, fastened, and sending water into the gutter rather than behind it."],
      ["Gutters and downspouts", "Clear, pitched to drain, hangers tight, outlets open."],
      ["Fascia and soffit", "Soft wood, peeling paint, and gaps where birds and squirrels get in."],
      ["Branches", "Anything touching the roof, rubbing it in the wind, or hanging over it."],
    ],
  },
  {
    title: "In the attic",
    items: [
      ["Daylight", "Light through the deck, around pipes, vents and the chimney."],
      ["Damp or stained sheathing", "Dark rings on the underside of the deck, especially around penetrations."],
      ["Frost or mold", "On nail tips and sheathing in winter: warm, moist house air collecting where it can't get out."],
      ["Ventilation", "Soffit vents open and not buried in insulation, roof or ridge vents clear, and bath and kitchen fans ducted outside, not into the attic."],
      ["Insulation", "Wet, matted or pushed out of place."],
    ],
  },
];

const seasons = [
  {
    name: "Fall",
    months: "September – November",
    weather: "The rain comes back, usually by mid-October. Firs, cedars and maples drop needles, cones and leaves onto every roof under them.",
    todo: "Clear gutters, valleys and the uphill side of chimneys once the leaves are down. A full inspection, roof and attic.",
    why: "Anything found now gets fixed before six months of rain find it first.",
  },
  {
    name: "Winter",
    months: "December – February",
    weather: "Long wet stretches, wind-driven rain, the odd east wind out of the Gorge, and now and then an ice storm or snow.",
    todo: "After a big storm, look from the ground: missing or lifted shingles, a ridge cap out of line, branches on the roof, a gutter pulled away. Check ceilings and the attic for new stains.",
    why: "Winter is for catching problems and keeping water out. Temporary dry-in may be possible, depending on the situation, until the weather allows a proper repair.",
  },
  {
    name: "Spring",
    months: "March – May",
    weather: "Still damp and warming up. Moss is at its greenest and growing fastest, and the trees shed pollen, catkins and cones.",
    todo: "Moss removal and treatment. Clear the gutters again after the spring drop, and look over what winter left behind.",
    why: "Treatments work best on moss that's actively growing, and they want a dry day or two after they go on. Spring has both.",
  },
  {
    name: "Summer",
    months: "June – August",
    weather: "The dry window. Weeks without rain, and warm enough for sealants to cure and new shingles to seal down.",
    todo: "Repairs, flashing and sealant work, and anything bigger: replacement, skylights, new gutters. Cut back branches over the roof.",
    why: "Work done dry doesn't have to wait on a forecast, and it's done before the rain comes back to test it.",
  },
];

const intervals = [
  ["Inspection", "Once a year, in fall", "Once a year, plus after big storms"],
  ["Gutter and valley clearing", "Once a year, late fall", "Two or three times, fall into winter"],
  ["Moss treatment", "Every few years, or when it shows", "Every year or two, north slopes first"],
  ["A look from the ground", "After any big wind or ice storm", "After any big wind or ice storm"],
];

const tiers = [
  {
    label: "Fix now",
    body: "Anything letting water in or about to: a split pipe boot, lifted flashing, missing shingles, a valley that's dammed.",
  },
  {
    label: "Before next winter",
    body: "Wear that won't leak this month but will: dried sealant, a few nail pops, moss starting to lift edges, a gutter that holds water.",
  },
  {
    label: "Keep an eye on",
    body: "Normal aging worth tracking year to year: granule loss on the south slope, lichen, ridge caps getting brittle.",
  },
];

// The calendar rows, in the order each season lists them.
const calendarRows = ["The weather", "On the roof", "Why then"] as const;
// Side padding inside the ruled columns; the outer columns sit flush with
// the container edge.
const pad = (index: number) =>
  index === 0 ? "lg:pr-6" : index === seasons.length - 1 ? "lg:pl-6" : "lg:px-6";
---

<Page
  title="Roof maintenance"
  description="Moss removal and treatment without pressure washing, needle and debris clearing, gutter cleaning, and a close roof and attic inspection with photos and written findings. A seasonal guide for Portland metro roofs from Acosta Roofing."
  crumbs={crumbs}
  schema={schema}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Residential"
    title="Roof maintenance"
    lead="Most roofs in the Portland metro don't wear out from age alone. They go early where moss holds water against the shingles, where needles dam a valley, and where a pipe boot cracked two winters ago and nobody looked. Maintenance is how you find those first."
    image="/images/roof-maintenance/moss-shingle-roof-skylight.jpg"
    imageAlt="Moss growing in rows along the courses of a shingle roof, around a skylight and two roof vents, with fir branches overhead"
    imageCaption="Moss working along the courses of an Oregon shingle roof, around a skylight and two vents. Every one of those is a place water can get in."
    treelineOffset={-150}
  />

  {/* 1. Moss and lichen: long-form prose with a sticky photo rail. */}
  <section id="moss" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div>
          <p class="t-eyebrow text-mute">Moss and lichen</p>
          <h2 class="t-display-lg mt-4 text-balance text-ink">Why moss wins on a Portland roof</h2>
          <div class="prose-page mt-8">
          <h3>Why it grows where it grows</h3>
          <p>
            Moss needs shade, moisture and something to root in, and a roof
            here supplies all three from October to May. North-facing slopes
            get almost no direct sun in winter and stay wet for days after a
            rain. Roofs under firs and big maples stay shaded year round, and
            the needles and leaves that settle in the gaps between shingles
            break down into the grit moss starts in.
          </p>

          <h3>What it does to shingles</h3>
          <p>
            Moss starts in the gaps between shingles and along the lower
            edges. As the cushion thickens it lifts the edge of the shingle
            above it, which breaks the seal strip and lets wind get under
            it. The cushion also holds water like a sponge, right on
            the shingle, through every rain. Water wicks sideways and up under
            the laps, where a shingle was never meant to be wet, and when it
            freezes it pries a little further. Over a few winters, that's how a
            roof with years left in it starts leaking early.
          </p>
          <p>
            The clumps that break loose wash into the gutters and settle at the
            outlets, which is why a mossy roof usually comes with plugged
            downspouts.
          </p>

          <h3>Why we don't pressure wash</h3>
          <p>
            It's fast and it looks clean. It also strips the granules that
            shield the asphalt from the sun, drives water up under the laps,
            and can break the seal strips holding the shingles down. Most shingle
            manufacturers warn against it. A pressure-washed roof can look new
            for a season and have given up a good share of its life to get
            there.
          </p>

          <h3>How it comes off instead</h3>
          <ol>
            <li>
              <strong>Loose debris first,</strong> by hand and blower, working
              from the ridge down.
            </li>
            <li>
              <strong>Thick moss by hand,</strong> with brushes and plastic
              scrapers, always pushing down the slope with the shingles, never
              prying up against an edge.
            </li>
            <li>
              <strong>Treatment on what's left,</strong> using a moss treatment
              labeled for roofs, applied with dry weather ahead. It kills what's
              rooted between the shingles, and the dead moss lets go and washes off
              over the next few weeks of rain. The roof won't look finished the
              day we leave; it gets there.
            </li>
            <li>
              <strong>Gutters and downspouts last,</strong> since that's where
              everything ends up.
            </li>
          </ol>
          <p>
            Zinc or copper strips near the ridge can slow regrowth, as rain
            carries a trace of metal down the roof. They help most on open
            slopes and don't replace clearing on a roof under trees. Cutting
            back overhanging branches often does more than any product: light
            and moving air dry the roof out.
          </p>

          <h3>Lichen is different</h3>
          <p>
            Lichen is the crusty gray-green or orange patches. It grips the
            granules hard, and scraping it off takes the granules with it. We
            treat it and let it weather away rather than force it.
          </p>
          </div>
        </div>

        <aside>
          <div class="flex flex-col gap-10 lg:sticky lg:top-28">
            <figure class="photo-plate">
              <img
                src={asset("/images/roof-maintenance/moss-in-shingle-keyways.jpg")}
                alt="Low view across an asphalt shingle roof with small tufts of moss growing between the shingles and along their edges"
                loading="lazy"
                decoding="async"
                class="aspect-[3/2]"
              />
              <figcaption>
                Moss starting between the shingles. This is the stage to treat
                it, before it lifts the edges.
              </figcaption>
            </figure>
            <figure class="photo-plate">
              <img
                src={asset("/images/roof-maintenance/moss-on-shingles-close.jpg")}
                alt="Close view of a shingle roof covered in a thick green cushion of moss, with needles and twigs caught in it"
                loading="lazy"
                decoding="async"
                class="aspect-[3/2]"
              />
              <figcaption>
                A full cushion, with needles caught in it. By now it holds water
                against the shingles through every rain.
              </figcaption>
            </figure>
            <div class="border-y border-hairline py-6">
              <p class="t-spaced-sm text-mute">What we don't do</p>
              <ul class="t-body-sm mt-4 space-y-2 text-body">
                <li>Pressure wash a shingle roof.</li>
                <li>Scrape lichen off by force.</li>
                <li>Walk a roof that's soaked, frosted or slick with moss when it can wait for a dry day.</li>
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* 2. Debris. Extra bottom padding: the forest band's treeline stands into it. */}
  <section id="debris" class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <h2 class="t-display-lg text-balance text-ink">Needles, debris and the places water backs up</h2>
        <p class="t-body-md max-w-xl text-body">
          Douglas firs drop needles all year, and heaviest in fall. One needle
          is nothing. A season of them mats into a sponge that holds water,
          dams it, and composts into the soil moss grows in. It collects in the
          same four places on almost every roof.
        </p>
      </div>

      <ul class="mt-12 grid border-t border-hairline sm:grid-cols-2">
        {
          debris.map((item, index) => (
            <li
              class:list={[
                "border-b border-hairline py-8",
                index % 2 === 0 ? "sm:border-r sm:pr-10" : "sm:pl-10",
              ]}
            >
              <p class="t-spaced-sm text-mute">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="t-heading-md mt-3 text-ink">{item.title}</h3>
              <p class="t-body-md mt-3 max-w-lg text-body">{item.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-12 grid gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16">
        <h3 class="t-heading-xl text-balance text-ink">Clearing is part of every visit</h3>
        <div>
          <p class="t-body-md max-w-2xl text-body">
            Valleys, chimney backs and skylight curbs are cleared by hand.
            Gutters are emptied, downspouts flushed to make sure they run, and
            outlets and extensions checked. If a gutter needs more than a clean, because
            it sags, holds water or spills behind, the findings say so.
          </p>
          <a href={serviceHref("gutters")} class="link-inline mt-4 inline-block">How gutters should be sized and hung</a>
        </div>
      </div>
    </div>
  </section>

  {/* 3. Forest band: the inspection checklist. */}
  <section id="inspection" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-330} class="absolute inset-x-0 bottom-full" />
    <div class="container-page pt-20 pb-36 md:pt-24 md:pb-40">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <div>
          <p class="t-eyebrow text-on-forest-mute">The inspection</p>
          <h2 class="t-display-lg mt-4 text-balance">What we check, roof to attic</h2>
        </div>
        <p class="t-lead max-w-xl text-on-forest-mute">
          Most leaks start at a detail, not in the middle of a slope. This is
          the list we walk, and every item on it gets a look, not just the ones
          that are easy to reach.
        </p>
      </div>

      <div class="mt-12 grid border-t border-hairline-dark lg:grid-cols-3">
        {
          inspection.map((group, index) => (
            <div
              class:list={[
                "border-b border-hairline-dark py-8 lg:border-b-0",
                index > 0 && "lg:border-l lg:pl-8",
                index < inspection.length - 1 && "lg:pr-8",
              ]}
            >
              <h3 class="t-heading-md">{group.title}</h3>
              <ul class="check-list mt-6">
                {group.items.map(([name, note]) => (
                  <li class="t-body-sm text-on-forest-mute">
                    <strong class="font-semibold text-on-forest">{name}.</strong> {note}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <Treeline tone="cream" height={64} offset={-90} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 4. The seasonal calendar and rough intervals. */}
  <section id="calendar" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <h2 class="t-display-lg text-balance text-ink">A year on a Northwest roof</h2>
        <p class="t-body-md max-w-xl text-body">
          The weather sets the schedule. Clear and inspect before the rain,
          look again after the storms, treat moss while it's growing, and save
          real repairs for the dry months.
        </p>
      </div>

      {/* Four seasons as ruled columns. From 1024px each column is a subgrid,
          so the three rows line up across all four seasons. */}
      <ol class="mt-12 grid border-t-2 border-forest lg:grid-cols-4 lg:grid-rows-[auto_repeat(3,auto)]">
        {
          seasons.map((season, index) => (
            <li
              class:list={[
                "grid border-b border-hairline lg:row-span-4 lg:grid-rows-subgrid lg:border-b-0",
                index > 0 && "lg:border-l lg:border-hairline",
              ]}
            >
              <div class:list={["pt-6 pb-5", pad(index)]}>
                <h3 class="t-display-lg leading-none text-ink">{season.name}</h3>
                <p class="t-spaced-sm mt-3 text-mute">{season.months}</p>
              </div>
              {calendarRows.map((label, row) => (
                <div class:list={["border-t border-hairline py-5", pad(index), row === 2 && "pb-7"]}>
                  <p class="t-spaced-sm text-forest">{label}</p>
                  <p class="t-body-sm mt-2 text-body">{[season.weather, season.todo, season.why][row]}</p>
                </div>
              ))}
            </li>
          ))
        }
      </ol>

      <div class="mt-20 grid gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
        <div>
          <h3 class="t-heading-xl text-ink">How often, roughly</h3>
          <p class="t-body-md mt-4 text-body">
            General guidance, not a plan we sell. Your roof's age, pitch,
            shade and material all move these numbers, and we'll tell you what
            yours needs once we've been up there.
          </p>
        </div>
        <div class="table-scroll">
          <table class="data-table min-w-[560px]">
            <caption class="sr-only">Rough maintenance intervals for open roofs and roofs under trees</caption>
            <thead>
              <tr>
                <th scope="col" class="w-[30%]">Task</th>
                <th scope="col">Open, sunny roof</th>
                <th scope="col">Under firs or big trees</th>
              </tr>
            </thead>
            <tbody>
              {
                intervals.map(([task, open, shaded]) => (
                  <tr>
                    <th scope="row">{task}</th>
                    <td>{open}</td>
                    <td>{shaded}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  {/* 5. What comes back after a visit. */}
  <section id="report" class="section bg-cream-deep">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-16">
        <div>
          <h2 class="t-display-lg text-balance text-ink">What you get back after a visit</h2>
          <p class="t-lead mt-5 text-body">
            You shouldn't have to climb up to know what's on your roof.
          </p>
          <dl class="mt-8 border-t border-hairline">
            <div class="border-b border-hairline py-5">
              <dt class="t-heading-sm text-ink">Photos</dt>
              <dd class="t-body-md mt-2 text-body">Of everything we flag, taken close enough to see the problem and wide enough to see where it is on the house.</dd>
            </div>
            <div class="border-b border-hairline py-5">
              <dt class="t-heading-sm text-ink">Written findings</dt>
              <dd class="t-body-md mt-2 text-body">In plain language: what we found, where, and what it means for the roof.</dd>
            </div>
            <div class="border-b border-hairline py-5">
              <dt class="t-heading-sm text-ink">What can wait, and what can't</dt>
              <dd class="t-body-md mt-2 text-body">Every item sorted by urgency, with a written price for anything that needs doing. Nothing is done without your say.</dd>
            </div>
          </dl>
        </div>

        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <span class="t-spaced">Findings, sorted</span>
          </div>
          <ol class="px-6 py-4 sm:px-10 sm:py-6">
            {
              tiers.map((tier, index) => (
                <li class:list={["grid gap-3 py-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-8", index > 0 && "border-t border-hairline"]}>
                  <p class="t-heading-md text-ink">{tier.label}</p>
                  <p class="t-body-md text-body">{tier.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <RelatedServices current="roof-maintenance" slugs={["roof-repair", "gutters", "roof-replacement"]} surface="canvas" />

  <ClosingCta
    title="Have your roof looked over"
    body="Tell us roughly how old the roof is and what's growing over it. We'll come look, clear what needs clearing, and give you the findings in writing."
  />
</Page>
