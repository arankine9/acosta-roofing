---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Treeline from "../../components/Treeline.astro";
import Text from "../../components/Text.astro";
import Img from "../../components/Img.astro";
import { pages } from "../../data/nav";
import { serviceHref } from "../../data/services";
import { site } from "../../data/site";
import { file, list, item } from "../../lib/cms";

// Roof maintenance: the Portland case for it. Moss and lichen (why they grow,
// what they do, how they come off without damaging the roof), debris and the
// places water backs up, a real inspection checklist, a seasonal calendar
// with rough intervals, and what the homeowner gets back after a visit.
// There is no maintenance plan or package; intervals are general guidance.
//
// Photos (public/images/roof-maintenance/), all free for commercial use with
// credit:
// - moss-shingle-roof-skylight.jpg: "Moss on roof" by Jay Pscheidt, Oregon
//   State University Extension Service,
//   https://www.flickr.com/photos/oregonstateuniversity/49527862622. CC BY-SA 2.0.
// - moss-in-shingle-keyways.jpg: "Roof before treatment" by Joey (jchaven),
//   https://www.flickr.com/photos/88201963@N00/54048044054. CC BY 2.0.
// - moss-on-shingles-close.jpg: "Nature vs. Roof" by GollyGforce,
//   https://www.flickr.com/photos/20581458@N00/14654053753. CC BY 2.0.
// All three are resized and recompressed; nothing else is changed.
const crumbs = [
  { label: "Services", href: pages.services },
  { label: "Residential", href: pages.residential },
  { label: "Roof maintenance", href: serviceHref("roof-maintenance") },
];

const schema = {
  "@type": "Service",
  name: "Roof maintenance",
  serviceType: "Roof maintenance, moss treatment and roof inspection",
  description:
    "Moss removal and treatment, debris and gutter clearing, and a close roof and attic inspection with photos and written findings, for homes across the Portland metro.",
  provider: { "@type": "RoofingContractor", name: site.legalName, telephone: site.phone },
  areaServed: "Portland metro, Oregon",
};

// Every word on this page is in src/content/pages/services-roof-maintenance.json;
// `k` is the key prefix into it and `c` its parsed content, for the lists.
const k = "pages/services-roof-maintenance";
const c = file(k);

// The calendar rows, in the order each season lists them.
const calendarRows = ["weather", "todo", "why"] as const;
// Side padding inside the ruled columns; the outer columns sit flush with
// the container edge.
const pad = (index: number) =>
  index === 0 ? "lg:pr-6" : index === c.calendar.seasons.length - 1 ? "lg:pl-6" : "lg:px-6";
---

<Page k={k} crumbs={crumbs} schema={schema}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-150} />

  {/* 1. Moss and lichen: long-form prose with a sticky photo rail. */}
  <section id="moss" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div>
          <Text k={`${k}:moss.eyebrow`} class="t-eyebrow text-mute" />
          <Text k={`${k}:moss.title`} as="h2" class="t-display-lg mt-4 text-balance text-ink" />
          <Text k={`${k}:moss.body`} type="block" as="div" class="prose-page mt-8" />
        </div>

        <aside>
          <div class="flex flex-col gap-10 lg:sticky lg:top-28">
            {
              c.moss.photos.map((_: unknown, i: number) => (
                <figure class="photo-plate">
                  <Img k={`${k}:moss.photos.${i}.image`} loading="lazy" decoding="async" class="aspect-[3/2]" />
                  <Text k={`${k}:moss.photos.${i}.caption`} as="figcaption" />
                </figure>
              ))
            }
            <div class="border-y border-hairline py-6">
              <Text k={`${k}:moss.dontLabel`} class="t-spaced-sm text-mute" />
              <ul class="t-body-sm mt-4 space-y-2 text-body" {...list(`${k}:moss.dont`)}>
                {c.moss.dont.map((_: unknown, i: number) => <Text k={`${k}:moss.dont.${i}`} as="li" {...item(i)} />)}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* 2. Debris. Extra bottom padding: the forest band's treeline stands into it. */}
  <section id="debris" class="section bg-cream-deep pb-[152px] max-[900px]:pb-32 max-[560px]:pb-28">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:debris.title`} as="h2" class="t-display-lg text-balance text-ink" />
        <Text k={`${k}:debris.intro`} class="t-body-md max-w-xl text-body" />
      </div>

      <ul class="mt-12 grid border-t border-hairline sm:grid-cols-2">
        {
          c.debris.items.map((_: unknown, index: number) => (
            <li
              class:list={[
                "border-b border-hairline py-8",
                index % 2 === 0 ? "sm:border-r sm:pr-10" : "sm:pl-10",
              ]}
            >
              <p class="t-spaced-sm text-mute">{String(index + 1).padStart(2, "0")}</p>
              <Text k={`${k}:debris.items.${index}.title`} as="h3" class="t-heading-md mt-3 text-ink" />
              <Text k={`${k}:debris.items.${index}.body`} class="t-body-md mt-3 max-w-lg text-body" />
            </li>
          ))
        }
      </ul>

      <div class="mt-12 grid gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16">
        <Text k={`${k}:debris.clearing.title`} as="h3" class="t-heading-xl text-balance text-ink" />
        <div>
          <Text k={`${k}:debris.clearing.body`} class="t-body-md max-w-2xl text-body" />
          <a href={serviceHref("gutters")} class="link-inline mt-4 inline-block"><Text k={`${k}:debris.clearing.link`} bare /></a>
        </div>
      </div>
    </div>
  </section>

  {/* 3. Forest band: the inspection checklist. */}
  <section id="inspection" class="on-forest relative bg-forest text-on-forest">
    <Treeline tone="forest" height={64} offset={-330} class="absolute inset-x-0 bottom-full" />
    <div class="container-page pt-20 pb-36 md:pt-24 md:pb-40">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <div>
          <Text k={`${k}:inspection.eyebrow`} class="t-eyebrow text-on-forest-mute" />
          <Text k={`${k}:inspection.title`} as="h2" class="t-display-lg mt-4 text-balance" />
        </div>
        <Text k={`${k}:inspection.lead`} class="t-lead max-w-xl text-on-forest-mute" />
      </div>

      {/* Three fixed columns; the checks inside each are the owner's list. */}
      <div class="mt-12 grid border-t border-hairline-dark lg:grid-cols-3">
        {
          c.inspection.groups.map((group: { items: unknown[] }, index: number) => (
            <div
              class:list={[
                "border-b border-hairline-dark py-8 lg:border-b-0",
                index > 0 && "lg:border-l lg:pl-8",
                index < c.inspection.groups.length - 1 && "lg:pr-8",
              ]}
            >
              <Text k={`${k}:inspection.groups.${index}.title`} as="h3" class="t-heading-md" />
              <ul class="check-list mt-6" {...list(`${k}:inspection.groups.${index}.items`)}>
                {group.items.map((_, i) => (
                  <li class="t-body-sm text-on-forest-mute" {...item(i)}>
                    <strong class="font-semibold text-on-forest"><Text k={`${k}:inspection.groups.${index}.items.${i}.name`} bare /></strong> <Text k={`${k}:inspection.groups.${index}.items.${i}.note`} bare />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <Treeline tone="cream" height={64} offset={-90} class="absolute inset-x-0 bottom-0" />
  </section>

  {/* 4. The seasonal calendar and rough intervals. */}
  <section id="calendar" class="section bg-canvas">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
        <Text k={`${k}:calendar.title`} as="h2" class="t-display-lg text-balance text-ink" />
        <Text k={`${k}:calendar.intro`} class="t-body-md max-w-xl text-body" />
      </div>

      {/* Four seasons as ruled columns. From 1024px each column is a subgrid,
          so the three rows line up across all four seasons. */}
      <ol class="mt-12 grid border-t-2 border-forest lg:grid-cols-4 lg:grid-rows-[auto_repeat(3,auto)]">
        {
          c.calendar.seasons.map((_: unknown, index: number) => (
            <li
              class:list={[
                "grid border-b border-hairline lg:row-span-4 lg:grid-rows-subgrid lg:border-b-0",
                index > 0 && "lg:border-l lg:border-hairline",
              ]}
            >
              <div class:list={["pt-6 pb-5", pad(index)]}>
                <Text k={`${k}:calendar.seasons.${index}.name`} as="h3" class="t-display-lg leading-none text-ink" />
                <Text k={`${k}:calendar.seasons.${index}.months`} class="t-spaced-sm mt-3 text-mute" />
              </div>
              {calendarRows.map((field, row) => (
                <div class:list={["border-t border-hairline py-5", pad(index), row === 2 && "pb-7"]}>
                  <Text k={`${k}:calendar.rows.${field}`} class="t-spaced-sm text-forest" />
                  <Text k={`${k}:calendar.seasons.${index}.${field}`} class="t-body-sm mt-2 text-body" />
                </div>
              ))}
            </li>
          ))
        }
      </ol>

      <div class="mt-20 grid gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
        <div>
          <Text k={`${k}:calendar.intervals.title`} as="h3" class="t-heading-xl text-ink" />
          <Text k={`${k}:calendar.intervals.intro`} class="t-body-md mt-4 text-body" />
        </div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Rough maintenance intervals for open roofs and roofs under trees">
          <table class="data-table min-w-[560px]">
            <caption class="sr-only">Rough maintenance intervals for open roofs and roofs under trees</caption>
            <thead>
              <tr>
                <Text k={`${k}:calendar.intervals.task`} as="th" scope="col" class="w-[30%]" />
                <Text k={`${k}:calendar.intervals.open`} as="th" scope="col" />
                <Text k={`${k}:calendar.intervals.shaded`} as="th" scope="col" />
              </tr>
            </thead>
            <tbody {...list(`${k}:calendar.intervals.rows`)}>
              {
                c.calendar.intervals.rows.map((_: unknown, i: number) => (
                  <tr {...item(i)}>
                    <Text k={`${k}:calendar.intervals.rows.${i}.task`} as="th" scope="row" />
                    <Text k={`${k}:calendar.intervals.rows.${i}.open`} as="td" />
                    <Text k={`${k}:calendar.intervals.rows.${i}.shaded`} as="td" />
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  {/* 5. What comes back after a visit. */}
  <section id="report" class="section bg-cream-deep">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-16">
        <div>
          <Text k={`${k}:report.title`} as="h2" class="t-display-lg text-balance text-ink" />
          <Text k={`${k}:report.lead`} class="t-lead mt-5 text-body" />
          <dl class="mt-8 border-t border-hairline" {...list(`${k}:report.items`)}>
            {
              c.report.items.map((_: unknown, i: number) => (
                <div class="border-b border-hairline py-5" {...item(i)}>
                  <Text k={`${k}:report.items.${i}.title`} as="dt" class="t-heading-sm text-ink" />
                  <Text k={`${k}:report.items.${i}.body`} as="dd" class="t-body-md mt-2 text-body" />
                </div>
              ))
            }
          </dl>
        </div>

        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <Text k={`${k}:report.tiersLabel`} as="span" class="t-spaced" />
          </div>
          <ol class="px-6 py-4 sm:px-10 sm:py-6" {...list(`${k}:report.tiers`)}>
            {
              c.report.tiers.map((_: unknown, index: number) => (
                <li class:list={["grid gap-3 py-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-8", index > 0 && "border-t border-hairline"]} {...item(index)}>
                  <Text k={`${k}:report.tiers.${index}.label`} class="t-heading-md text-ink" />
                  <Text k={`${k}:report.tiers.${index}.body`} class="t-body-md text-body" />
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <RelatedServices current="roof-maintenance" k={`${k}:related`} slugs={["roof-repair", "gutters", "roof-replacement"]} surface="canvas" />

  <ClosingCta k={`${k}:closingCta`} />
</Page>
