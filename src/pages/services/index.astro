---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import Icon from "../../components/Icon.astro";
import Text from "../../components/Text.astro";
import Img from "../../components/Img.astro";
import { pages } from "../../data/nav";
import { residentialHref, serviceHref, serviceKey, servicesByGroup, getService } from "../../data/services";

// The services index: everything Acosta does, grouped the way people arrive
// at it (a house, a commercial building, a multi-unit property). Each group
// is a ruled plate; each service is a row with its photo, a line on what it
// covers and a link to its page. The rows are the registry's entries
// (src/content/services.json), marked with their keys.
const crumbs = [{ label: "Services", href: pages.services }];

// Every word on this page is in src/content/pages/services-index.json; the
// groups' titles, intros and link labels are `groups.<n>` there, in this order.
const k = "pages/services-index";

const groups = [
  {
    id: "residential",
    href: residentialHref,
    items: servicesByGroup("residential"),
  },
  {
    id: "commercial",
    items: [getService("commercial"), getService("multi-unit")],
  },
];
---

<Page k={k} crumbs={crumbs}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} treelineOffset={-120} />

  {
    groups.map((group, groupIndex) => (
      <section
        id={group.id}
        class:list={["section", groupIndex % 2 === 0 ? "bg-canvas" : "bg-cream-deep"]}
      >
        <div class="container-page">
          <div class="grid gap-6 border-b border-hairline pb-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-16">
            {/* Rich, so the title can keep "multi-unit" in a nowrap span: the
                hyphen is a legal break point and "MULTI-" alone on a line reads
                as a typo. */}
            <Text k={`${k}:groups.${groupIndex}.title`} type="rich" as="h2" class="t-display-lg text-ink" />
            <div class="flex flex-col items-start gap-5 lg:flex-row lg:items-end lg:justify-between">
              <Text k={`${k}:groups.${groupIndex}.intro`} class="t-body-md max-w-xl text-body" />
              {group.href && (
                <a href={group.href} class="t-spaced-sm inline-flex shrink-0 items-center gap-2 text-forest hover:text-forest-deep">
                  <Text k={`${k}:groups.${groupIndex}.link`} bare />
                  <Icon name="arrow" size={16} />
                </a>
              )}
            </div>
          </div>

          <ul>
            {group.items.map((service, index) => (
              <li class="border-b border-hairline">
                <a
                  href={serviceHref(service.slug)}
                  class="group grid gap-6 py-8 sm:grid-cols-[220px_minmax(0,1fr)] sm:items-center md:grid-cols-[280px_minmax(0,1fr)_auto] md:gap-10"
                >
                  <div class="overflow-hidden border border-hairline bg-cream-deep">
                    <Img
                      k={`${serviceKey(service.slug)}.image`}
                      loading={groupIndex === 0 && index < 2 ? "eager" : "lazy"}
                      decoding="async"
                      class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                    />
                  </div>
                  <div>
                    <Text k={`${serviceKey(service.slug)}.title`} as="h3" class="t-heading-xl text-ink group-hover:text-forest" />
                    <Text k={`${serviceKey(service.slug)}.summary`} class="t-body-md mt-3 max-w-xl text-body" />
                  </div>
                  <span class="btn btn-outline hidden group-hover:bg-forest group-hover:text-cream md:inline-flex">
                    <Text k={`${k}:details`} bare />
                    <Icon name="arrow" size={18} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <ClosingCta k={`${k}:closingCta`} surface="canvas" />
</Page>
