---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Text from "../components/Text.astro";
import { pages } from "../data/nav";
import { file, get, plain, block, field, list, item, EDIT } from "../lib/cms";

/*
  OWNER REVIEW NEEDED before launch. This notice is a plain description of
  what the site does as built on the date below, not legal advice, and it has
  not been reviewed by a lawyer. Check in particular:
  - The estimate form isn't wired to a backend yet (see Contact.astro). When
    it is, name the service that receives submissions (a form service, an
    email provider) under "Who else sees it", and confirm the "how long we
    keep it" wording matches what you actually do.
  - Hosting is Cloudflare Pages (per the deploy setup). If that changes,
    update "Who else sees it".
  - Base.astro loads Google Fonts from Google's servers and has no analytics,
    ad pixels or cookies. If analytics or a chat widget is ever added, this
    page has to change the same day.
  - Bump the "Last updated" date (`updated` in the content file) whenever
    the substance changes.
*/
const crumbs = [{ label: "Privacy", href: pages.privacy }];

const k = "pages/privacy";
const c = file(k);

// The date as written, for <time datetime>; left off if it doesn't parse.
const date = new Date(plain(get(`${k}:updated`)));
const pad = (n: number) => String(n).padStart(2, "0");
const updatedIso = isNaN(date.getTime())
  ? undefined
  : `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;

const bodyKey = `${k}:body`;
const body = block(get(bodyKey));
---

<Page k={k} crumbs={crumbs}>
  <PageHero k={`${k}:hero`} crumbs={crumbs} actions={false} treelineOffset={-180} />

  <section class="section bg-canvas">
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
      <div class="prose-page min-w-0">
        <p class="t-spaced-sm text-mute">
          <Text k={`${k}:updatedLabel`} bare /> <time datetime={updatedIso}><Text k={`${k}:updated`} bare /></time>
        </p>

        {/* The notice is one block field. It shares this container with the
            date above, so the edit build gives it a box of its own. */}
        {EDIT ? <div class="prose-page" {...field(bodyKey, "block")} set:html={body} /> : <Fragment set:html={body} />}
      </div>

      <aside class="min-w-0 lg:sticky lg:top-28 lg:self-start" aria-labelledby="privacy-summary">
        <div class="panel panel-keyline overflow-hidden">
          <div class="plate-label">
            <Text k={`${k}:summary.label`} as="span" id="privacy-summary" class="t-spaced" />
          </div>
          <ul class="check-list t-body-sm px-6 pt-7 pb-8 text-body sm:px-8" {...list(`${k}:summary.items`)}>
            {c.summary.items.map((_: unknown, i: number) => <Text k={`${k}:summary.items.${i}`} as="li" {...item(i)} />)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <ClosingCta k={`${k}:closingCta`} surface="cream-deep" />
</Page>
