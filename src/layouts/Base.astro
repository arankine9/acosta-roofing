---
import { asset } from "../lib/url";
import "../styles/global.css";
import { site, counties, businessId, openingHours } from "../data/site";
import { EDIT, tokens } from "../lib/cms";

interface Props {
  title?: string;
  description?: string;
  /* The title link previews (og:title, twitter:title) show. Defaults to
     `title`, or the plain site name when there is no title. */
  socialTitle?: string;
  /* Extra JSON-LD for this page (a Service, an FAQPage, a BreadcrumbList),
     rendered alongside the site-wide RoofingContractor block. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /* The content file this page's words come from ("pages/about"). The
     portal's editor reads it to find the page's search title and
     description; it is only emitted in an edit build. */
  cmsFile?: string;
}

const {
  title = `${site.name} | Portland Metro Roofing Contractor`,
  description = site.description,
  schema: pageSchema,
  noindex = false,
  cmsFile,
} = Astro.props;
// Link previews (iMessage, Slack, Facebook) show the plain name on the home
// page, which passes it as `socialTitle`; the <title> keeps "Portland Metro
// Roofing Contractor" for search. Inner pages pass their own title, which
// previews use as is.
const socialTitle = Astro.props.socialTitle ?? Astro.props.title ?? site.name;
const extraSchema = pageSchema ? (Array.isArray(pageSchema) ? pageSchema : [pageSchema]) : [];

const canonical = new URL(Astro.url.pathname, Astro.site);
// Crawlers need an absolute URL for the preview image.
const ogImage = new URL(asset("/og-image.png"), Astro.site);
const ogImageAlt = `${site.name} logo`;
const logo = new URL(asset("/logo-lockup.png"), Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  "@id": businessId,
  name: site.legalName,
  description: site.description,
  // E.164, the form the schema asks for: "+19712809253".
  telephone: site.phoneHref.replace("tel:", ""),
  email: site.email,
  url: `https://${site.domain}/`,
  image: ogImage.toString(),
  logo: logo.toString(),
  address: {
    "@type": "PostalAddress",
    // Omitted rather than empty while the new street address is unconfirmed:
    // an empty streetAddress is a validation error, a missing one is not.
    ...(site.address.street ? { streetAddress: site.address.street } : {}),
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    ...(site.address.zip ? { postalCode: site.address.zip } : {}),
    addressCountry: "US",
  },
  areaServed: counties.map((county) => `${county.name} County, OR`),
  // From the hours in site.json; rows like "By appointment" are left out.
  ...(openingHours.length ? { openingHoursSpecification: openingHours } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {EDIT && cmsFile && <meta name="cms-file" content={cmsFile} />}
    {/* Edit build only: the token values this page was built with, for the
        portal's editor to render {{tokens}} the same way. */}
    {EDIT && <script type="application/json" id="cms-tokens" set:html={JSON.stringify(tokens)} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    {(noindex || EDIT) && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <!-- Rendered by scripts/build-og-image.mjs; re-run it when the card's facts change. -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href={asset("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#24503c" />

    <!--
      Oswald stands in for the wordmark's condensed cut and is used uppercase
      only; Barlow carries body copy. Arial Narrow / Arial are the fallbacks,
      so the page still reads as signage if the fonts never arrive.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {extraSchema.map((block) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...block })} />)}
  </head>
  <body class="antialiased bg-canvas text-body">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-[2px] focus:bg-forest focus:px-4 focus:py-2 focus:text-on-forest t-body-strong"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // In-page anchors get an eased scroll whose duration scales with the
      // distance travelled. The browser's own smooth scroll is a fixed short
      // duration, so a hero -> contact jump covering several screens blurs past
      // every section between them. Long trips get more time, short ones stay
      // snappy, and both ease in and out instead of stopping dead.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      let cancel: (() => void) | null = null;

      const easeInOutCubic = (t: number) =>
        t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

      function scrollToTarget(target: HTMLElement) {
        // Same offset the CSS uses, so the JS and no-JS paths agree.
        const offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const start = window.scrollY;
        const end = Math.min(
          Math.max(target.getBoundingClientRect().top + start - offset, 0),
          Math.max(max, 0),
        );
        const distance = Math.abs(end - start);
        if (distance < 2) return;

        // ~450ms for a short hop up to ~1.1s across the whole page.
        const duration = Math.min(450 + distance * 0.25, 1100);
        const startTime = performance.now();

        cancel?.();
        let frame = 0;

        const step = (now: number) => {
          const t = Math.min((now - startTime) / duration, 1);
          window.scrollTo({
            top: start + (end - start) * easeInOutCubic(t),
            behavior: "instant" as ScrollBehavior,
          });
          if (t < 1) frame = requestAnimationFrame(step);
          else cancel?.();
        };

        // Any real input from the user wins; nothing worse than fighting a
        // scroll animation that refuses to let go.
        const abort = () => cancel?.();
        cancel = () => {
          cancelAnimationFrame(frame);
          window.removeEventListener("wheel", abort);
          window.removeEventListener("touchstart", abort);
          window.removeEventListener("keydown", abort);
          cancel = null;
        };
        window.addEventListener("wheel", abort, { passive: true });
        window.addEventListener("touchstart", abort, { passive: true });
        window.addEventListener("keydown", abort);

        frame = requestAnimationFrame(step);
      }

      document.addEventListener("click", (event) => {
        const mouseEvent = event as MouseEvent;
        if (
          mouseEvent.defaultPrevented ||
          mouseEvent.button !== 0 ||
          mouseEvent.metaKey ||
          mouseEvent.ctrlKey ||
          mouseEvent.shiftKey ||
          mouseEvent.altKey
        )
          return;

        const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>("a[href]");
        const hash = link?.getAttribute("href");
        if (!link || !hash || !hash.startsWith("#") || hash === "#") return;
        if (link.target && link.target !== "_self") return;

        const target = document.getElementById(decodeURIComponent(hash.slice(1)));
        if (!target) return;

        event.preventDefault();

        // The mobile drawer is a <details>; leaving it open would cover the
        // section we just scrolled to. Only the drawer: a #link inside an FAQ
        // answer must not fold the answer up.
        link.closest("header details")?.removeAttribute("open");

        if (reduced.matches) {
          target.scrollIntoView({ behavior: "auto", block: "start" });
        } else {
          scrollToTarget(target);
        }

        // Keep the URL and keyboard focus where a native anchor jump would put
        // them, without letting the focus call yank the page there instantly.
        history.pushState(null, "", hash);
        const hadTabIndex = target.hasAttribute("tabindex");
        if (!hadTabIndex) target.setAttribute("tabindex", "-1");
        target.focus({ preventScroll: true });
        // Dropping tabindex while the target still has focus makes the browser
        // move focus back to <body>; wait until focus moves on.
        if (!hadTabIndex) target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
      });
    </script>
  </body>
</html>
